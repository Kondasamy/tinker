---
// A module intro's trailer: a hero button that opens public/video/<id>-trailer.mp4 in a popup and plays it; closing it
// (✕, Esc or the backdrop) stops it. Nothing of the video loads before the press; without JS the link opens the MP4.
interface Props {
  /** The module id: the files are /video/<id>-trailer.{mp4,jpg,vtt}. */
  id: string;
  /** The module's short name, for the popup's accessible name ("RAG trailer"). */
  name: string;
  /** Running time as shown on the button, m:ss (tests/unit/trailers.test.ts checks it against the MP4). */
  length: string;
}
const { id, name, length } = Astro.props;
const src = `/video/${id}-trailer`;
---
<a class="btn" href={`${src}.mp4`} data-trailer>▶ Trailer · {length}</a>
<dialog class="trailer-box" aria-label={`${name} trailer`}>
  <form method="dialog"><button class="close" aria-label="Close trailer">✕</button></form>
  <video class="trailer" controls preload="none" poster={`${src}.jpg`} width="1920" height="1080" aria-label={`${name} trailer`}>
    <source src={`${src}.mp4`} type="video/mp4" />
    <track kind="captions" srclang="en" label="English" src={`${src}.vtt`} default />
  </video>
</dialog>

<script>
  // each button opens the popup rendered right after it
  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-trailer]')) {
    const box = link.nextElementSibling as HTMLDialogElement;
    const film = box.querySelector('video')!;
    link.addEventListener('click', e => {
      e.preventDefault();
      box.showModal();
      film.play().catch(() => {});
    });
    box.addEventListener('click', e => e.target === box && box.close());
    box.addEventListener('close', () => film.pause());
  }
</script>

<style>
  /* the popup: a 16:9 frame up to the viewport's width; the poster stays if the video can't load */
  .trailer-box { width: min(1100px, calc(100vw - 32px)); max-width: none; padding: 0; border: 1.5px solid var(--ink); border-radius: 14px; background: var(--ink); box-shadow: 4px 4px 0 var(--ink); overflow: visible; }
  .trailer-box::backdrop { background: rgb(20 18 14 / .72); }
  .trailer { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; border-radius: 13px; background: var(--ink); }
  .trailer-box .close { position: absolute; top: -14px; right: -14px; z-index: 1; width: 32px; height: 32px; border: 1.5px solid var(--ink); border-radius: 999px; background: var(--card); color: var(--ink); font: 800 14px/1 inherit; cursor: pointer; }
</style>

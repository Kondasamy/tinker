---
// Story-first chapter shell (KTD9): chapter nav on top; the slot holds the chapter island
// (StepRunner renders hero stage, narration card and drawer).
import '../styles/tokens.css';
import { moduleOf, chapterHref } from '../lib/modules';
import Meta from '../components/Meta.astro';
import { chapterMeta } from '../lib/pages';

interface Props { module?: string; chapter: string; title: string }
const { module = 'rag', chapter, title } = Astro.props;
const m = moduleOf(module);
---
<html lang="en">
  <head>
    <Meta {...chapterMeta(m.id, chapter)} title={`${title} · ${m.title} · Tinker`} />
  </head>
  <body>
    <header class="top">
      <p class="brand"><a href="/"><img src="/favicon.svg" alt="" width="22" height="22" /> Tinker</a> <span aria-hidden="true">/</span> <a href={`/${m.id}/`}>{m.title}</a></p>
      <nav aria-label="Chapters" data-module={m.id}>
        <ol>
          {m.chapters.map((c, i) => (
            <li>
              <a href={chapterHref(m.id, c.id)} data-chapter={c.id} data-mark={c.id === chapter ? 'current' : 'todo'}
                aria-current={c.id === chapter ? 'page' : undefined}>
                <span class="num">{String(i + 1).padStart(2, '0')}</span>
                <span class="name">{c.short}</span>
                <span class="sr" data-sr></span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
      <p class="credit">
        by <a href="https://kondasamy.com">Kondasamy Jayaraman</a> ·
        drawn with <a href="https://april-zhu.com/colorfigures">Colorfigures</a> by <a href="https://april-zhu.com/">April Zhu</a>
      </p>
    </header>
    <main>
      {/* the chapter heading and intro open the story column (StepRunner) */}
      <slot />
    </main>
    <script>
      import { moduleOf } from '../lib/modules';
      import { completed, navMark } from '../lib/progress';
      const module = document.querySelector<HTMLElement>('nav[data-module]')!.dataset.module!;
      const chapters = moduleOf(module).chapters;
      const LABEL = { done: ' (done)', current: ' (current)', skipped: ' (skipped)', todo: '' };
      function paint() {
        const cur = document.querySelector<HTMLElement>('[aria-current="page"]')?.dataset.chapter ?? '';
        const done = completed(module);
        for (const a of document.querySelectorAll<HTMLElement>('nav [data-chapter]')) {
          const mark = navMark(chapters, a.dataset.chapter!, cur, done);
          a.dataset.mark = mark;
          a.querySelector('[data-sr]')!.textContent = LABEL[mark];
        }
      }
      paint();
      window.addEventListener('tinker-progress', paint);
    </script>
  </body>
</html>

<style is:global>
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  .top { display: flex; align-items: center; gap: 12px 28px; flex-wrap: wrap; padding: 14px 24px; border-bottom: 1.5px solid var(--ink); }
  .brand { margin: 0; font-weight: 800; font-size: 14px; display: inline-flex; align-items: center; gap: 8px; }
  .brand a { text-decoration: none; display: inline-flex; align-items: center; gap: 8px; }
  .brand span { color: var(--muted); font-weight: 400; }
  .credit { margin: 0 0 0 auto; font-size: 11.5px; color: var(--muted); }
  .credit a { color: var(--ink); }
  .top ol { display: flex; gap: 6px; list-style: none; margin: 0; padding: 0; flex-wrap: wrap; }
  .top nav a { display: inline-flex; align-items: center; gap: 6px; font-size: 12.5px; text-decoration: none; padding: 4px 10px; border-radius: 999px; border: 1.5px solid transparent; color: var(--muted); }
  .top nav a:hover { border-color: var(--rule); }
  .top nav .num { font-weight: 800; }
  .top nav a[data-mark='current'] { border-color: var(--ink); background: var(--card); color: var(--ink); box-shadow: 2px 2px 0 var(--ink); }
  .top nav a[data-mark='done'] { color: var(--ink); }
  .top nav a[data-mark='done'] .num::before { content: '✓ '; color: var(--ok); }
  .top nav a[data-mark='skipped'] .num::before { content: '↷ '; color: var(--warn); }

  main { padding: 16px 24px 32px; }
  .eyebrow { margin: 0; font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }

  /* Wide screens: an app frame. The picture holds still on the left; the story column scrolls on its own. */
  .chapter { display: grid; grid-template-columns: minmax(0, 1.75fr) minmax(340px, 1fr); gap: 24px; align-items: start; }
  .stage { display: flex; flex-direction: column; align-items: center; justify-content: center; border: 1.5px solid var(--rule); border-radius: 16px; padding: 16px; }
  .stage figure { margin: 0; width: 100%; }
  .stage figcaption { text-align: center; font-size: 13px; color: var(--muted); margin-top: 8px; }
  .side { display: flex; flex-direction: column; gap: 16px; }
  @media (min-width: 861px) {
    body { height: 100dvh; display: flex; flex-direction: column; overflow: hidden; }
    main { flex: 1; min-height: 0; padding-bottom: 16px; }
    .chapter { height: 100%; }
    .stage { height: 100%; overflow: auto; }
    /* :where() keeps this a fallback: component rules (canvas, graph walk) always win, whatever order CSS bundles load in */
    :where(.stage) svg { max-height: calc(100dvh - 220px); }
    .side { height: 100%; overflow-y: auto; scrollbar-gutter: stable; padding: 2px 10px 24px 2px; }
  }

  .intro { display: flex; flex-direction: column; gap: 10px; font-size: 14px; line-height: 1.55; }
  .intro h1 { margin: 0; font-size: 22px; font-weight: 800; line-height: 1.25; }
  .intro p { margin: 0; }
  .intro .story { font-size: 15px; }
  .intro .goal { border-left: 3px solid var(--acc); padding: 2px 0 2px 10px; }
  .intro .lbl { margin: 0; font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  .intro ul { margin: 4px 0 0; padding-left: 18px; display: flex; flex-direction: column; gap: 4px; }
  .intro .terms summary { cursor: pointer; font-weight: 700; }
  .intro dl { margin: 8px 0 0; display: flex; flex-direction: column; gap: 8px; }
  .intro dt { font-weight: 800; }
  .intro dd { margin: 0; color: var(--ink); }
  .intro .how { font-size: 13px; color: var(--muted); }
  /* steps already done stay as the story so far, quieter than the current step */
  .log { margin: 0; padding: 12px 0 0; list-style: none; display: flex; flex-direction: column; gap: 10px; border-top: 1.5px dashed var(--rule); font-size: 13.5px; line-height: 1.5; color: var(--muted); }
  .log li { padding-left: 22px; position: relative; }
  .log li::before { content: '✓'; position: absolute; left: 0; color: var(--ok); font-weight: 800; }

  .card { background: var(--card); border: 1.5px solid var(--ink); border-radius: 14px; padding: 18px; box-shadow: 3px 3px 0 var(--ink); display: flex; flex-direction: column; gap: 14px; }
  .card .count { margin: 0; font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  .card .narration { margin: 4px 0 0; font-size: 16px; font-weight: 700; line-height: 1.45; }
  .card .hint { margin: 0; font-size: 13px; border-left: 3px solid var(--acc); padding: 2px 0 2px 10px; }
  .recover { display: flex; flex-wrap: wrap; gap: 8px; border-top: 1px dashed var(--rule); padding-top: 12px; }
  .recover .chip { font-size: 12px; box-shadow: none; border-color: var(--rule); }
  .recover .chip:disabled { opacity: .4; cursor: default; }

  .opts { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { font: inherit; font-size: 13px; color: var(--ink); background: var(--card); border: 1.5px solid var(--ink); border-radius: 8px; padding: 6px 12px; cursor: pointer; box-shadow: 2px 2px 0 var(--ink); }
  .chip[aria-pressed='true'], .chip[aria-checked='true'] { background: var(--ink); color: var(--paper); box-shadow: none; }
  .big { font-weight: 800; font-size: 14px; background: var(--acc); border: 1.5px solid var(--ink); border-radius: 999px; padding: 8px 16px; box-shadow: 3px 3px 0 var(--ink); text-decoration: none; align-self: flex-start; }

  .quiz { border: 0; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .quiz legend { font-size: 14px; margin-bottom: 8px; padding: 0; }
  .quiz .opts { flex-direction: column; align-items: stretch; }
  .quiz .chip { text-align: left; }
  .feedback p { margin: 6px 0 0; font-size: 13px; }
  .feedback summary { margin-top: 8px; font-size: 13px; cursor: pointer; }
  .feedback ul, .tips ul, .closing ul { margin: 6px 0 0; padding-left: 18px; font-size: 13px; display: flex; flex-direction: column; gap: 6px; }

  .challenge { display: flex; flex-direction: column; gap: 12px; }
  .challenge .count { display: flex; gap: 10px; }
  .challenge .count [data-current] { color: var(--ink); font-weight: 800; }
  .challenge .count [data-solved] { color: var(--ok); }
  /* a ruled-out pick reads as crossed off, not as the chosen answer */
  .challenge .chip[data-wrong] { background: var(--card); color: var(--muted); text-decoration: line-through; border-color: var(--rule); box-shadow: none; }
  .challenge .chip:disabled:not([data-wrong]) { opacity: .5; box-shadow: none; }
  .tips .lbl { margin: 0; font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  .closing { border-top: 1px dashed var(--rule); padding-top: 12px; }
  .closing h2 { margin: 0; font-size: 16px; }
  .closing p { margin: 6px 0 0; font-size: 13px; }
  .closing a { margin-left: 6px; white-space: nowrap; }
  .stamp { display: inline-block; font-weight: 900; font-size: 11px; letter-spacing: .14em; border: 2px solid currentColor; border-radius: 6px; padding: 1px 7px; transform: rotate(-2deg); }
  .stamp.correct { color: var(--ok); } .stamp.wrong { color: var(--bad); } .stamp.neutral { color: var(--ink); }
  .quiz .chip[aria-disabled='true'] { opacity: .5; box-shadow: none; cursor: default; }
  .feedback:focus { outline: none; }

  .drawer { background: var(--card); border: 1.5px solid var(--ink); border-radius: 14px; padding: 14px 18px; font-size: 13.5px; }
  .drawer header { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .drawer h2 { margin: 0; font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  .drawer .chip { box-shadow: none; padding: 2px 9px; }

  @media (max-width: 860px) {
    .top { padding: 12px 16px; }
    .top nav a:not([data-mark='current']) .name { display: none; }
    main { padding: 12px 16px 24px; }
    .chapter { grid-template-columns: minmax(0, 1fr); gap: 16px; }
    .stage { min-height: 0; padding: 8px; }
    /* the drawer follows the step card in the page flow: a sticky sheet would cover the step's controls */
    .drawer { scroll-margin-top: 12px; }
  }
</style>

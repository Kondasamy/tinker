---
// Test fixture: the recap over a fixture bank (tests/e2e/recap.spec.ts). Served at /dev/warmup too, as the warm-up.
import '../styles/tokens.css';
import '../styles/page.css';
import Recap from '../components/quiz/Recap';
import { FIXTURE_BANK } from './recall-fixture';

const warmup = Astro.url.pathname.startsWith('/dev/warmup');
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{warmup ? 'Warm-up' : 'Recap'} (dev)</title>
  </head>
  <body>
    <main>
      <h1>{warmup ? 'Warm-up' : 'Recap'} fixture</h1>
      <div id="warmup">
        {warmup ? <Recap module="rag" bank={FIXTURE_BANK} warmup client:load /> : <Recap module="rag" bank={FIXTURE_BANK} client:load />}
      </div>
      <p><a href="/rag/">Module intro</a></p>
    </main>
  </body>
</html>
<style>
  main { max-width: 760px; margin: 0 auto; padding: 24px 16px; display: flex; flex-direction: column; gap: 16px; }
  h1 { font-size: 18px; margin: 0; }
</style>

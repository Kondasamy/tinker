---
// Dev-only eyeball page: the type frame in each state (static SVG, wide and phone), the hero plot, the fill strip, then
// the stage live on its Strip tab. Below 600px the phone versions show. Fills run on the masked model read from disk.
import '../styles/tokens.css';
import IsoStage from '../lib/iso/IsoStage';
import {
  FRAME_BOARD,
  frameLabel,
  typeFrameScene,
  typeFramePlot,
  type FrameOpts,
} from '../components/scenes/typeFrameScene';
import { fillStrip } from '../components/scenes/fillStrip';
import { decode, typewriter } from '../lib/diffusion-llms/decode';
import { diskMini, diskMlm } from '../lib/diffusion-llms/diskModel';
import { phrase } from '../lib/diffusion-llms/workbench';
import { FrameStage, frameOf } from '../content/diffusion-llms/kit';
import { filterFor } from '../lib/iso/core.js';

const mlm = diskMlm();
const p6 = phrase(6);
const f4 = decode(mlm, p6.ids, 4, 'confidence', 6),
  f1 = decode(mlm, p6.ids, 1, 'confidence', 6),
  f16 = decode(mlm, p6.ids, 16, 'confidence', 6),
  r4 = decode(mlm, p6.ids, 4, 'random', 6),
  short = decode(mlm, p6.ids, 1, 'confidence', 6, 4);
const typed = typewriter(diskMini(), p6.ids);
const G = p6.ids.length;
const STATES: [string, FrameOpts][] = [
  ['Idle: the phrase alone', { given: G, slots: [] }],
  ['16 blanks, before the first pass', { given: G, ...frameOf(f4, 0) }],
  ['Surest first, 4 a pass: pass 1 of 4', { given: G, ...frameOf(f4, 1) }],
  ['Surest first, 4 a pass: pass 3 of 4', { given: G, ...frameOf(f4, 3) }],
  ['Random, 4 a pass: pass 2 of 4', { given: G, ...frameOf(r4, 2) }],
  ['One a pass: pass 9 of 16', { given: G, ...frameOf(f1, 9) }],
  ['All 16 in one pass', { given: G, ...frameOf(f16, 1) }],
  ['Length 4, done', { given: G, ...frameOf(short, 4) }],
  ['Larkspur mini typing: 7 of 16', { given: G, slots: [], typed: 7, typeOf: typed.length }],
  ['Mini done beside a full frame', { given: G, ...frameOf(f1, 16), typed: 16, typeOf: 16 }],
];
const still = (phone: boolean) => {
  const s = fillStrip(f4.passes, 16, phone);
  return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${s.w} ${s.h}" width="100%"><defs>${filterFor(1, 'hand')}</defs><g filter="url(#hand)">${s.svg}</g></svg>`;
};
const src = (svg: string) => 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg);
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Diffusion LMs scene</title>
  </head>
  <body>
    <main>
      <h1>The type frame: every state</h1>
      <div class="grid">
        {STATES.map(([title, o]) => (
          <section>
            <h2>{title}</h2>
            <div class="wide"><IsoStage board={FRAME_BOARD} scene={typeFrameScene({ ...o, scale: 1.2 })} label={frameLabel(o)} /></div>
            <div class="phone"><IsoStage board={FRAME_BOARD} scene={typeFrameScene({ ...o, scale: 2 })} label={frameLabel(o)} /></div>
            <p>{frameLabel(o)}</p>
          </section>
        ))}
        <section>
          <h2>Hero plot</h2>
          <IsoStage board={[0, 0, 70, 60]} scene={({ top }) => typeFramePlot(30, 30, top)} label="The home hero's diffusion-llms plot" />
        </section>
      </div>
      <h1>The fill strip (static)</h1>
      <img class="wide strip" src={src(still(false))} alt="The strip, desktop" />
      <img class="phone strip" src={src(still(true))} alt="The strip, phone" />
      <h1>The stage, live</h1>
      <div class="grid">
        <section><h2>Strip tab</h2><div class="stage"><FrameStage client:load view="strip" shown={{ given: G, ...frameOf(f4, 4), fill: f4, caption: '<script>alert(1)</script> escaped caption' }} /></div></section>
      </div>
    </main>
  </body>
</html>
<style>
  main { max-width: 1240px; margin: 0 auto; padding: 24px 16px; display: flex; flex-direction: column; gap: 16px; }
  h1 { font: 800 15px ui-monospace, Menlo, monospace; margin: 16px 0 0; }
  h2 { font: 800 13px ui-monospace, Menlo, monospace; margin: 0; }
  p { font-size: 12px; margin: 0; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(360px, 1fr)); gap: 16px; }
  img.strip { width: 100%; }
  section { display: flex; flex-direction: column; gap: 6px; border: 1px solid var(--rule); border-radius: 10px; padding: 8px; background: var(--paper); }
  .phone { display: none; }
  .stage { display: flex; height: 560px; }
  @media (max-width: 599px) {
    .grid { grid-template-columns: 1fr; }
    .wide { display: none; }
    .phone { display: block; }
  }
</style>

---
// Dev-only eyeball page: the scratchpad desk at every effort (static SVG), the accuracy-by-effort chart, then the stage
// live in both tabs. Below 600px the phone versions show.
import '../styles/tokens.css';
import IsoStage from '../lib/iso/IsoStage';
import { THINK_BOARD, thinkLabel, thinkScene, type ThinkOpts } from '../components/scenes/thinkScene';
import { EffortChart, ReasoningStage, deskOf, kindSeries } from '../content/reasoning/kit';
import { EFFORTS, run } from '../lib/reasoning/engine';

const Q = 'quote-split-lines';
const STATES: [string, ThinkOpts][] = [
  ...EFFORTS.map(e => [`${Q} at ${e}`, deskOf(run(Q, e))] as [string, ThinkOpts]),
  ['Before a run (no grade)', deskOf(run(Q, 'medium'), false)],
  ['A long pad (capped)', { effort: 'high', thinking: 900, wait: 23.4, right: false }],
];
const series = kindSeries();
const r = run(Q, 'high');
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Reasoning scene</title>
  </head>
  <body>
    <main>
      <h1>Reasoning scratchpad desk: every state</h1>
      <div class="grid">
        {STATES.map(([title, o]) => (
          <section>
            <h2>{title}</h2>
            <div class="wide"><IsoStage board={THINK_BOARD} scene={thinkScene({ ...o, scale: 1.3 })} label={thinkLabel(o)} /></div>
            <div class="phone"><IsoStage board={THINK_BOARD} scene={thinkScene({ ...o, scale: 2.2 })} label={thinkLabel(o)} /></div>
            <p>{thinkLabel(o)}</p>
          </section>
        ))}
      </div>
      <section>
        <h2>Accuracy by effort: the multi-step set</h2>
        <EffortChart client:load series={[series[1]]} />
      </section>
      <section>
        <h2>Accuracy by effort: every kind</h2>
        <EffortChart client:load series={series} />
      </section>
      <h1>The stage, live</h1>
      <div class="grid">
        <section><h2>Picture</h2><div class="stage"><ReasoningStage client:load shown={{ desk: deskOf(r), series, caption: 'High effort on the split quote', thinking: r.thinking }} /></div></section>
        <section><h2>Accuracy tab</h2><div class="stage"><ReasoningStage client:load view="chart" shown={{ desk: deskOf(r), series, caption: '<script>alert(1)</script> escaped caption' }} /></div></section>
      </div>
    </main>
  </body>
</html>
<style>
  main { max-width: 1240px; margin: 0 auto; padding: 24px 16px; display: flex; flex-direction: column; gap: 16px; }
  h1 { font: 800 15px ui-monospace, Menlo, monospace; margin: 16px 0 0; }
  h2 { font: 800 13px ui-monospace, Menlo, monospace; margin: 0; }
  p { font-size: 12px; margin: 0; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(360px, 1fr)); gap: 16px; }
  section { display: flex; flex-direction: column; gap: 6px; border: 1px solid var(--rule); border-radius: 10px; padding: 8px; background: var(--paper); }
  .phone { display: none; }
  .stage { display: flex; height: 560px; }
  @media (max-width: 599px) {
    .grid { grid-template-columns: 1fr; }
    .wide { display: none; }
    .phone { display: block; }
  }
</style>

---
// Dev-only eyeball page: the phone desk at every stage (static SVG), chained and speech to speech, barge-in, then the
// stage live in both tabs, and the clip buttons. Below 600px the phone versions show.
import '../styles/tokens.css';
import IsoStage from '../lib/iso/IsoStage';
import ClipPlayer from '../components/story/ClipPlayer';
import { PHONE_BOARD, phoneLabel, phonePlot, phoneScene, type PhoneOpts } from '../components/scenes/phoneScene';
import { Transcript, VoiceStage, segmentsOf, Say } from '../content/voice/kit';
import { DEFAULT_LINE, runCall } from '../lib/voice/engine';

const STATES: [string, PhoneOpts][] = [
  ['Idle', { stage: 'idle' }],
  ['The caller speaks', { stage: 'caller' }],
  ['Speech-to-text, unsure', { stage: 'stt', unsure: true }],
  ['The model writes', { stage: 'model' }],
  ['Text-to-speech', { stage: 'tts' }],
  ['The reply, 1.83 s wait', { stage: 'reply', wait: 1830 }],
  ['Talked over', { stage: 'reply', interrupt: true }],
  ['Barge-in: stopped', { stage: 'reply', interrupt: true, stopped: true }],
  ['Speech to speech, caller', { stage: 'caller', mode: 's2s' }],
  ['Speech to speech, reply', { stage: 'reply', mode: 's2s', wait: 900 }],
];
const good = { ...DEFAULT_LINE, silence: 800 as const, streaming: true, bargeIn: true };
const hes = runCall('hesitant', good), cut = runCall('hesitant', { ...good, silence: 300 }), slots = runCall('slots', good), over = runCall('slots', { ...good, bargeIn: false });
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Voice scene</title>
  </head>
  <body>
    <main>
      <h1>Voice phone desk: every state</h1>
      <div class="grid">
        {STATES.map(([title, o]) => (
          <section>
            <h2>{title}</h2>
            <div class="wide"><IsoStage board={PHONE_BOARD} scene={phoneScene({ ...o, scale: 1.25 })} label={phoneLabel(o)} /></div>
            <div class="phone"><IsoStage board={PHONE_BOARD} scene={phoneScene({ ...o, scale: 2 })} label={phoneLabel(o)} /></div>
            <p>{phoneLabel(o)}</p>
          </section>
        ))}
        <section>
          <h2>Hero plot</h2>
          <IsoStage board={[0, 0, 60, 60]} scene={({ top }) => phonePlot(30, 30, top)} label="The home hero's voice plot" />
        </section>
      </div>
      <h1>The stage, live</h1>
      <div class="grid">
        <section><h2>Picture</h2><div class="stage"><VoiceStage client:load shown={{ phone: { stage: 'reply', wait: hes.wait }, timeline: segmentsOf(hes), caption: 'Ravi, heard whole' }} /></div></section>
        <section><h2>Timeline: heard whole</h2><div class="stage"><VoiceStage client:load view="timeline" shown={{ phone: { stage: 'reply' }, timeline: segmentsOf(hes), caption: '<script>alert(1)</script> escaped caption' }} /></div></section>
        <section><h2>Timeline: cut off</h2><div class="stage"><VoiceStage client:load view="timeline" shown={{ phone: { stage: 'reply' }, timeline: segmentsOf(cut), caption: 'Cut off at 300 ms' }} /></div></section>
        <section><h2>Timeline: barge-in</h2><div class="stage"><VoiceStage client:load view="timeline" shown={{ phone: { stage: 'reply' }, timeline: segmentsOf(slots), caption: 'Stopped' }} /></div></section>
        <section><h2>Timeline: talked over</h2><div class="stage"><VoiceStage client:load view="timeline" shown={{ phone: { stage: 'reply' }, timeline: segmentsOf(over), caption: 'Talked over' }} /></div></section>
      </div>
      <h1>Clips</h1>
      <div class="grid">
        <section><Say client:load clip="status-caller" /><Say client:load clip="status-reply" /><Say client:load clip="noisy-caller" /><ClipPlayer client:load clip="missing-clip" who="Nobody" caption="This clip does not exist: pressing Play shows the error state." /></section>
        <section><Transcript client:load run={runCall('mishear', { ...good, readBack: true })} /></section>
        <section><Transcript client:load run={over} /></section>
      </div>
    </main>
  </body>
</html>
<style>
  main { max-width: 1240px; margin: 0 auto; padding: 24px 16px; display: flex; flex-direction: column; gap: 16px; }
  h1 { font: 800 15px ui-monospace, Menlo, monospace; margin: 16px 0 0; }
  h2 { font: 800 13px ui-monospace, Menlo, monospace; margin: 0; }
  p { font-size: 12px; margin: 0; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(360px, 1fr)); gap: 16px; }
  section { display: flex; flex-direction: column; gap: 6px; border: 1px solid var(--rule); border-radius: 10px; padding: 8px; background: var(--paper); }
  .phone { display: none; }
  .stage { display: flex; height: 520px; }
  @media (max-width: 599px) {
    .grid { grid-template-columns: 1fr; }
    .wide { display: none; }
    .phone { display: block; }
  }
</style>

  'multi-agent-04-agreed-shapes': () => maAt(MA_REPORT, maSet(3), true, { malformed: true }),
  'multi-agent-05-waiting': () => maAt(MA_RATES, maSet(2), true),
  'multi-agent-06-trusting-a-helper': () => maAt(MA_REPORT, maSet(3, { check: true }), true, { slip: true }),
  'multi-agent-07-workbench': () => maAt(MA_REPORT, maSet(3, { check: true, timeout: true }), true, { slip: true }),
};
const switchOg = SWITCH_OG[page.og]?.();
// module 63: the cork board, each chapter at its reveal, unzoomed. The intro: the month with the deals page's cards lit;
// 1: Ada's chat sorted; 2: day 10, three sources traced; 3: the newer card won and the web card rejected; 4: Cara

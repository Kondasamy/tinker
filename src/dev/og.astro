  'tools-in-production-03-the-tool-changed': () => tpCh3({ night: true, hung: true, ...tpQ }),
  'tools-in-production-04-a-fingerprint': () => tpCh4({ pinned: true, night: true, hung: true, ...tpQ }),
  'tools-in-production-05-hidden-instructions': () => tpCh5({ read: true, hung: true, barred: false, ...tpQ }),
  'tools-in-production-06-who-is-calling': () => tpCh6({ shared: true, own: false, ownReplay: false, ...tpQ }),
  'tools-in-production-07-workbench': () => {

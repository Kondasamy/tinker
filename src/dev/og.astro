  ? (() => {
      const ls = labelledOf(suite),
        a = agreement(
          ls.map(l => l.row),
          'r1',
        );
      const hat5 = SAMPLES.map(c => passHatK(c, 5)),
        v3 = gradeRows(suite.v3, 'verdict');
      const gate = decide(gradeRows(suite[BASELINE], 'verdict'), v3, { threshold: 75, noRegressions: true });
      return {
        evals: () => ({ results: resultsOf(suite.v2), version: VERSIONS.v2.label }),
        // chapter 2: the test set stacked, nothing graded yet
        'evals-02-the-test-set': () => ({
          results: QUESTIONS.map(() => true),
          graded: 0,
          board: `TEST SET · ${QUESTIONS.length} CASES`,
        }),
        // chapter 3: v0 (no documents) half graded by code, the next answer on the belt
        'evals-03-graders': () => ({
          results: resultsOf(suite.v0),
          graded: Math.ceil(QUESTIONS.length / 2),
          riding: true,
          board: `${VERSIONS.v0.label} · CODE GRADERS`,
        }),
        // chapter 4: the r1 judge against the people's labels; a pass is agreement
        'evals-04-judge-the-judge': () => ({
          results: ls.map(
            l => judged(l.row.question, l.row.signature, 'r1')!.pass === label(l.row.question, l.row.signature)!.pass,
          ),
          board: `r1 AGREES ${a.agree}/${a.total}`,
        }),
        'evals-06-run-it-twice': () => ({
          results: hat5,
          board: `PASS^5 ${hat5.filter(Boolean).length}/${SAMPLES.length}`,
        }),
        // chapter 7: v3 through the gate (75%, no regressions)
        'evals-07-release-day': () => ({
          results: v3,
          version: VERSIONS.v3.label,
          board: `${VERSIONS.v3.label} · ${gate.passed}/${v3.length} · ${gate.ship ? 'SHIP' : 'DO NOT SHIP'}`,
        }),
      };
    })()
  : {};

    run: LOOP_RUN,
    gauge: { steps: AGENT_DEFAULTS.steps, context: AGENT_CONTEXT },
    scale: 1.5,
  }),
  // chapter 3: the plan on the clipboard after the stock-out, the replacement struck and the refund added
  'agents-03-plans': agentScene({
    run: agentRun(AGENT_RECORDINGS['03-plans'], { case: 'damaged', stock: 'out', plan: true }),
    clipboard: true,
    scale: 1.5,

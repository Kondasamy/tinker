// with its threads; chapter 1: the reply after three added tokens; chapter 2: the second copy of the repeated word picked;
// chapter 4: the word-start head on the piece that continues a word; chapter 6: the full window; chapter 7: a prompt past
// the window, a second-floor head lit, token 21's threads. Chapter 3: the attention heatmap; chapter 5: the next-token bar at temperature 1.5.
const lm = page.og.startsWith('transformers') ? diskModel() : null;
const roomOf = (text: string, o: Partial<EngineOpts> = {}): EngineOpts => {
  const t = trace(lm!, text);
  return { tokens: t.tokens.map(x => x.text), attention: t.attention, ...o }; // scale 1: the pills keep the pieces
};
const ENGINE_OG: Record<string, () => EngineOpts> = {
  transformers: () => roomOf(TF_REPLY.text),
  'transformers-01-one-token-at-a-time': () => roomOf(grown(lm!, 3).text),

  .pt-og { font-size: 20px; }
  .mm-og { display: flex; justify-content: center; }
  .mm-og img { max-height: 520px; max-width: 100%; border: 2px solid var(--ink); border-radius: 6px; box-shadow: 5px 5px 0 var(--ink); }
  .tf-og :global(svg) { width: 100%; height: auto; max-height: 520px; }
  .map-og :global(.legend) { text-align: center; font-size: 18px; }   /* the capture is a still: no message mid-travel */
</style>

// chapter 1: the script stopped at the step nobody wrote a fallback for. Recaps keep the recall cards.
const PRINTER = (mode: 'script' | 'agent') =>
  agentRun(AGENT_RECORDINGS['01-workflow-or-agent'], { case: 'damaged', stock: 'out', mode });
const AGENT_RUN = PRINTER('agent'),
  LOOP_RUN = agentRun(AGENT_RECORDINGS['02-the-loop']);

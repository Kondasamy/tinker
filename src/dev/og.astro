---
// Share-image template (dev only): one 1200×630 card per public page, captured to public/og/<og>.jpg by `pnpm og`.
// Text comes from src/lib/pages.ts; each card shows that page's own picture.
import '../styles/tokens.css';
import IsoStage from '../lib/iso/IsoStage';
import Timeline from '../components/scenes/Timeline';
import ContextOverflow from '../components/scenes/ContextOverflow';
import RecallCards from '../components/scenes/RecallCards';
import { staticTrack } from '../components/scenes/staticTrack';
import { miniPipeline, MINI_BOARD } from '../components/scenes/miniPipeline';
import { TRACK_BOARD } from '../components/canvas/track';
import { unlockedThrough } from '../components/canvas/state';
import { CHAPTERS } from '../lib/chapters';
import { ALL_PAGES } from '../lib/pages';
import { TIMELINE, STOP_5TB } from '../lib/scale';
import { SEQ_MSGS, transcript } from '../components/scenes/toolSequence';
import { OFFICE_BOARD, officeScene, type OfficeOpts } from '../components/scenes/officeScene';
import { HERO_BOARD, HOME_HERO } from '../components/scenes/heroScene';
import { run } from '../lib/tools/host';
import { RECORDINGS } from '../lib/tools/turns';
import { SERVERS } from '../lib/tools/server';
import { MCP_BOARD, connectScene } from '../components/scenes/mcpScene';
import { agentScene } from '../components/scenes/agentScene';
import { run as agentRun, CONTEXT as AGENT_CONTEXT, DEFAULTS as AGENT_DEFAULTS, MEMORY_CONTEXT } from '../lib/agents/loop';
import { RECORDINGS as AGENT_RECORDINGS } from '../lib/agents/turns';
import { diskLoader } from '../lib/rag/diskLoader';
import { EVAL_BOARD, evalScene, type EvalOpts } from '../components/scenes/evalScene';
import { Grid, colsOf, loadSuite, resultsOf } from '../content/evals/kit';
import { labelledOf } from '../content/evals/04-judge-the-judge';
import { QUESTIONS, VERSIONS, BASELINE } from '../lib/evals/suite';
import { SAMPLES, agreement, decide, gradeRows, judged, label, passHatK } from '../lib/evals/graders';
import { GUARD_BOARD, guardScene } from '../components/scenes/guardScene';
import { run as guardRun } from '../lib/guardrails/loop';
import { RECORDING as GUARD_RECORDING } from '../lib/guardrails/turns';

export function getStaticPaths() {
  return ALL_PAGES.map(page => ({ params: { slug: page.og }, props: { page } }));
}
const { page } = Astro.props;
// module 2 chapters: the run each chapter is about, in the back-office picture, at the moment that tells the chapter
const seq = (id: string, setup = {}) => transcript(RECORDINGS[id], run(RECORDINGS[id], setup));
const office = (id: string, o: Partial<OfficeOpts> = {}, setup = {}, upTo?: number) => {
  const msgs = seq(id, setup);
  return officeScene({ msgs, upTo, tools: RECORDINGS[id].tools.length, scale: 1.5, ...o });
};
const TOOL_OG: Record<string, ReturnType<typeof officeScene>> = {
  'tool-calling-01-answers-arent-actions': office('no-tools', { host: 'Assistant app' }),
  // the call on its way to the order system
  'tool-calling-02-first-tool': office('order-status', {}, {}, 4),
  // the string id held at the schema check
  'tool-calling-03-valid-isnt-correct': office('invalid-arg', { schema: true }, {}, 3),
  // two lookups on the belt at once
  'tool-calling-04-many-steps': office('parallel', { schema: true }, {}, 6),
  // the planted refund, held at the approval barrier
  'tool-calling-06-when-tools-go-wrong': office('injection', { schema: true, gate: true, note: true }, { gate: true }),
};
const tool = TOOL_OG[page.og];
const MCP_OG = connectScene({ servers: Object.values(SERVERS).map(s => ({ name: s.title.toUpperCase(), connected: true })), scale: 1.5 });
// the workbench: the same host, its gate on
const BENCH_OG = connectScene({ servers: Object.values(SERVERS).map(s => ({ name: s.title.toUpperCase(), connected: true })), host: 'HOST · GATE ON', scale: 1.5 });
// module 3: the cracked printer, out of stock. The intro: the agent telling the customer after it changed course;
// chapter 1: the script stopped at the step nobody wrote a fallback for. Recaps keep the recall cards.
const PRINTER = (mode: 'script' | 'agent') => agentRun(AGENT_RECORDINGS['01-workflow-or-agent'], { case: 'damaged', stock: 'out', mode });
const AGENT_RUN = PRINTER('agent'), LOOP_RUN = agentRun(AGENT_RECORDINGS['02-the-loop']);
const AGENT_OG: Record<string, ReturnType<typeof agentScene>> = {
  agents: agentScene({ run: AGENT_RUN, upTo: AGENT_RUN.steps.length - 1, scale: 1.5 }),
  'agents-01-workflow-or-agent': agentScene({ run: PRINTER('script'), scale: 1.5 }),
  // chapter 2: the loop's last turn, the model answering with no call, the gauge far from the step budget
  'agents-02-the-loop': agentScene({ run: LOOP_RUN, gauge: { steps: AGENT_DEFAULTS.steps, context: AGENT_CONTEXT }, scale: 1.5 }),
  // chapter 3: the plan on the clipboard after the stock-out, the replacement struck and the refund added
  'agents-03-plans': agentScene({ run: agentRun(AGENT_RECORDINGS['03-plans'], { case: 'damaged', stock: 'out', plan: true }), clipboard: true, scale: 1.5 }),
  // chapter 4: the stuck loop with no detector, the gauge full at the step budget
  'agents-04-budgets': agentScene({ run: agentRun(AGENT_RECORDINGS['04-budgets'], { repeat: null }), gauge: { steps: AGENT_DEFAULTS.steps, context: AGENT_CONTEXT }, scale: 1.5 }),
  // chapter 5: the storm case with summary memory at the chapter's budget, the history compacted into one binder
  'agents-05-memory': agentScene({ run: agentRun(AGENT_RECORDINGS['05-memory'], { mem: 'summary', context: MEMORY_CONTEXT }), gauge: { steps: AGENT_DEFAULTS.steps, context: MEMORY_CONTEXT }, tray: true, scale: 1.5 }),
  // chapter 6: the storm case handed out, five helper desks each with a reply on it, the lead's gauge low. Scale 1:
  // a larger scale draws the phone's single desk, and the five desks are the picture
  'agents-06-sub-agents': agentScene({ run: agentRun(AGENT_RECORDINGS['06-sub-agents'], { helpers: true }), gauge: { steps: AGENT_DEFAULTS.steps, context: AGENT_CONTEXT }, helpers: true }),
  // chapter 7: the bench with the planted case planned and approved, so the clipboard, the gauge and the tray are all out
  'agents-07-workbench': agentScene({ run: agentRun(AGENT_RECORDINGS['03-plans'], { case: 'planted', plan: true }), clipboard: true, gauge: { steps: AGENT_DEFAULTS.steps, context: AGENT_CONTEXT }, tray: true, scale: 1.5 }),
};
const agent = AGENT_OG[page.og];
// module 4: the test bench at the moment each chapter turns on (chapter 1 the v1/v2 grid, chapter 5 the back office run
// it grades). The suite runs here at build time, from the committed index, as on the intro.
const suite = page.og.startsWith('evals') ? await loadSuite(diskLoader) : null;
const EVAL_OG: Record<string, () => EvalOpts> = suite ? (() => {
  const ls = labelledOf(suite), a = agreement(ls.map(l => l.row), 'r1');
  const hat5 = SAMPLES.map(c => passHatK(c, 5)), v3 = gradeRows(suite.v3, 'verdict');
  const gate = decide(gradeRows(suite[BASELINE], 'verdict'), v3, { threshold: 75, noRegressions: true });
  return {
    evals: () => ({ results: resultsOf(suite.v2), version: VERSIONS.v2.label }),
    // chapter 2: the test set stacked, nothing graded yet
    'evals-02-the-test-set': () => ({ results: QUESTIONS.map(() => true), graded: 0, board: `TEST SET · ${QUESTIONS.length} CASES` }),
    // chapter 3: v0 (no documents) half graded by code, the next answer on the belt
    'evals-03-graders': () => ({ results: resultsOf(suite.v0), graded: Math.ceil(QUESTIONS.length / 2), riding: true, board: `${VERSIONS.v0.label} · CODE GRADERS` }),
    // chapter 4: the r1 judge against the people's labels; a pass is agreement
    'evals-04-judge-the-judge': () => ({ results: ls.map(l => judged(l.row.question, l.row.signature, 'r1')!.pass === label(l.row.question, l.row.signature)!.pass), board: `r1 AGREES ${a.agree}/${a.total}` }),
    'evals-06-run-it-twice': () => ({ results: hat5, board: `PASS^5 ${hat5.filter(Boolean).length}/${SAMPLES.length}` }),
    // chapter 7: v3 through the gate (75%, no regressions)
    'evals-07-release-day': () => ({ results: v3, version: VERSIONS.v3.label, board: `${VERSIONS.v3.label} · ${gate.passed}/${v3.length} · ${gate.ship ? 'SHIP' : 'DO NOT SHIP'}` }),
  };
})() : {};
const evalOpts = EVAL_OG[page.og]?.();
// chapter 5: the planted refund on its way to the order system, with no gate: the run whose reply reads fine and whose
// ledger does not
const EVAL_PATH = officeScene({ msgs: seq('injection'), upTo: 8, tools: RECORDINGS.injection.tools.length, note: true, scale: 1.5 });
// module 5: the forwarded invoice with no defences. The intro: the customer's record riding out to the post box;
// chapter 1: the email riding in, tagged as untrusted, before the model reads it
const INVOICE = guardRun(GUARD_RECORDING, { case: 'invoice' });
const ALLOWED = guardRun(GUARD_RECORDING, { case: 'invoice', allow: true });
const callAt = (name: string) => INVOICE.steps.findIndex(st => st.kind === 'call' && st.call.name === name) + 1;
const GUARD_OG: Record<string, ReturnType<typeof guardScene>> = {
  guardrails: guardScene({ run: INVOICE, upTo: callAt('send_email'), scale: 1.5 }),
  'guardrails-01-data-or-instructions': guardScene({ run: INVOICE, upTo: callAt('read_inbox') + 1, scale: 1.5 }),
  // chapter 2: the forwarded invoice held at the screening arch; chapter 3: its send stopped at the allow-list barrier;
  // chapter 4: the three legs named, the chute shut by the taint rule once the email was read
  'guardrails-02-input-filters': guardScene({ run: guardRun(GUARD_RECORDING, { case: 'invoice', threshold: 0.5 }), screen: true, scale: 1.5 }),
  'guardrails-03-the-way-out': guardScene({ run: ALLOWED, upTo: ALLOWED.steps.findIndex(st => st.kind === 'blocked') + 1, allow: true, scale: 1.5 }),
  'guardrails-04-the-trifecta': guardScene({ run: guardRun(GUARD_RECORDING, { case: 'invoice', taint: true }), legs: true, taint: true, scale: 1.5 }),
};
const guard = GUARD_OG[page.og];
---
<html lang="en">
  <head><meta charset="utf-8" /><meta name="robots" content="noindex" /><title>og: {page.og}</title></head>
  <body>
    <div class="og" data-og={page.og}>
      <div class="text">
        <p class="brand"><img src="/favicon.svg" alt="" width="40" height="40" /> {page.kicker}</p>
        <h1>{page.headline}</h1>
        <p class="sub">{page.sub}</p>
        <p class="foot">explain.kondasamy.com <span>· by Kondasamy Jayaraman</span></p>
      </div>
      <div class="pic">
        {/* a new module's pages fall through to the recall cards until they get a picture case here */}
        {page.og === 'home' ? <IsoStage board={HERO_BOARD} scene={HOME_HERO} label="" />
          : page.og === 'rag' ? <IsoStage board={MINI_BOARD} scene={miniPipeline} label="" />
          : page.og === 'tool-calling' ? <IsoStage board={OFFICE_BOARD} scene={officeScene({ msgs: SEQ_MSGS, upTo: 3, tools: 2, scale: 1.5 })} label="" />
          : evalOpts ? <IsoStage board={EVAL_BOARD} scene={evalScene({ ...evalOpts, scale: 1.5 })} label="" />
          : page.og === 'evals-01-it-worked-when-i-tried-it' && suite ? <Grid cols={colsOf(suite, ['v1', 'v2'])} />
          : page.og === 'evals-05-grading-the-path' ? <IsoStage board={OFFICE_BOARD} scene={EVAL_PATH} label="" />
          : guard ? <IsoStage board={GUARD_BOARD} scene={guard} label="" />
          : agent ? <IsoStage board={OFFICE_BOARD} scene={agent} label="" />
          : tool ? <IsoStage board={OFFICE_BOARD} scene={tool} label="" />
          : page.og === 'tool-calling-05-mcp' ? <IsoStage board={MCP_BOARD} scene={MCP_OG} label="" />
          : page.og === 'tool-calling-07-workbench' ? <IsoStage board={MCP_BOARD} scene={BENCH_OG} label="" />
          : page.og === '01-history' ? <Timeline entries={TIMELINE} visited={4} active={3} onPick={() => {}} pills={1.7} />
          : page.og === '02-why-not-stuff-it' ? <ContextOverflow stop={STOP_5TB} pills={1.7} />
          : CHAPTERS.some(c => (c.og ?? c.id) === page.og) ? <IsoStage board={TRACK_BOARD} scene={staticTrack(unlockedThrough(page.og), { scale: 1.6 })} label="" />
          : <RecallCards label="" />}
      </div>
    </div>
  </body>
</html>

<style>
  /* scoped: a global rule here would leak into every page's CSS in DEV_PAGES builds (the step card is also .card) */
  :global(html), :global(body) { margin: 0; background: var(--paper); }
  .og { width: 1200px; height: 630px; box-sizing: border-box; padding: 56px 48px 48px 64px; display: grid; grid-template-columns: 500px 1fr; gap: 24px; align-items: center; overflow: hidden;
    background-image: radial-gradient(circle at 80% 50%, rgba(255, 182, 39, .14), transparent 55%); border-bottom: 14px solid var(--ink); }
  .text { display: flex; flex-direction: column; gap: 18px; height: 100%; }
  .brand { margin: 0; display: flex; align-items: center; gap: 12px; font-size: 22px; font-weight: 800; letter-spacing: .02em; }
  h1 { margin: 0; font-size: 50px; line-height: 1.08; letter-spacing: -.015em; }
  .sub { margin: 0; font-size: 22px; line-height: 1.4; color: var(--muted); }
  .foot { margin: auto 0 0; font-size: 18px; font-weight: 800; }
  .foot span { color: var(--muted); font-weight: 400; }
  .pic { min-width: 0; }
  .pic :global(figure) { margin: 0; }
  .pic :global(figcaption) { display: none; }
  .pic :global(svg) { max-height: 520px; }
  .pair :global(svg) { max-height: 255px; }   /* home: one picture per live module, stacked */
  .pic :global(.msg *) { animation: none !important; }   /* the capture is a still: no message mid-travel */
</style>

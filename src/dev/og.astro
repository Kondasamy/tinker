  'tokens-04-every-tokenizer-splits-differently': () => encodingOf('order-ja', TOKENIZERS[TOKENIZERS.length - 1].id),
};
const MAP_OG: Record<string, string> = {
  'tokens-05-from-token-to-vector': 'stale-hotel-limit',
  'tokens-06-meaning-by-neighbours': 'k2-volume-price',

  'caching-07-cache-policy': () => [depotAt(cacheRun(CACHE_WINNERS[0]), MOMENTS.sale + 2)],
};
const depotOgs = DEPOT_OG[page.og]?.();
// module 22: the filing room. The intro: order 1042 through its index, the winning plan beside it; 1: the full scan;
// 2: the lookup; 3: a new order written into three indexes; 4: a regular's month through (customer, date); 5: this
// month scanned, the date index skipped; 6: the join through the customers index; 7: the costliest request under the
// winning plan.
const DB_OG: Record<string, () => Omit<ArchiveOpts, 'scale'>> = {
  databases: () => ({ ...archiveAt(dbExec(DB_ONE, 'id'), DB_ONE), others: DB_WINNERS[0].length - 1 }),
  'databases-01-find-one-order': () => archiveAt(dbExec(DB_ONE, 'scan'), DB_ONE),
  'databases-02-the-index': () => archiveAt(dbExec(DB_ONE, 'id'), DB_ONE),
  'databases-03-every-write-pays': () => ({
    read: [],
    written: [TABLE_PAGES - 1],
    pages: 0,
    rows: 0,
    index: { name: 'order number', levels: levelsOf('id', { where: { id: DB_NEW.id } }), write: true },
    others: 2,
  }),
  'databases-04-column-order': () => archiveAt(dbExec(DB_MINE, 'customer_date'), DB_MINE),
  'databases-05-planner-skips': () => ({
    ...archiveAt(dbQuery(DB_MONTHS, ['date']), DB_MONTHS),
    index: { name: 'date', levels: levelsOf('date', DB_TODAYS).map(l => ({ ...l, at: -1 })) },
  }),
  'databases-06-joining-tables': () => {
    const j = dbJoin(DB_TODAYS, ['date'], true);
    return archiveAt(j.outer, DB_TODAYS, {
      customers: { pages: j.innerPages, lit: new Set(j.outer.rows.map(r => dbPageOf(r.customer - 1))).size },
    });
  },
  'databases-07-index-plan': () => {
    const set = DB_WINNERS[0],
      top = DB_READS.reduce((a, r) =>
        r.perDay * dbQuery(r.query, set).pages > a.perDay * dbQuery(a.query, set).pages ? r : a,
      ),
      run = dbQuery(top.query, set);
    return archiveAt(run, top.query, { others: Math.max(0, set.length - (run.how === 'scan' ? 0 : 1)) });
  },
};
const dbOg = DB_OG[page.og]?.();
// module 23: the three warehouses. The intro: North selling the drill press West already sold, the line down; 1: a
// stale look; 2: the last hinge sold twice; 3: West refusing under quorums; 4: quorums with the line up; 5: reservations
// at North; 6: sticky reads; 7: the first winning policy.
const csOne = csRun(csPol({ r: 1, w: 1, rule: 'lww' })),
  csOpen = csRun(csPol({ r: 1, w: 1, rule: 'lww' }, { partition: true })),
  csRight = csRun(csPol({ r: 2, w: 2, rule: 'lww' }, { partition: true }));
const STOCK_OG: Record<string, () => Omit<StockOpts, 'scale'>> = {
  consistency: () => stockAt(csOpen, CS_M.northSells),
  'consistency-01-one-count-three-copies': () => stockAt(csOne, CS_M.staleLook),
  'consistency-02-two-buyers-one-hinge': () => stockAt(csOne, CS_M.lastHinge),
  'consistency-03-the-link-goes-down': () => stockAt(csRight, CS_M.westSells),
  'consistency-04-quorums': () => stockAt(csRun(csPol({ r: 2, w: 2, rule: 'lww' })), CS_M.staleLook),
  'consistency-05-who-wins': () => stockAt(csRun(csPol({ r: 2, w: 2, rule: 'primary' })), CS_M.lastHinge),
  'consistency-06-eventually': () =>
    stockAt(csRun(csPol({ r: 1, w: 1, rule: 'lww' }, { sticky: true })), CS_M.priyaLooks),
  'consistency-07-stock-policy': () => stockAt(csRun(CS_WINNERS[0]), CS_M.westSells),
};
const stockOg = STOCK_OG[page.og]?.();
// module 24: the shop floor. The intro and 1: the one-page checkout winning at its end; 2: an A/A run at its end; 3: the
// bigger button run for enough shoppers; 4: the result chart (below); 5: the lucky colour; 6: the banner, returns up;
// 7: the first bench experiment with its guardrail.
const abEnd = (p: typeof ABS.aa) => p.days - 1,
  ab3 = { ...ABS.small, days: AB_ENOUGH },
  abBench = AB_BENCH[0];
const SPLIT_OG: Record<string, () => Omit<SplitOpts, 'scale'>> = {
  'ab-testing': () => splitAt(abRun(ABS.checkout), ABS.checkout, abEnd(ABS.checkout)),
  'ab-testing-01-did-it-work': () => splitAt(abRun(ABS.checkout), ABS.checkout, abEnd(ABS.checkout)),
  'ab-testing-02-luck': () => splitAt(abRun(ABS.aa), ABS.aa, abEnd(ABS.aa)),
  'ab-testing-03-how-many-shoppers': () => splitAt(abRun(ab3), ab3, abEnd(ab3)),
  'ab-testing-05-twenty-colours': () =>
    splitAt(abRun(ABS.colours), ABS.colours, abEnd(ABS.colours), { arm: AB_LUCKY_ARM, name: AB_LUCKY }),
  'ab-testing-06-guardrails': () => ({
    ...splitAt(abRun(ABS.hurry), ABS.hurry, abEnd(ABS.hurry), { guardrail: true }),
    verdict: 'B WINS · RETURNS UP',
    tone: 'warn',
  }),
  'ab-testing-07-ship-or-stop': () => {
    const o = splitAt(abRun(abBench), abBench, abEnd(abBench), { guardrail: true });
    return abRule(abBench).guardrailHolds ? o : { ...o, verdict: `${o.verdict} · RETURNS UP`, tone: 'warn' };
  },
};
const splitOg = SPLIT_OG[page.og]?.();
const abChartOg =
  page.og === 'ab-testing-04-peeking'
    ? { run: abRun(ABS.aa), peek: peekResult(abRun(ABS.aa), AB.level)?.t }
    : undefined;
// module 25: the darkroom. The intro: a hinge half developed; chapter 1: the denoising strip (below); chapter 2: dots after
// 5 steps; chapter 3: dots after 50; chapter 4: the ideal denoiser's copies on its training points; chapter 5: a drill asked
// for at guidance 4; chapter 6: the drill as a latent; chapter 7: the first winning catalogue choice.
const dfModel = () => {
  const bin = readFileSync('public/data/diffusion/points.bin');
  return parsePoints(DF_META, bin.buffer.slice(bin.byteOffset, bin.byteOffset + bin.byteLength) as ArrayBuffer);
};
const dfDots = (steps: number): DarkroomOpts['print'] => ({
  kind: 'points',
  pts: samplePoints(dfModel(), DF_DOTS, steps, DF_SEED),
  name: steps < 50 ? 'DOTS' : 'HINGE',
});
const DARK_OG: Record<string, () => DarkroomOpts> = {
  diffusion: () => ({
    print: { kind: 'pixels', px: noised(dfDrawing('hinge-square').pixels, 0.5, 3), name: 'DEVELOPING' },
    steps: 50,
    done: 25,
  }),
  'diffusion-02-step-by-step': () => ({ print: dfDots(5), steps: 5 }),
  'diffusion-03-a-learned-denoiser': () => ({ print: dfDots(50), steps: 50 }),
  'diffusion-04-copy-or-create': () => ({
    print: {
      kind: 'points',
      pts: sampleIdealPoints(DF_TRAIN, DF_DOTS, DF_STEPS_4, DF_SEED),
      train: DF_TRAIN,
      name: 'COPIES',
    },
    steps: DF_STEPS_4,
  }),
  'diffusion-05-steer-with-a-label': () => ({
    print: { kind: 'pixels', px: sampleDrawing(DF_STEPS_5, 2, 'drill', 4), name: 'DRILL' },
    steps: DF_STEPS_5,
    label: 'drill',
    guidance: 4,
  }),
  'diffusion-06-why-it-costs': () => ({
    print: { kind: 'pixels', px: dfDrawing('drill-pistol').pixels, name: 'LATENT' },
    steps: DF_STEPS_6,
  }),
  'diffusion-07-workbench': () => {
    const c = DF_WINNERS[0].catalogue;
    return {
      print: { kind: 'pixels', px: sampleDrawing(c.steps, DF_SEEDS[0], 'drill', c.scale), name: 'DRILL' },
      steps: c.steps,
      label: 'drill',
      guidance: c.scale,
    };
  },
};
const darkOg = DARK_OG[page.og]?.();
const dfStripSrc = (() => {
  if (page.og !== 'diffusion-01-noise-to-picture') return undefined;
  const s = denoiseStrip(pictureFrames(trajectory(DF_STEPS_1, DF_SEED_1)));
  return `data:image/svg+xml;charset=utf-8,${encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${s.w} ${s.h}">${s.svg}</svg>`)}`;
})();
const lensOg =
  page.og === 'interpretability-03-the-guess-forming'
    ? (() => {
        const p = LENS.find(x => x.id === 'expenses')!,
          l = lens(ip!, p.text);
        return lensGrid({ stages: LENS_STAGES, guesses: l.stages.map(st => st.at(-1)!), watch: p.expected });
      })()
    : undefined;
const curveOg =
  page.og === 'pre-training-03-held-out'
    ? lossChart({ series: CKPT_SERIES })
    : page.og === 'fine-tuning-02-what-training-does'
      ? lossChart({ series: FINETUNE_SERIES })
      : page.og === 'small-models-02-learning-from-a-teacher'
        ? lossChart({ series: STUDENT_SERIES })
        : undefined;
// a long title may wrap, but the kicker's last part ("Chapter 3 of 7") stays on one line
const cut = page.kicker.lastIndexOf(' · ') + 1,
  kickerHead = page.kicker.slice(0, cut && cut + 2),
  kickerTail = page.kicker.slice(kickerHead.length);
---
<html lang="en">
  <head><meta charset="utf-8" /><meta name="robots" content="noindex" /><title>og: {page.og}</title></head>
  <body>
    <div class="og" data-og={page.og}>
      <div class="text">
        <p class="brand"><img src="/favicon.svg" alt="" width="40" height="40" /> <span>{kickerHead}<span class="nowrap">{kickerTail}</span></span></p>
        <h1>{page.headline}</h1>
        <p class="sub">{page.sub}</p>
        <p class="foot">tinker.kondasamy.com <span>· by Kondasamy Jayaraman</span></p>
      </div>
      <div class="pic">
        {/* a new module's pages fall through to the recall cards until they get a picture case here */}
        {page.og === 'home' ? <IsoStage board={HERO_BOARD} scene={HOME_HERO} label="" />
          : page.og === 'rag' ? <IsoStage board={MINI_BOARD} scene={miniPipeline} label="" />
          : page.og === 'tool-calling' ? <IsoStage board={OFFICE_BOARD} scene={officeScene({ msgs: SEQ_MSGS, upTo: 3, tools: 2, scale: 1.5 })} label="" />
          : evalOpts ? <IsoStage board={EVAL_BOARD} scene={evalScene({ ...evalOpts, scale: 1.5 })} label="" />
          : page.og === 'evals-01-it-worked-when-i-tried-it' && suite ? <Grid cols={colsOf(suite, ['v1', 'v2'])} />
          : page.og === 'evals-05-grading-the-path' ? <IsoStage board={OFFICE_BOARD} scene={EVAL_PATH} label="" />
          : guard ? <IsoStage board={GUARD_BOARD} scene={guard} label="" />
          : pressText ? <IsoStage board={TOKEN_BOARD} scene={tokenScene({ text: pressText, scale: 1.5 })} label="" />
          : row ? <div class="tk-og"><TokenRow enc={row} /></div>
          : map ? <div class="tk-og map-og"><ProjectionMap out={map.out} index={map.index} /></div>
          : engine ? <IsoStage board={ENGINE_BOARD} scene={engineScene(engine)} label="" />
          : flat ? <div class="tf-og"><Flat fig={flat} role="img" label="" /></div>
          : benchOg ? <IsoStage board={TRAIN_BOARD} scene={trainScene({ ...benchOg, scale: 1.3 })} label="" />
          : stencilOg ? <IsoStage board={STENCIL_BOARD} scene={stencilScene(stencilOg)} label="" />
          : gridOg ? <div class="tf-og"><Flat fig={gridOg} role="img" label="" /></div>
          : thinkOgs ? <div class={thinkOgs.length > 1 ? 'duo' : ''}>{thinkOgs.map(o => <IsoStage board={THINK_BOARD} scene={thinkScene(o)} label="" />)}</div>
          : effortOg ? <div class="tf-og"><Flat fig={effortOg} role="img" label="" /></div>
          : routerOg ? <IsoStage board={ROUTER_BOARD} scene={routerScene({ ...routerOg, scale: 1.3 })} label="" />
          : frontierOg ? <div class="tf-og"><Flat fig={frontierOg} role="img" label="" /></div>
          : serveOgs ? <div class={serveOgs.length > 1 ? 'duo' : ''}>{serveOgs.map(o => <IsoStage board={SERVE_BOARD} scene={serveScene({ ...o, scale: 1.3 })} label="" />)}</div>
          : roomOg ? <IsoStage board={TRACE_BOARD} scene={traceScene({ ...roomOg, scale: 1.3 })} label="" />
          : glassOg ? <IsoStage board={SANDBOX_BOARD} scene={sandboxScene(glassOg)} label="" />
          : scanOg ? <IsoStage board={SCAN_BOARD} scene={scanScene({ ...scanOg, scale: 1.3 })} label="" />
          : patchSrc ? <div class="mm-og"><img src={patchSrc} alt="" /></div>
          : phoneOg ? <IsoStage board={PHONE_BOARD} scene={phoneScene({ ...phoneOg, scale: 1.3 })} label="" />
          : forgeOg ? <IsoStage board={FORGE_BOARD} scene={forgeScene(forgeOg)} label="" />
          : examOg ? <IsoStage board={EXAM_BOARD} scene={examScene({ ...examOg, scale: 1.3 })} label="" />
          : fuseOg ? <IsoStage board={FUSE_BOARD} scene={fuseScene(fuseOg)} label="" />
          : dbOg ? <IsoStage board={ARCHIVE_BOARD} scene={archiveScene({ ...dbOg, scale: 1.3 })} label="" />
          : stockOg ? <IsoStage board={STOCK_BOARD} scene={stockScene({ ...stockOg, scale: 1.4 })} label="" />
          : splitOg ? <IsoStage board={SPLIT_BOARD} scene={splitScene({ ...splitOg, scale: 1.3 })} label="" />
          : darkOg ? <IsoStage board={DARK_BOARD} scene={darkroomScene({ ...darkOg, scale: 1.3 })} label="" />
          : dfStripSrc ? <div class="mm-og"><img src={dfStripSrc} alt="" /></div>
          : abChartOg ? <div class="tf-og ab-og"><ResultView chart={abChartOg} /></div>
          : depotOgs ? <div class={depotOgs.length > 1 ? 'duo' : ''}>{depotOgs.map(o => <IsoStage board={DEPOT_BOARD} scene={depotScene({ ...o, scale: 1.3 })} label="" />)}</div>
          : lensOg ? <div class="tf-og"><Flat fig={lensOg} role="img" label="" /></div>
          : page.og === 'pre-training-06-bigger-or-longer' ? <div class="pt-og"><ScalingView budget={10} /></div>
          : callOg ? <div class="vo-og"><CallTimeline segments={callOg.segments} marks={callOg.marks} /></div>
          : fallOg ? <div class="tf-og ob-og"><Waterfall trace={fallOg.trace} stamp={fallOg.stamp} /></div>
          : curveOg ? <div class="tf-og"><Flat fig={curveOg} role="img" label="" /></div>
          : page.og === 'fine-tuning-06-measure-before-you-train' ? <Grid cols={versionCols(VERSION_IDS)} />
          : deskOg ? <IsoStage board={WINDOW_BOARD} scene={windowScene(deskOg)} label="" />
          : agent ? <IsoStage board={OFFICE_BOARD} scene={agent} label="" />
          : tool ? <IsoStage board={OFFICE_BOARD} scene={tool} label="" />
          : page.og === 'tool-calling-05-mcp' ? <IsoStage board={MCP_BOARD} scene={MCP_OG} label="" />
          : page.og === 'tool-calling-07-workbench' ? <IsoStage board={MCP_BOARD} scene={BENCH_OG} label="" />
          : page.og === '01-history' ? <Timeline entries={TIMELINE} visited={4} active={3} onPick={() => {}} pills={1.7} />
          : page.og === '02-why-not-stuff-it' ? <ContextOverflow stop={STOP_5TB} pills={1.7} />
          : CHAPTERS.some(c => (c.og ?? c.id) === page.og) ? <IsoStage board={TRACK_BOARD} scene={staticTrack(unlockedThrough(page.og), { scale: 1.6 })} label="" />
          : <RecallCards label="" />}
      </div>
    </div>
  </body>
</html>

<style>

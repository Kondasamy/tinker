---
// Dev-only eyeball page: the exam hall in several states (static SVG), GRPO rounds on the refund question under the weak
// and the full grader, the policy bars, then the stage live in both tabs. Below 600px the phone versions show.
import '../styles/tokens.css';
import IsoStage from '../lib/iso/IsoStage';
import { EXAM_BOARD, examLabel, examScene, type ExamOpts } from '../components/scenes/examScene';
import { PolicyChart, PostStage, barsOf, cardsOf, groupOf } from '../content/post-training/kit';
import { FULL, WARRANTY, REFUND, TONE, WEAK, refOf, rewardsOf } from '../lib/post-training/graders';
import { BETAS, dpoPolicy, fitRewards, grpoRun, seedOf } from '../lib/post-training/policy';

const weakRun = grpoRun(refOf(REFUND), rewardsOf(REFUND, WEAK), seedOf(REFUND));
const fullRun = grpoRun(refOf(REFUND), rewardsOf(REFUND, FULL), seedOf(REFUND));
const priceRun = grpoRun(refOf(WARRANTY), rewardsOf(WARRANTY, FULL), seedOf(WARRANTY));
const dpo = dpoPolicy(
  refOf(TONE),
  fitRewards(4, [
    [0, 1],
    [1, 2],
    [0, 3],
  ]),
  1,
);
const STATES: [string, ExamOpts][] = [
  ['Refund question, reference policy, no grader', { cards: cardsOf(REFUND, refOf(REFUND)) }],
  ['Tone question after DPO at β 1', { cards: cardsOf(TONE, dpo), grader: 'PEOPLE’S PICKS', board: 'β 1' }],
  [
    'Warranty question, round 1 graded',
    {
      cards: cardsOf(WARRANTY, priceRun[0].after, rewardsOf(WARRANTY, FULL)),
      grader: 'KEY FACT',
      group: groupOf(priceRun[0]),
      board: 'ROUND 1',
    },
  ],
  [
    'Refund, weak grader after 10 rounds',
    {
      cards: cardsOf(REFUND, weakRun.at(-1)!.after, rewardsOf(REFUND, WEAK)),
      grader: 'NUMBER + SIGN-OFF',
      group: groupOf(weakRun.at(-1)),
      board: 'ROUND 10',
      lit: 4,
    },
  ],
  [
    'Refund, full grader after 10 rounds',
    {
      cards: cardsOf(REFUND, fullRun.at(-1)!.after, rewardsOf(REFUND, FULL)),
      grader: 'KEY FACT',
      group: groupOf(fullRun.at(-1)),
      board: 'ROUND 10',
    },
  ],
];
const fmt = (p: number[]) => p.map(x => `${Math.round(x * 100)}%`).join(' ');
const bars = barsOf(REFUND, refOf(REFUND), weakRun.at(-1)!.after, rewardsOf(REFUND, WEAK));
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Post-training scene</title>
  </head>
  <body>
    <main>
      <h1>Post-training exam hall: every state</h1>
      <div class="grid">
        {STATES.map(([title, o]) => (
          <section>
            <h2>{title}</h2>
            <div class="wide"><IsoStage board={EXAM_BOARD} scene={examScene({ ...o, scale: 1.3 })} label={examLabel(o)} /></div>
            <div class="phone"><IsoStage board={EXAM_BOARD} scene={examScene({ ...o, scale: 2.2 })} label={examLabel(o)} /></div>
            <p>{examLabel(o)}</p>
          </section>
        ))}
      </div>
      <h1>GRPO rounds on the refund question</h1>
      <section>
        <h2>Weak grader (number + sign-off)</h2>
        <ol>{weakRun.map(r => <li>{fmt(r.after)} · group rewards {r.rewards.join(',')}</li>)}</ol>
        <h2>Full grader (key fact)</h2>
        <ol>{fullRun.map(r => <li>{fmt(r.after)} · group rewards {r.rewards.join(',')}</li>)}</ol>
        <h2>DPO on the tone question by β</h2>
        <ul>{BETAS.map(b => <li>β {b}: {fmt(dpoPolicy(refOf(TONE), fitRewards(4, [[0, 1], [1, 2], [0, 3]]), b))}</li>)}</ul>
      </section>
      <section>
        <h2>Policy bars: weak grader, before and after</h2>
        <PolicyChart client:load bars={bars} />
      </section>
      <h1>The stage, live</h1>
      <div class="grid">
        <section><h2>Picture</h2><div class="stage"><PostStage client:load shown={{ hall: STATES[3][1], bars, caption: 'Weak grader, ten rounds' }} /></div></section>
        <section><h2>Bars tab</h2><div class="stage"><PostStage client:load view="bars" shown={{ hall: STATES[3][1], bars, caption: '<script>alert(1)</script> escaped caption' }} /></div></section>
      </div>
    </main>
  </body>
</html>
<style>
  main { max-width: 1240px; margin: 0 auto; padding: 24px 16px; display: flex; flex-direction: column; gap: 16px; }
  h1 { font: 800 15px ui-monospace, Menlo, monospace; margin: 16px 0 0; }
  h2 { font: 800 13px ui-monospace, Menlo, monospace; margin: 0; }
  p, li { font-size: 12px; margin: 0; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(360px, 1fr)); gap: 16px; }
  section { display: flex; flex-direction: column; gap: 6px; border: 1px solid var(--rule); border-radius: 10px; padding: 8px; background: var(--paper); }
  .phone { display: none; }
  .stage { display: flex; height: 560px; }
  @media (max-width: 599px) {
    .grid { grid-template-columns: 1fr; }
    .wide { display: none; }
    .phone { display: block; }
  }
</style>

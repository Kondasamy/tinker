---
// Opener-clip source (KTD3): every chapter clip's keyframes, drawn by the site's own scene code, one per line of the
// chapter's `intro.clip`. scripts/clips.mjs reads the JSON this page writes and builds each HyperFrames project from it,
// so a clip never draws anything the stage doesn't. A keyframe list must match its chapter's lines one to one.
import { renderToStaticMarkup } from 'react-dom/server';
import { createElement } from 'react';
import IsoStage from '../lib/iso/IsoStage';
import { staticTrack } from '../components/scenes/staticTrack';
import { TRACK_BOARD } from '../components/canvas/track';
import { MODULES } from '../lib/modules';
import type { BlockType } from '../lib/iso/blocks';
import Timeline from '../components/scenes/Timeline';
import ContextOverflow from '../components/scenes/ContextOverflow';
import { TIMELINE, STOPS, STOP_5TB } from '../lib/scale';

const track = (blocks: BlockType[]) =>
  renderToStaticMarkup(
    createElement(IsoStage, {
      board: TRACK_BOARD,
      scene: staticTrack(blocks, { scale: 1.6 }),
      label: '',
      zoom: { k: 1.06, u: 0.5, v: 0.25 },
    }),
  );
// a scene component's picture: its svg, without the caption around it
const svgOf = (el: ReturnType<typeof createElement>) => /<svg[\s\S]*<\/svg>/.exec(renderToStaticMarkup(el))![0];
const eras = (visited: number) =>
  svgOf(
    createElement(Timeline, {
      entries: TIMELINE,
      visited,
      active: Math.max(0, visited - 1),
      onPick: () => {},
      pills: 1.7,
    }),
  );
const corpus = (stop: number) => svgOf(createElement(ContextOverflow, { stop, pills: 1.7 }));
const RAG3: BlockType[] = ['docs', 'retriever', 'llm'],
  RAG4: BlockType[] = [...RAG3, 'chunker', 'embedder', 'index', 'assembler'],
  RAG5: BlockType[] = [...RAG4, 'rewrite', 'reranker', 'grader'],
  RAG6: BlockType[] = [...RAG5, 'agent', 'graph'];

// every static render gets the same useId prefix; keyframes share one composition, so each gets its own
const own = (svg: string, tag: string) => {
  const prefix = /id="(iso[\w-]*?-)hand"/.exec(svg)?.[1];
  return prefix ? svg.replaceAll(prefix, tag) : svg;
};

// keyframes per `<module>/<chapter>`, one per clip line
const FRAMES: Record<string, () => string[]> = {
  'rag/01-history': () => [eras(0), eras(1), eras(2), eras(3), eras(4)],
  'rag/02-why-not-stuff-it': () => [
    corpus(2),
    corpus(Math.floor((2 + STOP_5TB) / 2)),
    corpus(STOP_5TB),
    corpus(STOPS.length - 1),
  ],
  'rag/03-what-is-rag': () => [track([]), track(['llm']), track(['docs', 'llm']), track(RAG3), track(RAG3)],
  'rag/04-layers': () => [
    track(RAG3),
    track([...RAG3, 'chunker']),
    track([...RAG3, 'chunker', 'embedder']),
    track([...RAG3, 'chunker', 'embedder', 'index']),
    track(RAG4),
  ],
  'rag/05-accuracy': () => [
    track(RAG4),
    track([...RAG4, 'rewrite']),
    track([...RAG4, 'rewrite', 'reranker']),
    track(RAG5),
  ],
  'rag/06-types': () => [track(RAG5), track([...RAG5, 'agent']), track(RAG6), track(RAG6)],
  'rag/07-sandbox': () => [track(RAG6), track(RAG6), track(RAG6)],
};

const clips = MODULES.flatMap(m =>
  m.chapters.flatMap(c => {
    const key = `${m.id}/${c.id}`;
    if (!c.intro.clip) return [];
    const frames = (FRAMES[key]?.() ?? []).map((f, i) => own(f, `c${c.id}-k${i}-`));
    if (frames.length !== c.intro.clip.length)
      throw new Error(`${key}: ${frames.length} keyframes for ${c.intro.clip.length} clip lines`);
    return [{ module: m.id, chapter: c.id, lines: c.intro.clip, frames }];
  }),
);
// JSON in a script element: escape < so no string can close it
const json = JSON.stringify(clips).replace(/</g, '\\u003c');
---
<html lang="en">
  <head><meta charset="utf-8" /><title>Clip keyframes</title></head>
  <body>
    <script type="application/json" id="clips" set:html={json} />
    {clips.map(c => (
      <section>
        <h2>{c.module}/{c.chapter}</h2>
        {c.frames.map((f, i) => (
          <figure>
            <div class="frame" set:html={f} />
            <figcaption>{c.lines[i]}</figcaption>
          </figure>
        ))}
      </section>
    ))}
    <style>
      .frame { width: 640px; }
    </style>
  </body>
</html>

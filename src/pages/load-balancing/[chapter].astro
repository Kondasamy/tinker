---
import ChapterLayout from '../../layouts/ChapterLayout.astro';
import OneServersCeiling from '../../content/load-balancing/01-one-servers-ceiling';
import TakeTurns from '../../content/load-balancing/02-take-turns';
import TheLeastBusy from '../../content/load-balancing/03-the-least-busy';
import IsItAlive from '../../content/load-balancing/04-is-it-alive';
import SameCustomer from '../../content/load-balancing/05-same-customer';
import TheSlowTail from '../../content/load-balancing/06-the-slow-tail';
import RouteTheSale from '../../content/load-balancing/07-route-the-sale';
import { moduleOf } from '../../lib/modules';

export function getStaticPaths() {
  return moduleOf('load-balancing').chapters.map(({ id, title }) => ({ params: { chapter: id }, props: { title } }));
}

const { chapter } = Astro.params;
const { title } = Astro.props;
---
<ChapterLayout module="load-balancing" chapter={chapter} title={title}>
  {/* One line per chapter: hydration needs each island as a static component in the template (KTD2). */}
  {chapter === '01-one-servers-ceiling' ? <OneServersCeiling client:load />
    : chapter === '02-take-turns' ? <TakeTurns client:load />
    : chapter === '03-the-least-busy' ? <TheLeastBusy client:load />
    : chapter === '04-is-it-alive' ? <IsItAlive client:load />
    : chapter === '05-same-customer' ? <SameCustomer client:load />
    : chapter === '06-the-slow-tail' ? <TheSlowTail client:load />
    : <RouteTheSale client:load />}
</ChapterLayout>

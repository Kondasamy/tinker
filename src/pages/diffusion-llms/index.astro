---
// Diffusion LMs module intro: sets the scene before chapter 1. Static, except the warm-up and a small script that marks
// finished chapters. Every example is the module's own data, computed at build time by the same engine the chapters run:
// the toy masked model's fills (its weights read from public/data/diffusion-llms/), Larkspur mini's typing, the
// workbench's best plan, and claims quoted from data/diffusion-llms/facts.json.
import '../../styles/tokens.css';
import '../../styles/page.css';
import Meta from '../../components/Meta.astro';
import IsoStage from '../../lib/iso/IsoStage';
import Recap from '../../components/quiz/Recap';
import ReadingMode from '../../components/intro/ReadingMode.astro';
import ChapterCards from '../../components/intro/ChapterCards.astro';
import { FRAME_BOARD, frameLabel, typeFrameScene, type FrameOpts } from '../../components/scenes/typeFrameScene';
import { L, agreeing, decode, repeating, text, typewriter } from '../../lib/diffusion-llms/decode';
import { diskMini, diskMlm } from '../../lib/diffusion-llms/diskModel';
import { BEST, PHRASES, passesOf, phrase } from '../../lib/diffusion-llms/workbench';
import { START } from '../../content/diffusion-llms/07-workbench';
import { frameOf } from '../../content/diffusion-llms/kit';
import { fact } from '../../lib/diffusion-llms/facts';
import { MODULES, moduleOf, chapterHref } from '../../lib/modules';
import { introMeta } from '../../lib/pages';
import { longDate } from '../../lib/format';

const MODULE = moduleOf('diffusion-llms');
const N = MODULES.filter(m => m.status === 'live').indexOf(MODULE) + 1;
const CHAPTERS = MODULE.chapters;

const mlm = diskMlm();
const scene = (o: FrameOpts) => ({ ...o, scale: 1.2 });

const p6 = phrase(6),
  G = p6.ids.length;
const HERO = scene({ given: G, ...frameOf(decode(mlm, p6.ids, 4, 'confidence', 6), 2) });
// the whole idea: one phrase, one token a pass and all sixteen in one pass
const p1 = phrase(1);
const careful = decode(mlm, p1.ids, 1, 'confidence', 1);
const SIDES = [careful, decode(mlm, p1.ids, L, 'confidence', 1)].map(f => ({
  f,
  passes: f.passes.length,
  agree: agreeing(f.reply, careful.reply),
  repeat: repeating(f.reply),
  pic: scene({ given: p1.ids.length, ...frameOf(f, f.passes.length) }),
}));
const p9 = phrase(9);
type Idea = [string, string, ReturnType<typeof fact> | null, FrameOpts];
const IDEAS: Idea[] = [
  [
    'One word at a time',
    'A left-to-right model takes a pass per token',
    null,
    scene({ given: p9.ids.length, slots: [], typed: 9, typeOf: L }),
  ],
  [
    'Fill the blanks',
    'A masked model guesses every blank at once, reading both sides',
    fact('mdlm'),
    scene({
      given: p9.ids.length,
      slots: decode(mlm, p9.ids, 1, 'confidence', 9).passes[0].guesses.map(g => ({ state: 'mask' as const, ...g! })),
      pass: 1,
      passes: 1,
    }),
  ],
  [
    'Sure words first',
    'Each pass keeps its surest guesses',
    fact('llada-remask'),
    scene({ given: p9.ids.length, ...frameOf(decode(mlm, p9.ids, 4, 'confidence', 9), 1) }),
  ],
  [
    'Faster and worse',
    'More tokens a pass: fewer passes, worse words',
    fact('fast-dllm'),
    scene({ given: p1.ids.length, ...frameOf(decode(mlm, p1.ids, 8, 'confidence', 1), 2) }),
  ],
  [
    'The length is fixed',
    'The frame’s size is set before the first pass',
    fact('llada-length'),
    scene({ given: G, ...frameOf(decode(mlm, p6.ids, 1, 'confidence', 6, 4), 4) }),
  ],
  [
    'Reading a speed claim',
    'Tokens a second = tokens a pass × passes a second',
    fact('mercury-2'),
    scene({ given: G, slots: Array(L).fill({ state: 'mask', tok: 0, p: 0 }), k: 8 }),
  ],
];
const mini = typewriter(diskMini(), p9.ids);
const FACTS: [string, string][] = [
  [String(PHRASES.length), 'pinned phrases every setting is tried on'],
  [String(L), `passes for the careful fill of a ${L}-token reply`],
  [Number(fact('mercury-2').value).toLocaleString('en-US'), 'tokens a second: the vendor’s own claim'],
  [
    String(BEST),
    `passes, the fewest that clear every bar on the workbench; the vendor’s default takes ${passesOf(START)} and fails`,
  ],
];
---
<html lang="en">
  <head>
    <Meta {...introMeta(MODULE.id)} />
  </head>
  <body>
    <div class="topbar">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/"><img src="/favicon.svg" alt="" width="20" height="20" /> Tinker</a> <span aria-hidden="true">/</span> <span aria-current="page">{MODULE.title}</span></nav>
      <p class="by">by <a href={MODULE.author.url} target="_blank" rel="noopener">{MODULE.author.name}</a></p>
    </div>
    <main class="intro">
      <header class="hero">
        <div class="hero-text">
          <p class="kicker">Module {N} · Diffusion LMs</p>
          <p class="module-meta"><span class="level">{MODULE.level}</span></p>
          <h1>How does a model write in any order?</h1>
          <p class="lede">A diffusion language model starts from a reply of blanks and fills the surest first, several a pass. Here you run Larkspur’s toy masked model in a type frame, beside Larkspur mini’s typewriter, and see what fewer passes cost.</p>
          <div class="ctas">
            <a class="btn primary" href={chapterHref(MODULE.id, CHAPTERS[0].id)} data-cta>Start chapter 1 →</a>
            <a class="btn" href="#path">See the chapters</a>
          </div>
          <ReadingMode />
        </div>
        <div class="hero-pic">
          {/* the type frame every chapter plays in: a release-note reply, two passes in */}
          <IsoStage board={FRAME_BOARD} scene={typeFrameScene(HERO)} label={frameLabel(HERO)} />
        </div>
      </header>

      <section class="band" aria-labelledby="idea">
        <p class="kicker">The whole idea in one example</p>
        <h2 id="idea">One phrase, filled in {SIDES[0].passes} passes and in {SIDES[1].passes}</h2>
        <div class="versus">
          {SIDES.map(({ f, passes, agree, repeat, pic }) => (
            <article class:list={['reply', { read: passes > 1 }]}>
              <header><h3>{f.k} token{f.k === 1 ? '' : 's'} a pass</h3><span class="stamp">{passes} pass{passes === 1 ? '' : 'es'}</span></header>
              <IsoStage board={FRAME_BOARD} scene={typeFrameScene(pic)} label={frameLabel(pic)} />
              <p class="line">“{text(p1.ids)}<strong>{text(f.reply)}</strong>”</p>
              <p class="cap">{passes > 1 ? 'The careful fill: one token a pass, surest first.' : `${agree} of ${L} tokens the same as the careful fill; ${repeat} repeats.`}</p>
            </article>
          ))}
        </div>
        <p class="note more">Both run Larkspur’s toy masked model, Larkspur mini’s size, trained once on Larkspur’s documents. It shows the mechanism; its replies are not what a production model writes.</p>
      </section>

      <section aria-labelledby="how">
        <p class="kicker">How it works</p>
        <h2 id="how">Six ideas carry the module</h2>
        <ol class="steps">
          {IDEAS.map(([name, short, f, p], i) => (
            <li>
              <div class="pic"><IsoStage board={FRAME_BOARD} scene={typeFrameScene(p)} label={frameLabel(p)} /></div>
              <h3><span class="n">{i + 1}</span> {name}</h3>
              <p class="cap">{short}</p>
              {i === 0 && <p class="more">Larkspur mini continues “{text(p9.ids)}” with “{text(mini)}”, one token a pass.</p>}
              {f && <p class="more">{f.claim}</p>}
              {f && <p class="src more"><a href={f.source}>Source</a>, checked {longDate(f.accessed)}</p>}
            </li>
          ))}
        </ol>
        <p class="note more">Everything here runs live in your browser: Larkspur mini, the left-to-right baseline, and the toy masked model, which fills the frame a pass at a time.</p>
      </section>

      <section class="company" aria-labelledby="story">
        <div>
          <p class="kicker">The story</p>
          <h2 id="story">A vendor’s speed, read by Larkspur</h2>
          <p class="more">{MODULE.story} <strong>You’re on the team that decides how many tokens a pass each kind of reply can take.</strong></p>
          <p class="prev"><a href="/diffusion/">Diffusion models</a> showed pictures coming out of noise, and <a href="/transformers/">Transformers</a> showed a model writing left to right. Here text comes out of blanks.</p>
        </div>
        <dl class="facts">
          {FACTS.map(([n, what]) => <div><dt>{n}</dt><dd>{what}</dd></div>)}
        </dl>
      </section>

      <section id="path" aria-labelledby="path-h">
        <p class="kicker">Your path</p>
        <h2 id="path-h">The chapters</h2>
        {/* a warm-up shows here only when one is due; the home page's Continue links to #warmup */}
        <div id="warmup"><Recap module={MODULE.id} bank={MODULE.recall ?? []} warmup client:load /></div>
        <ChapterCards module={MODULE.id} chapters={CHAPTERS} />
        <p class="recap-link"><a href={`/${MODULE.id}/recap/`}>Recap: questions from the chapters you’ve finished →</a></p>
      </section>

      <section class="pair">
        <article>
          <h2>Who it’s for</h2>
          <ul class="who-chips"><li>Engineers</li><li>Product managers</li><li>Analysts</li><li>No code needed</li></ul>
          <p class="more">Product managers, engineers and analysts weighing a faster model. <a href="/diffusion/">Diffusion models</a> and <a href="/transformers/">Transformers</a> come first; no code or maths needed.</p>
        </article>
      </section>

      <footer class="credits">
        <p>Part of <a href="/">Tinker</a>, visual explanations of tech concepts by <a href="https://kondasamy.com" target="_blank" rel="noopener">Samy (Kondasamy Jayaraman)</a>.</p>
      </footer>
    </main>

    <script>
      // finished chapters get a tick; the button continues from the first unfinished chapter
      import { moduleOf, chapterHref } from '../../lib/modules';
      import { completed } from '../../lib/progress';
      const CHAPTERS = moduleOf('diffusion-llms').chapters;
      const done = completed('diffusion-llms');
      for (const li of document.querySelectorAll<HTMLElement>('.path [data-chapter]')) {
        if (!done.includes(li.dataset.chapter!)) continue;
        li.classList.add('done');
        li.querySelector<HTMLElement>('.done-mark')!.hidden = false;
      }
      const next = CHAPTERS.findIndex(c => !done.includes(c.id));
      if (done.length && next > 0) for (const a of document.querySelectorAll<HTMLAnchorElement>('[data-cta]')) {
        a.href = chapterHref('diffusion-llms', CHAPTERS[next].id);
        a.textContent = `Continue: chapter ${next + 1} →`;
      }
    </script>
  </body>
</html>

<style>
  .intro { max-width: 1100px; margin: 0 auto; padding: 24px 24px 64px; display: flex; flex-direction: column; gap: 72px; font-size: 15px; line-height: 1.6; }
  .intro h1 { margin: 6px 0 14px; font-size: 36px; line-height: 1.15; letter-spacing: -.01em; }
  .intro h2 { margin: 4px 0 18px; font-size: 24px; line-height: 1.25; }
  .intro h3 { margin: 0; font-size: 16px; }
  .intro p { margin: 0 0 10px; }

  .hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 40px; align-items: center; }
  .lede { font-size: 17px; }
  .intro .module-meta { margin: 8px 0 10px; font-size: 13.5px; color: var(--muted); }
  .module-meta .level { margin-right: 4px; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }

  .band { background: var(--card); border: 1.5px solid var(--ink); border-radius: 20px; padding: 28px 32px; box-shadow: 5px 5px 0 var(--ink); }
  .versus { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 18px; align-items: start; }
  .reply { min-width: 0; border-radius: 14px; padding: 16px 18px; border: 1.5px solid var(--ink); background: var(--paper); }
  .reply header { display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-bottom: 8px; }
  .reply.read { border-left: 6px solid var(--acc); }
  .reply :global(svg) { width: 100%; height: auto; display: block; margin-bottom: 8px; }
  .reply .line { font: 600 13px ui-monospace, Menlo, monospace; white-space: pre-wrap; overflow-wrap: anywhere; }

  .stamp { font-weight: 900; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; border: 2px solid currentColor; border-radius: 6px; padding: 1px 8px; transform: rotate(-3deg); white-space: nowrap; }
  .note { margin: 16px 0 0; font-size: 13px; color: var(--muted); }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .steps li { padding: 18px; border: 1.5px solid var(--rule); border-radius: 16px; display: flex; flex-direction: column; gap: 8px; }
  .steps h3 { display: flex; align-items: center; gap: 10px; font-size: 17px; }
  .steps p { font-size: 14px; margin: 0; }
  .steps .pic { height: 220px; display: flex; justify-content: center; align-items: center; margin-bottom: 4px; }
  .steps .pic :global(svg) { width: auto !important; height: 100% !important; max-width: 100%; }
  .steps .src { margin-top: auto; font-size: 12.5px; color: var(--muted); }

  .company { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 40px; align-items: start; }
  .prev { font-size: 14px; color: var(--muted); }
  .prev a { color: var(--ink); }
  .facts { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin: 0; }
  .facts div { border: 1.5px solid var(--ink); border-radius: 12px; padding: 10px 14px; background: var(--card); }
  .facts dt { font-size: 26px; font-weight: 900; line-height: 1.1; }
  .facts dd { margin: 0; font-size: 13px; color: var(--muted); }

  .recap-link { margin: 16px 0 0; font-weight: 800; }
  #warmup { scroll-margin-top: 16px; }

  .pair { display: grid; gap: 24px; }
  .pair article { border: 1.5px solid var(--rule); border-radius: 16px; padding: 20px 22px; }
  .pair h2 { font-size: 18px; margin-bottom: 10px; }

  @media (max-width: 860px) {
    .intro { padding: 16px 16px 48px; gap: 48px; }
    .intro h1 { font-size: 27px; }
    .hero, .versus, .company, .pair { grid-template-columns: 1fr; }
    .band { padding: 20px 18px; }
    .steps { grid-template-columns: 1fr; }
  }
</style>

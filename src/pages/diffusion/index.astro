---
// Diffusion module intro: sets the scene before chapter 1. Static, except the warm-up and a small script that marks
// finished chapters. Every example is the module's own data, computed at build time by the same engine the chapters run:
// the ideal denoiser's samples, the learned denoiser's dots (its weights read from public/data/diffusion/), the
// workbench's best plan, and claims quoted from data/diffusion/facts.json.
import { readFileSync } from 'node:fs';
import '../../styles/tokens.css';
import '../../styles/page.css';
import Meta from '../../components/Meta.astro';
import IsoStage from '../../lib/iso/IsoStage';
import Recap from '../../components/quiz/Recap';
import ReadingMode from '../../components/intro/ReadingMode.astro';
import ChapterCards from '../../components/intro/ChapterCards.astro';
import { DARK_BOARD, darkroomLabel, darkroomScene, type DarkroomOpts } from '../../components/scenes/darkroomScene';
import { denoiseStrip, frameSteps } from '../../components/scenes/denoiseStrip';
import { filterFor } from '../../lib/iso/core.js';
import { DRAWINGS, drawing, nearest } from '../../lib/diffusion/drawings';
import { sampleDrawing, sampleIdealPoints, trajectory } from '../../lib/diffusion/ideal';
import { noised } from '../../lib/diffusion/schedule';
import { parsePoints, roughness, samplePoints, trainingPoints, type PointsMeta } from '../../lib/diffusion/points';
import { BEST_COST, costOf, WINNERS } from '../../lib/diffusion/workbench';
import { START } from '../../content/diffusion/07-workbench';
import { F } from '../../content/diffusion/06-why-it-costs';
import { fact } from '../../lib/diffusion/facts';
import { MODULES, moduleOf, chapterHref } from '../../lib/modules';
import { introMeta } from '../../lib/pages';
import { longDate } from '../../lib/format';

const MODULE = moduleOf('diffusion');
const N = MODULES.filter(m => m.status === 'live').indexOf(MODULE) + 1;
const CHAPTERS = MODULE.chapters;
const PREREQS = MODULE.prereqs.map(id => moduleOf(id));
const meta = JSON.parse(readFileSync('public/data/diffusion/meta.json', 'utf8')) as PointsMeta;
const bin = readFileSync('public/data/diffusion/points.bin');
const model = parsePoints(meta, bin.buffer.slice(bin.byteOffset, bin.byteOffset + bin.byteLength) as ArrayBuffer);
const train = trainingPoints(meta.outline);

const scene = (o: DarkroomOpts) => ({ ...o, scale: 1.2 });
const SEED = 4;
const HERO = scene({
  print: { kind: 'pixels', px: noised(drawing('hinge-square').pixels, 0.5, 3), name: 'DEVELOPING' },
  steps: 50,
  done: 25,
});
/** A strip as an image (a data URL), for the static page. */
const still = (frames: Parameters<typeof denoiseStrip>[0]) => {
  const s = denoiseStrip(frames);
  return (
    'data:image/svg+xml;charset=utf-8,' +
    encodeURIComponent(
      `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${s.w} ${s.h}"><defs>${filterFor(1, 'hand')}</defs><g filter="url(#hand)">${s.svg}</g></svg>`,
    )
  );
};
const pic = (px: ArrayLike<number>, pill: string) => ({
  print: { kind: 'pixels' as const, px, name: '' },
  pill,
  words: '',
});
const two = (n: number) => n.toFixed(2);
// the whole idea: one seed, developed in 1 step and in 50
const SIDES = [1, 50].map(steps => {
  const t = trajectory(steps, SEED),
    n = nearest(t[steps]);
  return { steps, src: still(frameSteps(steps).map(i => pic(t[i], i === 0 ? 'NOISE' : `STEP ${i}`))), n };
});
const learned = samplePoints(model, 300, 50, 7);
const ideal = sampleIdealPoints(train, 300, 50, 7);
type Idea = [string, string, ReturnType<typeof fact> | null, DarkroomOpts | string];
const IDEAS: Idea[] = [
  ['Noise to picture', 'Start from noise; clean every pixel a little each step', fact('score-sde'), SIDES[1].src],
  [
    'Step by step',
    'Fewer steps cost less and draw rougher',
    fact('ddpm'),
    scene({ print: { kind: 'points', pts: samplePoints(model, 300, 5, 7), name: '5 STEPS' }, steps: 5 }),
  ],
  [
    'A learned denoiser',
    'A network learns which way to move each dot',
    null,
    scene({ print: { kind: 'points', pts: learned, name: 'HINGE' }, steps: 50 }),
  ],
  [
    'Copy or create',
    'The ideal denoiser copies; a network makes new points',
    fact('memorise'),
    scene({ print: { kind: 'points', pts: ideal, train, name: 'COPIES' }, steps: 50 }),
  ],
  [
    'Steer with a label',
    'Guidance pushes toward the part asked for',
    fact('cfg'),
    scene({
      print: { kind: 'pixels', px: sampleDrawing(20, 2, 'drill', 4), name: 'DRILL' },
      steps: 20,
      label: 'drill',
      guidance: 4,
    }),
  ],
  [
    'Why it costs',
    'Steps × positions; latent and few-step models cut each',
    fact('latent'),
    scene({ print: { kind: 'pixels', px: drawing('drill-pistol').pixels, name: 'LATENT' }, steps: 50 }),
  ],
];
const FACTS: [string, string][] = [
  [String(DRAWINGS.length), 'part drawings the toy denoiser knows'],
  [two(roughness(meta.outline, learned)), 'roughness of the learned dots at 50 steps'],
  [`${Number(fact('ddpm').value).toLocaleString('en-US')}`, 'steps a picture in the DDPM paper'],
  [
    `${Math.round(100 * (1 - BEST_COST / costOf(START)))}%`,
    'fewer predictions than “the most of everything” on the workbench',
  ],
];
---
<html lang="en">
  <head>
    <Meta {...introMeta(MODULE.id)} />
  </head>
  <body>
    <div class="topbar">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/"><img src="/favicon.svg" alt="" width="20" height="20" /> Tinker</a> <span aria-hidden="true">/</span> <span aria-current="page">{MODULE.title}</span></nav>
      <p class="by">by <a href={MODULE.author.url} target="_blank" rel="noopener">{MODULE.author.name}</a></p>
    </div>
    <main class="intro">
      <header class="hero">
        <div class="hero-text">
          <p class="kicker">Module {N} · Diffusion</p>
          <p class="module-meta"><span class="level">{MODULE.level}</span> {PREREQS.map((m, i) => <>{i > 0 && ', '}<a href={`/${m.id}/`}>{m.title}</a></>)} recommended · by <a href={MODULE.author.url} target="_blank" rel="noopener">{MODULE.author.name}</a></p>
          <h1>How does a picture come out of noise?</h1>
          <p class="lede">An image model starts from random speckle and removes its best guess of the noise, step by step. Here you develop part drawings in a darkroom, count what each step costs, watch a network learn a shape, and steer it with a label.</p>
          <div class="ctas">
            <a class="btn primary" href={chapterHref(MODULE.id, CHAPTERS[0].id)} data-cta>Start chapter 1 →</a>
            <a class="btn" href="#path">See the chapters</a>
          </div>
          <ReadingMode />
        </div>
        <div class="hero-pic">
          {/* the darkroom every chapter plays in: a hinge halfway out of the noise */}
          <IsoStage board={DARK_BOARD} scene={darkroomScene(HERO)} label={darkroomLabel(HERO)} />
        </div>
      </header>

      <section class="band" aria-labelledby="idea">
        <p class="kicker">The whole idea in one example</p>
        <h2 id="idea">The same noise, developed in 1 step and in 50</h2>
        <div class="versus">
          {SIDES.map(({ steps, src, n }) => (
            <article class:list={['reply', { read: n.rms < 0.05 }]}>
              <header><h3>{steps} step{steps === 1 ? '' : 's'}</h3><span class="stamp">roughness {two(n.rms)}</span></header>
              <img src={src} alt={`The noise developed in ${steps} step${steps === 1 ? '' : 's'}: nearest a ${n.drawing.label}, roughness ${two(n.rms)}`} />
              <p class="cap">{n.rms < 0.05 ? `A clean ${n.drawing.label}.` : 'A blurred average of every drawing.'}</p>
            </article>
          ))}
        </div>
        <p class="note more">Both run the same toy denoiser on Larkspur’s twelve 32 × 32 part drawings. It is a toy that shows the mechanism, not any real model’s numbers.</p>
      </section>

      <section aria-labelledby="how">
        <p class="kicker">How it works</p>
        <h2 id="how">Six ideas carry the module</h2>
        <ol class="steps">
          {IDEAS.map(([name, short, f, p], i) => (
            <li>
              <div class="pic">{typeof p === 'string'
                ? <img src={p} alt={`${name}: a drawing developing from noise, step by step`} />
                : <IsoStage board={DARK_BOARD} scene={darkroomScene(p)} label={darkroomLabel(p)} />}</div>
              <h3><span class="n">{i + 1}</span> {name}</h3>
              <p class="cap">{short}</p>
              {f && <p class="more">{f.claim}</p>}
              {f && <p class="src more"><a href={f.source}>Source</a>, checked {longDate(f.accessed)}</p>}
            </li>
          ))}
        </ol>
        <p class="note more">Everything here runs live in your browser: the noise, an ideal denoiser over the drawings, and a small network trained once on the hinge’s outline. Latent diffusion shrinks the picture {F} times each way in the paper’s best settings.</p>
      </section>

      <section class="company" aria-labelledby="story">
        <div>
          <p class="kicker">The story</p>
          <h2 id="story">Larkspur’s catalogue, drawn by a model</h2>
          <p class="more">{MODULE.story} <strong>You’re on the team that decides how many steps and how much guidance each picture gets.</strong></p>
          <p class="prev"><a href="/multimodal/">Multimodal models</a> showed how pictures go into a model; here they come out. The workbench’s best plan is one of {WINNERS.length} that tie.</p>
        </div>
        <dl class="facts">
          {FACTS.map(([n, what]) => <div><dt>{n}</dt><dd>{what}</dd></div>)}
        </dl>
      </section>

      <section id="path" aria-labelledby="path-h">
        <p class="kicker">Your path</p>
        <h2 id="path-h">The chapters</h2>
        {/* a warm-up shows here only when one is due; the home page's Continue links to #warmup */}
        <div id="warmup"><Recap module={MODULE.id} bank={MODULE.recall ?? []} warmup client:load /></div>
        <ChapterCards module={MODULE.id} chapters={CHAPTERS} />
        <p class="recap-link"><a href={`/${MODULE.id}/recap/`}>Recap: questions from the chapters you’ve finished →</a></p>
      </section>

      <section class="pair">
        <article>
          <h2>Who it’s for</h2>
          <ul class="who-chips"><li>Engineers</li><li>Product managers</li><li>Analysts</li><li>No code needed</li></ul>
          <p class="more">Product managers, engineers and analysts choosing or paying for image generation. <a href="/multimodal/">Multimodal models</a> comes first; no code or maths needed.</p>
        </article>
      </section>

      <footer class="credits">
        <p>Part of <a href="/">Tinker</a>, visual explanations of tech concepts by <a href="https://kondasamy.com" target="_blank" rel="noopener">Samy (Kondasamy Jayaraman)</a>.</p>
        <p>The illustrations are drawn with <a href="https://april-zhu.com/colorfigures">Colorfigures</a> by <a href="https://april-zhu.com/">April Zhu</a>, whose hand-inked isometric style and engine this course is built on. Colorfigures grew from April’s <a href="https://isoglow.dev">ISO-GLOW</a>, which builds on <a href="https://github.com/MrBongoC/ai-iso-skill">iso-figure</a> by Tolga Cohce. All MIT licensed. Thank you.</p>
      </footer>
    </main>

    <script>
      // finished chapters get a tick; the button continues from the first unfinished chapter
      import { moduleOf, chapterHref } from '../../lib/modules';
      import { completed } from '../../lib/progress';
      const CHAPTERS = moduleOf('diffusion').chapters;
      const done = completed('diffusion');
      for (const li of document.querySelectorAll<HTMLElement>('.path [data-chapter]')) {
        if (!done.includes(li.dataset.chapter!)) continue;
        li.classList.add('done');
        li.querySelector<HTMLElement>('.done-mark')!.hidden = false;
      }
      const next = CHAPTERS.findIndex(c => !done.includes(c.id));
      if (done.length && next > 0) for (const a of document.querySelectorAll<HTMLAnchorElement>('[data-cta]')) {
        a.href = chapterHref('diffusion', CHAPTERS[next].id);
        a.textContent = `Continue: chapter ${next + 1} →`;
      }
    </script>
  </body>
</html>

<style>
  .intro { max-width: 1100px; margin: 0 auto; padding: 24px 24px 64px; display: flex; flex-direction: column; gap: 72px; font-size: 15px; line-height: 1.6; }
  .intro h1 { margin: 6px 0 14px; font-size: 36px; line-height: 1.15; letter-spacing: -.01em; }
  .intro h2 { margin: 4px 0 18px; font-size: 24px; line-height: 1.25; }
  .intro h3 { margin: 0; font-size: 16px; }
  .intro p { margin: 0 0 10px; }

  .hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 40px; align-items: center; }
  .lede { font-size: 17px; }
  .intro .module-meta { margin: 8px 0 10px; font-size: 13.5px; color: var(--muted); }
  .module-meta .level { margin-right: 4px; }
  .module-meta a { color: var(--ink); }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }

  .band { background: var(--card); border: 1.5px solid var(--ink); border-radius: 20px; padding: 28px 32px; box-shadow: 5px 5px 0 var(--ink); }
  .versus { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 18px; align-items: start; }
  .reply { min-width: 0; border-radius: 14px; padding: 16px 18px; border: 1.5px solid var(--ink); background: var(--paper); }
  .reply header { display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-bottom: 8px; }
  .reply.read { border-left: 6px solid var(--acc); }
  .reply img { width: 100%; height: auto; display: block; margin-bottom: 8px; }

  .stamp { font-weight: 900; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; border: 2px solid currentColor; border-radius: 6px; padding: 1px 8px; transform: rotate(-3deg); white-space: nowrap; }
  .note { margin: 16px 0 0; font-size: 13px; color: var(--muted); }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .steps li { padding: 18px; border: 1.5px solid var(--rule); border-radius: 16px; display: flex; flex-direction: column; gap: 8px; }
  .steps h3 { display: flex; align-items: center; gap: 10px; font-size: 17px; }
  .steps p { font-size: 14px; margin: 0; }
  .steps .pic { height: 220px; display: flex; justify-content: center; align-items: center; margin-bottom: 4px; }
  .steps .pic :global(svg) { width: auto !important; height: 100% !important; }
  .steps .pic img { width: 100%; height: auto; max-height: 100%; object-fit: contain; }
  .steps .src { margin-top: auto; font-size: 12.5px; color: var(--muted); }

  .company { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 40px; align-items: start; }
  .prev { font-size: 14px; color: var(--muted); }
  .prev a { color: var(--ink); }
  .facts { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin: 0; }
  .facts div { border: 1.5px solid var(--ink); border-radius: 12px; padding: 10px 14px; background: var(--card); }
  .facts dt { font-size: 26px; font-weight: 900; line-height: 1.1; }
  .facts dd { margin: 0; font-size: 13px; color: var(--muted); }

  .recap-link { margin: 16px 0 0; font-weight: 800; }
  #warmup { scroll-margin-top: 16px; }

  .pair { display: grid; gap: 24px; }
  .pair article { border: 1.5px solid var(--rule); border-radius: 16px; padding: 20px 22px; }
  .pair h2 { font-size: 18px; margin-bottom: 10px; }

  @media (max-width: 860px) {
    .intro { padding: 16px 16px 48px; gap: 48px; }
    .intro h1 { font-size: 27px; }
    .hero, .versus, .company, .pair { grid-template-columns: 1fr; }
    .band { padding: 20px 18px; }
    .steps { grid-template-columns: 1fr; }
  }
</style>

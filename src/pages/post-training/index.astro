---
// Post-training module intro: sets the scene before chapter 1. Static, except the warm-up and a small script that marks
// finished chapters. Every example is the module's own data: the written answers graded at build time by Evals'
// key-fact check, the toy policy's updates computed by the same code the chapters run, and claims quoted from
// data/post-training/facts.json.
import '../../styles/tokens.css';
import '../../styles/page.css';
import Meta from '../../components/Meta.astro';
import IsoStage from '../../lib/iso/IsoStage';
import Recap from '../../components/quiz/Recap';
import ReadingMode from '../../components/intro/ReadingMode.astro';
import ChapterCards from '../../components/intro/ChapterCards.astro';
import { EXAM_BOARD, examLabel, examScene, type ExamOpts } from '../../components/scenes/examScene';
import {
  FULL,
  QUESTIONS,
  REFUND,
  TONE,
  WARRANTY,
  WEAK,
  bestOf,
  gamingOf,
  passes,
  question,
  refOf,
  rewardsOf,
  type RuleId,
} from '../../lib/post-training/graders';
import { ROUNDS, dpoPolicy, fitRewards, grpoRun, seedOf } from '../../lib/post-training/policy';
import { RULE_SETS, WINNERS } from '../../lib/post-training/workbench';
import { fact } from '../../lib/post-training/facts';
import { moduleOf, chapterHref } from '../../lib/modules';
import { introMeta } from '../../lib/pages';
import { longDate } from '../../lib/format';

const MODULE = moduleOf('post-training');
const CHAPTERS = MODULE.chapters;

const cards = (q: string, p: number[], rules?: RuleId[]) =>
  question(q).candidates.map((c, i) => ({
    id: c.id,
    p: p[i],
    reward: rules ? rewardsOf(q, rules)[i] : undefined,
    gaming: c.gaming,
  }));
const ran = (q: string, rules: RuleId[]) => grpoRun(refOf(q), rewardsOf(q, rules), seedOf(q), ROUNDS).at(-1)!;
const hall = (q: string, rules: RuleId[], grader: string, lit?: number): ExamOpts => {
  const r = ran(q, rules);
  return {
    cards: cards(q, r.after, rules),
    grader,
    group: r.rewards.map(x => x > 0),
    board: `ROUND ${ROUNDS}`,
    lit,
    scale: 1.3,
  };
};
// the refund question after ten rounds of the key-fact grader
const HERO = hall(REFUND, FULL, 'KEY FACT');
// the whole idea: the base model's continuation and the assistant's answer to the same question
const Q = question(REFUND);
const SIDES = [Q.candidates.findIndex(c => c.base), bestOf(REFUND)].map(i => ({
  c: Q.candidates[i],
  ok: passes('fact', REFUND, Q.candidates[i].text),
}));
const WEAK_AFTER = ran(REFUND, WEAK).after[gamingOf(REFUND)];
const IDEAS: [string, string, ReturnType<typeof fact>, ExamOpts][] = [
  [
    'Base to assistant',
    'Examples teach a base model to answer',
    fact('instructgpt'),
    { cards: cards(REFUND, refOf(REFUND)), lit: 0, scale: 1.3 },
  ],
  [
    'Which is better?',
    'People pick the better of two drafts',
    fact('instructgpt-small'),
    { cards: cards(TONE, refOf(TONE)), grader: 'YOUR PICKS', scale: 1.3 },
  ],
  [
    'Learn the picks',
    'DPO leans toward them, held near the reference',
    fact('dpo-beta'),
    {
      cards: cards(
        TONE,
        dpoPolicy(
          refOf(TONE),
          fitRewards(4, [
            [0, 1],
            [1, 2],
            [0, 3],
          ]),
          1,
        ),
      ),
      grader: 'YOUR PICKS',
      board: 'β 1',
      scale: 1.3,
    },
  ],
  [
    'Grade, don’t judge',
    'A program checks each draft against its group',
    fact('grpo'),
    hall(WARRANTY, FULL, 'KEY FACT'),
  ],
  ['Only what you check', 'Equal rewards move nothing', fact('rlvr'), hall(TONE, FULL, 'KEY FACT')],
  [
    'You get what you check',
    'A weak grader trains the gaming answer',
    fact('spec-gaming'),
    hall(REFUND, WEAK, 'NUMBER + SIGN-OFF', gamingOf(REFUND)),
  ],
];
const FACTS: [string, string][] = [
  [
    String(QUESTIONS.reduce((n, q) => n + q.candidates.length, 0)),
    'answers written for this site, across five customer questions',
  ],
  [`${Math.round(WEAK_AFTER * 100)}%`, `the gaming answer’s share after ${ROUNDS} rounds of the weak grader`],
  [`${WINNERS.length} of ${RULE_SETS.length}`, 'rule sets in the workbench that reward only right answers'],
  [String(ROUNDS), 'rounds of the toy policy’s training per run, computed in your browser'],
];
---
<html lang="en">
  <head>
    <Meta {...introMeta(MODULE.id)} />
  </head>
  <body>
    <div class="topbar">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/"><img src="/favicon.svg" alt="" width="20" height="20" /> Tinker</a> <span aria-hidden="true">/</span> <span aria-current="page">{MODULE.title}</span></nav>
      <p class="by">by <a href={MODULE.author.url} target="_blank" rel="noopener">{MODULE.author.name}</a></p>
    </div>
    <main class="intro">
      <header class="hero">
        <div class="hero-text">
          <p class="kicker">Module 19 · Post-training</p>
          <p class="module-meta"><span class="level">{MODULE.level}</span></p>
          <h1>How does a base model become an assistant?</h1>
          <p class="lede">After pre-training comes post-training. Here you pick the better of two drafts, train a toy policy on your picks, let a grader mark its drafts, and write a grader it can’t game.</p>
          <div class="ctas">
            <a class="btn primary" href={chapterHref(MODULE.id, CHAPTERS[0].id)} data-cta>Start chapter 1 →</a>
            <a class="btn" href="#path">See the chapters</a>
          </div>
          <ReadingMode />
        </div>
        <div class="hero-pic">
          {/* the exam hall every chapter plays in: the refund question after ten rounds of the key-fact grader */}
          <IsoStage board={EXAM_BOARD} scene={examScene(HERO)} label={examLabel(HERO)} />
        </div>
      </header>

      <section class="band" aria-labelledby="idea">
        <p class="kicker">The whole idea in one example</p>
        <h2 id="idea">The same question, continued and answered</h2>
        <div class="versus">
          {SIDES.map(({ c, ok }, i) => (
            <article class:list={['reply', { read: ok }]}>
              <header><h3>{i === 0 ? 'Base model' : 'Assistant'} <span class="tag">written for this site</span></h3><span class="stamp">{ok ? 'right' : 'no answer'}</span></header>
              <p class="asked">“{Q.query}”</p>
              <p class="said">{c.text}</p>
              <p class="cap">{c.note}</p>
            </article>
          ))}
        </div>
        <p class="note more">Both answers were written for this site; the marks come from the Evals module’s key-fact check, run at build time. The module’s toy policy is a choice among written answers, not a language model: its updates run live and teach the mechanism, not any provider’s numbers.</p>
      </section>

      <section aria-labelledby="how">
        <p class="kicker">How it works</p>
        <h2 id="how">Six ideas carry the module</h2>
        <ol class="steps">
          {IDEAS.map(([name, short, f, pic], i) => (
            <li>
              <div class="pic"><IsoStage board={EXAM_BOARD} scene={examScene(pic)} label={examLabel(pic)} /></div>
              <h3><span class="n">{i + 1}</span> {name}</h3>
              <p class="cap">{short}</p>
              <p class="more">{f.claim}</p>
              <p class="src more"><a href={f.source}>Source</a>, checked {longDate(f.accessed)}</p>
            </li>
          ))}
        </ol>
        <p class="note more">Each stack of cards is one written answer, as tall as the toy policy’s odds of giving it. The training runs in your browser with fixed seeds, so every visit shows the same rounds.</p>
      </section>

      <section class="company" aria-labelledby="story">
        <div>
          <p class="kicker">The story</p>
          <h2 id="story">Larkspur shapes its own assistant</h2>
          <p class="more">{MODULE.story} <strong>You’re on the team that chooses what the model learns from, and checks that it learns the right thing.</strong></p>
          <p class="prev"><a href="/fine-tuning/">Fine-tuning</a> trained Larkspur mini on examples; <a href="/evals/">Evals</a> built the key-fact check every grader here uses.</p>
        </div>
        <dl class="facts">
          {FACTS.map(([n, what]) => <div><dt>{n}</dt><dd>{what}</dd></div>)}
        </dl>
      </section>

      <section id="path" aria-labelledby="path-h">
        <p class="kicker">Your path</p>
        <h2 id="path-h">The chapters</h2>
        {/* a warm-up shows here only when one is due (R13); the home page's Continue links to #warmup */}
        <div id="warmup"><Recap module={MODULE.id} bank={MODULE.recall ?? []} warmup client:load /></div>
        <ChapterCards module={MODULE.id} chapters={CHAPTERS} />
        <p class="recap-link"><a href={`/${MODULE.id}/recap/`}>Recap: questions from the chapters you’ve finished →</a></p>
      </section>

      <section class="pair">
        <article>
          <h2>Who it’s for</h2>
          <ul class="who-chips"><li>Engineers</li><li>Product managers</li><li>Analysts</li><li>No code needed</li></ul>
          <p class="more">Product managers, engineers and analysts who read “trained with RL” in a launch post and want to know what it means. <a href="/fine-tuning/">Fine-tuning</a> and <a href="/evals/">Evals</a> come first; no code or maths needed.</p>
        </article>
      </section>

      <footer class="credits">
        <p>Part of <a href="/">Tinker</a>, visual explanations of tech concepts by <a href="https://kondasamy.com" target="_blank" rel="noopener">Samy (Kondasamy Jayaraman)</a>.</p>
      </footer>
    </main>

    <script>
      // finished chapters get a tick; the button continues from the first unfinished chapter
      import { moduleOf, chapterHref } from '../../lib/modules';
      import { completed } from '../../lib/progress';
      const CHAPTERS = moduleOf('post-training').chapters;
      const done = completed('post-training');
      for (const li of document.querySelectorAll<HTMLElement>('.path [data-chapter]')) {
        if (!done.includes(li.dataset.chapter!)) continue;
        li.classList.add('done');
        li.querySelector<HTMLElement>('.done-mark')!.hidden = false;
      }
      const next = CHAPTERS.findIndex(c => !done.includes(c.id));
      if (done.length && next > 0) for (const a of document.querySelectorAll<HTMLAnchorElement>('[data-cta]')) {
        a.href = chapterHref('post-training', CHAPTERS[next].id);
        a.textContent = `Continue: chapter ${next + 1} →`;
      }
    </script>
  </body>
</html>

<style>
  .intro { max-width: 1100px; margin: 0 auto; padding: 24px 24px 64px; display: flex; flex-direction: column; gap: 72px; font-size: 15px; line-height: 1.6; }
  .intro h1 { margin: 6px 0 14px; font-size: 36px; line-height: 1.15; letter-spacing: -.01em; }
  .intro h2 { margin: 4px 0 18px; font-size: 24px; line-height: 1.25; }
  .intro h3 { margin: 0; font-size: 16px; }
  .intro p { margin: 0 0 10px; }

  .hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 40px; align-items: center; }
  .lede { font-size: 17px; }
  .intro .module-meta { margin: 8px 0 10px; font-size: 13.5px; color: var(--muted); }
  .module-meta .level { margin-right: 4px; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }

  .band { background: var(--card); border: 1.5px solid var(--ink); border-radius: 20px; padding: 28px 32px; box-shadow: 5px 5px 0 var(--ink); }
  .versus { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 18px; align-items: start; }
  .reply { min-width: 0; border-radius: 14px; padding: 16px 18px; border: 1.5px solid var(--ink); background: var(--paper); }
  .reply header { display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-bottom: 8px; }
  .reply.read { border-left: 6px solid var(--acc); }
  .said { font-size: 17px; font-weight: 700; overflow-wrap: anywhere; }

  .stamp { font-weight: 900; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; border: 2px solid currentColor; border-radius: 6px; padding: 1px 8px; transform: rotate(-3deg); white-space: nowrap; }
  .tag { margin-left: 6px; padding: 0 6px; border: 1px solid var(--rule); border-radius: 999px; font: 700 11px ui-monospace, Menlo, monospace; color: var(--muted); white-space: nowrap; }
  .asked { font-size: 14px; color: var(--muted); }
  .note { margin: 16px 0 0; font-size: 13px; color: var(--muted); }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .steps li { padding: 18px; border: 1.5px solid var(--rule); border-radius: 16px; display: flex; flex-direction: column; gap: 8px; }
  .steps h3 { display: flex; align-items: center; gap: 10px; font-size: 17px; }
  .steps p { font-size: 14px; margin: 0; }
  .steps .pic { height: 220px; display: flex; justify-content: center; margin-bottom: 4px; }
  .steps .pic :global(svg) { width: auto !important; height: 100% !important; }
  .steps .src { margin-top: auto; font-size: 12.5px; color: var(--muted); }

  .company { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 40px; align-items: start; }
  .prev { font-size: 14px; color: var(--muted); }
  .prev a { color: var(--ink); }
  .facts { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin: 0; }
  .facts div { border: 1.5px solid var(--ink); border-radius: 12px; padding: 10px 14px; background: var(--card); }
  .facts dt { font-size: 26px; font-weight: 900; line-height: 1.1; }
  .facts dd { margin: 0; font-size: 13px; color: var(--muted); }

  .recap-link { margin: 16px 0 0; font-weight: 800; }
  #warmup { scroll-margin-top: 16px; }

  .pair { display: grid; gap: 24px; }
  .pair article { border: 1.5px solid var(--rule); border-radius: 16px; padding: 20px 22px; }
  .pair h2 { font-size: 18px; margin-bottom: 10px; }

  @media (max-width: 860px) {
    .intro { padding: 16px 16px 48px; gap: 48px; }
    .intro h1 { font-size: 27px; }
    .hero, .versus, .company, .pair { grid-template-columns: 1fr; }
    .band { padding: 20px 18px; }
    .steps { grid-template-columns: 1fr; }
  }
</style>

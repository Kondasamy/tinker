---
// Agent sandboxing module intro: sets the scene before chapter 1. Static, except the warm-up and a small script that
// marks finished chapters. Every example is the course's own data: the exfiltration attack run through the sandbox loop
// at build time, the two suites scored with no sandbox and under a clean policy, and claims about sandboxing quoted
// from data/sandboxing/facts.json.
import '../../styles/tokens.css';
import '../../styles/page.css';
import Meta from '../../components/Meta.astro';
import IsoStage from '../../lib/iso/IsoStage';
import Recap from '../../components/quiz/Recap';
import ReadingMode from '../../components/intro/ReadingMode.astro';
import ChapterCards from '../../components/intro/ChapterCards.astro';
import { SANDBOX_BOARD, sandboxLabel, sandboxScene, type SandboxOpts } from '../../components/scenes/sandboxScene';
import { ATTACKS, TASKS, metrics, run } from '../../lib/sandboxing/loop';
import { RECORDING } from '../../lib/sandboxing/turns';
import { fact } from '../../lib/sandboxing/facts';
import { SOLUTION, bench } from '../../content/sandboxing/07-red-team';
import { MODULES, moduleOf, chapterHref } from '../../lib/modules';
import { introMeta } from '../../lib/pages';
import { longDate } from '../../lib/format';

const MODULE = moduleOf('sandboxing');
const CHAPTERS = MODULE.chapters;
const NUM = MODULES.findIndex(m => m.id === MODULE.id) + 1;
const PREREQS = MODULE.prereqs.map(id => moduleOf(id));

// the exfiltration attack on the host, at the moment the token leaves
const HOST_LEAK = run(RECORDING, { case: 'exfil', sandbox: false });
const fetchAt = (r: typeof HOST_LEAK) => r.steps.findIndex(s => s.kind === 'call' && s.call.name === 'fetch') + 1;
const HERO: SandboxOpts = { run: HOST_LEAK, upTo: fetchAt(HOST_LEAK), wall: false, egress: 'open', scale: 1.7 };
const SAYS = ATTACKS.find(a => a.case === 'exfil')!.says;

// the sandboxed version, refused; and the three ideas
const SAFE = run(RECORDING, { case: 'exfil', sandbox: true, files: 'scoped', egress: 'allowlist', secret: 'proxy' });
const NET_BLOCK = run(RECORDING, { case: 'exfil', sandbox: true, files: 'scoped', egress: 'allowlist', secret: 'env' });
const BEACON = run(RECORDING, { case: 'beacon', sandbox: true, files: 'scoped', egress: 'allowlist', secret: 'proxy' });
const blockedAt = (r: typeof SAFE) => r.steps.findIndex(s => s.kind === 'blocked') + 1;
const IDEAS: [string, string, ReturnType<typeof fact>, SandboxOpts][] = [
  [
    'Where the code runs',
    'The same task, held inside a box the OS enforces',
    fact('filesystem-isolation'),
    { run: SAFE, upTo: SAFE.steps.length, wall: true, files: 'scoped', egress: 'allowlist', proxy: true, scale: 1.7 },
  ],
  [
    'Two walls: files and network',
    'What it can read and write, and where it can reach',
    fact('network-isolation'),
    {
      run: NET_BLOCK,
      upTo: blockedAt(NET_BLOCK),
      wall: true,
      files: 'scoped',
      egress: 'allowlist',
      proxy: false,
      scale: 1.7,
    },
  ],
  [
    'An allowed door still leaks',
    'A request to an allowed host can carry data out',
    fact('allowed-domain-leak'),
    { run: BEACON, upTo: fetchAt(BEACON), wall: true, files: 'scoped', egress: 'allowlist', proxy: true, scale: 1.7 },
  ],
];

// the two suites with no sandbox and under a clean policy
const NONE = metrics({ sandbox: false }),
  CLEAN = bench(SOLUTION);
const FACTS: [string, string][] = [
  [String(ATTACKS.length), 'attacks in the suite'],
  [String(TASKS.length), 'ordinary tasks in it too'],
  [`${NONE.succeeded} of ${NONE.attacks}`, 'attacks that work with no sandbox'],
  [
    `${CLEAN.succeeded} of ${CLEAN.attacks}`,
    `once the policy is set, with ${CLEAN.blocked} of ${CLEAN.tasks} tasks blocked`,
  ],
];
---
<html lang="en">
  <head>
    <Meta {...introMeta(MODULE.id)} />
  </head>
  <body>
    <div class="topbar">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/"><img src="/favicon.svg" alt="" width="20" height="20" /> Tinker</a> <span aria-hidden="true">/</span> <span aria-current="page">{MODULE.title}</span></nav>
      <p class="by">by <a href={MODULE.author.url} target="_blank" rel="noopener">{MODULE.author.name}</a></p>
    </div>
    <main class="intro">
      <header class="hero">
        <div class="hero-text">
          <p class="kicker">Module {NUM} · Agent sandboxing</p>
          <p class="module-meta"><span class="level">{MODULE.level}</span> {PREREQS.map((m, i) => <>{i > 0 && ', '}<a href={`/${m.id}/`}>{m.title}</a></>)} recommended · by <a href={MODULE.author.url} target="_blank" rel="noopener">{MODULE.author.name}</a></p>
          <h1>Where an agent’s code runs, and what it can reach</h1>
          <p class="lede">When an agent runs code to do its work, a planted instruction can make that code read your files or send your data away. A sandbox is a box the operating system holds the code inside: it decides which files the agent sees and which hosts it can reach, from outside the model, so it holds even when the agent is taken over.</p>
          <div class="ctas">
            <a class="btn primary" href={chapterHref(MODULE.id, CHAPTERS[0].id)} data-cta>Start chapter 1 →</a>
            <a class="btn" href="#path">See the chapters</a>
          </div>
          <ReadingMode />
        </div>
        <div class="hero-pic">
          <IsoStage board={SANDBOX_BOARD} scene={sandboxScene(HERO)} label={sandboxLabel(HERO)} />
        </div>
      </header>

      <section class="band" aria-labelledby="idea">
        <p class="kicker">The whole idea in one example</p>
        <h2 id="idea">A planted note made the agent send a secret away</h2>
        <div class="versus">
          <article class="reply">
            <header><h3>On the host</h3><span class="stamp warn">Full access</span></header>
            <p class="cap">The agent runs with the developer’s own access. A note in its task tells it to read the API token and send it to an outside address.</p>
            <p class="mail more">{SAYS}.</p>
          </article>
          <article class="reply bad">
            <header><h3>What left the machine</h3><span class="stamp">Leaked</span></header>
            <p class="who">fetch to attacker.example</p>
            <p class="cap">The token went out. On the host there was nothing to stop it.</p>
          </article>
        </div>
        <p class="note more">In a sandbox the same note changes nothing: the token is kept with the proxy, the outside host is not on the allow-list, and the moves are refused. The agent’s turns are recorded, written to illustrate the sources below; the sandbox is a model (no real code runs), and its checks and the outcome are computed in your browser.</p>
      </section>

      <section aria-labelledby="how">
        <p class="kicker">How it works</p>
        <h2 id="how">Three ideas carry the module</h2>
        <ol class="steps">
          {IDEAS.map(([name, short, f, o], i) => (
            <li>
              <div class="pic"><IsoStage board={SANDBOX_BOARD} scene={sandboxScene(o)} label={sandboxLabel(o)} /></div>
              <h3><span class="n">{i + 1}</span> {name}</h3>
              <p class="cap">{short}</p>
              <p class="more">{f.claim}</p>
              <p class="src more"><a href={f.source}>Source</a>, checked {longDate(f.accessed)}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="company" aria-labelledby="story">
        <div>
          <p class="kicker">The story</p>
          <h2 id="story">Larkspur’s agent runs code now</h2>
          <p class="more">{MODULE.story} <strong>You’re on the team that decides which sandbox policy it runs with.</strong></p>
          {PREREQS.map(m => <p class="prev">New to Larkspur’s agent, or to prompt injection? The <a href={`/${m.id}/`}>{m.title} module</a> builds what this one defends.</p>)}
        </div>
        <dl class="facts">
          {FACTS.map(([n, what]) => <div><dt>{n}</dt><dd>{what}</dd></div>)}
        </dl>
      </section>

      <section id="path" aria-labelledby="path-h">
        <p class="kicker">Your path</p>
        <h2 id="path-h">The chapters</h2>
        <div id="warmup"><Recap module={MODULE.id} bank={MODULE.recall ?? []} warmup client:load /></div>
        <ChapterCards module={MODULE.id} chapters={CHAPTERS} />
        <p class="recap-link"><a href={`/${MODULE.id}/recap/`}>Recap: questions from the chapters you’ve finished →</a></p>
      </section>

      <section class="pair">
        <article>
          <h2>Who it’s for</h2>
          <ul class="who-chips"><li>Product managers</li><li>Engineers</li><li>Analysts</li><li>No code needed</li></ul>
          <p class="more">Product managers, engineers and analysts whose AI agent runs code or tools that can touch files and the network. No code needed. Play AI agents and Guardrails first if agents and prompt injection are new to you.</p>
        </article>
      </section>

      <footer class="credits">
        <p>Part of <a href="/">Tinker</a>, visual explanations of tech concepts by <a href="https://kondasamy.com" target="_blank" rel="noopener">Samy (Kondasamy Jayaraman)</a>.</p>
      </footer>
    </main>

    <script>
      import { moduleOf, chapterHref } from '../../lib/modules';
      import { completed } from '../../lib/progress';
      const CHAPTERS = moduleOf('sandboxing').chapters;
      const done = completed('sandboxing');
      for (const li of document.querySelectorAll<HTMLElement>('.path [data-chapter]')) {
        if (!done.includes(li.dataset.chapter!)) continue;
        li.classList.add('done');
        li.querySelector<HTMLElement>('.done-mark')!.hidden = false;
      }
      const next = CHAPTERS.findIndex(c => !done.includes(c.id));
      if (done.length && next > 0) for (const a of document.querySelectorAll<HTMLAnchorElement>('[data-cta]')) {
        a.href = chapterHref('sandboxing', CHAPTERS[next].id);
        a.textContent = `Continue: chapter ${next + 1} →`;
      }
    </script>
  </body>
</html>

<style>
  .intro { max-width: 1100px; margin: 0 auto; padding: 24px 24px 64px; display: flex; flex-direction: column; gap: 72px; font-size: 15px; line-height: 1.6; }
  .intro h1 { margin: 6px 0 14px; font-size: 36px; line-height: 1.15; letter-spacing: -.01em; }
  .intro h2 { margin: 4px 0 18px; font-size: 24px; line-height: 1.25; }
  .intro h3 { margin: 0; font-size: 16px; }
  .intro p { margin: 0 0 10px; }

  .hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 40px; align-items: center; }
  .lede { font-size: 17px; }
  .intro .module-meta { margin: 8px 0 10px; font-size: 13.5px; color: var(--muted); }
  .module-meta .level { margin-right: 4px; }
  .module-meta a { color: var(--ink); }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }

  .band { background: var(--card); border: 1.5px solid var(--ink); border-radius: 20px; padding: 28px 32px; box-shadow: 5px 5px 0 var(--ink); }
  .versus { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 18px; align-items: start; }
  .reply { min-width: 0; border-radius: 14px; padding: 16px 18px; border: 1.5px solid var(--ink); background: var(--paper); }
  .reply header { display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-bottom: 8px; }
  .reply.bad { border-left: 6px solid var(--bad); }

  .stamp { font-weight: 900; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; border: 2px solid currentColor; border-radius: 6px; padding: 1px 8px; transform: rotate(-3deg); white-space: nowrap; }
  .bad .stamp { color: var(--bad); }
  .note { margin: 16px 0 0; font-size: 13px; color: var(--muted); }
  .reply .who { font-size: 12px; letter-spacing: .06em; color: var(--muted); font-weight: 700; overflow-wrap: anywhere; margin-bottom: 6px; }
  .mail { white-space: pre-wrap; font-size: 13.5px; border-left: 4px solid var(--rule); padding: 4px 0 4px 12px; overflow-wrap: anywhere; }
  .bad .mail { border-left-color: var(--bad); }
  .stamp.warn { color: var(--warn); }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .steps li { padding: 18px; border: 1.5px solid var(--rule); border-radius: 16px; display: flex; flex-direction: column; gap: 8px; }
  .steps h3 { display: flex; align-items: center; gap: 10px; font-size: 17px; }
  .steps p { font-size: 14px; margin: 0; }
  .steps .pic { height: 140px; display: flex; justify-content: center; margin-bottom: 4px; }
  .steps .pic :global(svg) { width: auto !important; height: 100% !important; }
  .steps .src { margin-top: auto; font-size: 12.5px; color: var(--muted); }

  .company { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 40px; align-items: start; }
  .prev { font-size: 14px; color: var(--muted); }
  .prev a { color: var(--ink); }
  .facts { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin: 0; }
  .facts div { border: 1.5px solid var(--ink); border-radius: 12px; padding: 10px 14px; background: var(--card); }
  .facts dt { font-size: 26px; font-weight: 900; line-height: 1.1; }
  .facts dd { margin: 0; font-size: 13px; color: var(--muted); }

  .recap-link { margin: 16px 0 0; font-weight: 800; }
  #warmup { scroll-margin-top: 16px; }

  .pair { display: grid; gap: 24px; }
  .pair article { border: 1.5px solid var(--rule); border-radius: 16px; padding: 20px 22px; }
  .pair h2 { font-size: 18px; margin-bottom: 10px; }

  @media (max-width: 860px) {
    .intro { padding: 16px 16px 48px; gap: 48px; }
    .intro h1 { font-size: 27px; }
    .hero, .versus, .company, .pair { grid-template-columns: 1fr; }
    .band { padding: 20px 18px; }
    .steps { grid-template-columns: 1fr; }
  }
</style>

---
import ChapterLayout from '../../layouts/ChapterLayout.astro';
import ItOnlyContinues from '../../content/prompts/01-it-only-continues';
import SayWhatYouWant from '../../content/prompts/02-say-what-you-want';
import ShowDontTell from '../../content/prompts/03-show-dont-tell';
import PutItInAShape from '../../content/prompts/04-put-it-in-a-shape';
import OrderAndEmphasis from '../../content/prompts/05-order-and-emphasis';
import TestItLikeCode from '../../content/prompts/06-test-it-like-code';
import Workbench from '../../content/prompts/07-workbench';
import { moduleOf } from '../../lib/modules';

export function getStaticPaths() {
  return moduleOf('prompts').chapters.map(({ id, title }) => ({
    params: { chapter: id },
    props: { title },
  }));
}

const { chapter } = Astro.params;
const { title } = Astro.props;
---
<ChapterLayout module="prompts" chapter={chapter} title={title}>
  {/* One line per chapter: hydration needs each island as a static component in the template (KTD2). */}
  {chapter === '01-it-only-continues' ? <ItOnlyContinues client:load />
    : chapter === '02-say-what-you-want' ? <SayWhatYouWant client:load />
    : chapter === '03-show-dont-tell' ? <ShowDontTell client:load />
    : chapter === '04-put-it-in-a-shape' ? <PutItInAShape client:load />
    : chapter === '05-order-and-emphasis' ? <OrderAndEmphasis client:load />
    : chapter === '06-test-it-like-code' ? <TestItLikeCode client:load />
    : <Workbench client:load />}
</ChapterLayout>

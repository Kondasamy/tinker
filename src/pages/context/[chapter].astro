---
import ChapterLayout from '../../layouts/ChapterLayout.astro';
import WhatsInTheWindow from '../../content/context/01-whats-in-the-window';
import MoreIsntBetter from '../../content/context/02-more-isnt-better';
import FetchWhenNeeded from '../../content/context/03-fetch-when-needed';
import OrderForTheCache from '../../content/context/04-order-for-the-cache';
import ClearingTheDesk from '../../content/context/05-clearing-the-desk';
import MemoryOutsideTheWindow from '../../content/context/06-memory';
import Workbench from '../../content/context/07-workbench';
import { moduleOf } from '../../lib/modules';

export function getStaticPaths() {
  return moduleOf('context').chapters.map(({ id, title }) => ({ params: { chapter: id }, props: { title } }));
}

const { chapter } = Astro.params;
const { title } = Astro.props;
---
<ChapterLayout module="context" chapter={chapter} title={title}>
  {/* One line per chapter, as `chapter === '02-…' ? <Next client:load />`, last one without a test. Not a lookup table:
      hydration needs each island as a static component in the template, so Astro can bundle it (KTD2). */}
  {chapter === '01-whats-in-the-window' ? <WhatsInTheWindow client:load />
    : chapter === '02-more-isnt-better' ? <MoreIsntBetter client:load />
    : chapter === '03-fetch-when-needed' ? <FetchWhenNeeded client:load />
    : chapter === '04-order-for-the-cache' ? <OrderForTheCache client:load />
    : chapter === '05-clearing-the-desk' ? <ClearingTheDesk client:load />
    : chapter === '06-memory' ? <MemoryOutsideTheWindow client:load />
    : <Workbench client:load />}
</ChapterLayout>

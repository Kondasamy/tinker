---
// Robots that act module intro: sets the scene before chapter 1. Static, except the warm-up and a small script that
// marks finished chapters. Every example is the module's own data: the parts bay drawn from the simulated grid world
// (world.ts) and Mira's pinned demos, the numbers from pinned.json and facts.json.
import '../../styles/tokens.css';
import '../../styles/page.css';
import Meta from '../../components/Meta.astro';
import IsoStage from '../../lib/iso/IsoStage';
import Recap from '../../components/quiz/Recap';
import ReadingMode from '../../components/intro/ReadingMode.astro';
import ChapterCards from '../../components/intro/ChapterCards.astro';
import { CLAW_BOARD, clawLabel, clawScene, type ClawOpts } from '../../components/scenes/clawScene';
import pinned from '../../../data/robots/pinned.json' with { type: 'json' };
import { fact } from '../../lib/robots/facts';
import { replay } from '../../lib/robots/policy';
import { NEW_BIN, runRule } from '../../lib/robots/rules';
import { DEMOS, demoPairs, PERSON, SNOWBALL } from '../../lib/robots/story';
import { HELD_OUT, play, REAL, startOf, TRAIN } from '../../lib/robots/world';
import { moduleOf, chapterHref, moduleNumber } from '../../lib/modules';
import { introMeta } from '../../lib/pages';
import { longDate } from '../../lib/format';

const MODULE = moduleOf('robots');
const NUMBER = moduleNumber(MODULE);
const CHAPTERS = MODULE.chapters;
const N = HELD_OUT.length;

const demo = play(TRAIN[0], DEMOS[0]);
const at = (k: number): ClawOpts => ({
  layout: TRAIN[0],
  state: demo[k],
  trail: demo.slice(0, k + 1).map(s => s.claw),
  scale: 1.4,
});
const HERO = at(demo.length - 1);
const rule = runRule(NEW_BIN);
const stall = replay(demoPairs(SNOWBALL.demos), SNOWBALL.layout, { forced: [SNOWBALL.slipAt] });
const FOUR = pinned.clean.find(c => c.demos === 4)!;
const BOTH = pinned.practice.find(p => p.practice === 'both')!,
  PLAIN = pinned.practice.find(p => p.practice === 'plain')!;
const IDEAS: [string, string, ReturnType<typeof fact> | null, ClawOpts][] = [
  ['See, decide, move', 'A look, one small move, again: many times a second', fact('rt1-loop'), at(4)],
  [
    'Rules break',
    'A written list of moves fails on the next layout',
    fact('hand-designed-grasp'),
    {
      layout: NEW_BIN,
      state: rule.states.at(-1)!,
      trail: rule.states.map(s => s.claw),
      pill: 'OFF GRID',
      machine: 'bad',
      scale: 1.4,
    },
  ],
  [
    'Mistakes snowball',
    'One slip lands where no demo went; corrections fix it',
    fact('dagger'),
    {
      layout: SNOWBALL.layout,
      state: stall.states.at(-1)!,
      trail: stall.states.map(s => s.claw),
      pill: 'STUCK',
      machine: 'warn',
      scale: 1.4,
    },
  ],
  [
    'Practice in a game',
    'Vary the simulator, and the real bay looks familiar',
    fact('domain-randomisation'),
    { layout: REAL[0], state: startOf(REAL[0]), scale: 1.4 },
  ],
];
const FACTS: [string, string][] = [
  [`${fact('rt1-loop').value} a second`, 'how often Google’s RT-1 looks and acts'],
  [`${FOUR.solved} of ${N}`, `fresh bins cleared from ${PERSON}’s 4 demos, simulated`],
  [`${PLAIN.solved} → ${BOTH.solved}`, `of ${N} real bins, simulated, once practice varies light and slips`],
  [`${fact('aloha-loop').value} a second`, 'how often the ALOHA arms set their joints'],
];
---
<html lang="en">
  <head>
    <Meta {...introMeta(MODULE.id)} />
  </head>
  <body>
    <div class="topbar">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/"><img src="/favicon.svg" alt="" width="20" height="20" /> Tinker</a> <span aria-hidden="true">/</span> <span aria-current="page">{MODULE.title}</span></nav>
      <p class="by">by <a href={MODULE.author.url} target="_blank" rel="noopener">{MODULE.author.name}</a></p>
    </div>
    <main class="intro">
      <header class="hero">
        <div class="hero-text">
          <p class="kicker">Module {NUMBER} · {MODULE.title}</p>
          <p class="module-meta"><span class="level">{MODULE.level}</span></p>
          <h1>A claw that learns by watching</h1>
          <p class="lede">A robot turns what its camera sees into small moves, many times a second. Here you drive a claw, hand it over to a model that learned by copying you, and watch one slip snowball.</p>
          <div class="ctas">
            <a class="btn primary" href={chapterHref(MODULE.id, CHAPTERS[0].id)} data-cta>Start chapter 1 →</a>
            <a class="btn" href="#path">See the chapters</a>
          </div>
          <ReadingMode />
        </div>
        <div class="hero-pic">
          {/* Mira's first demo, the part in the tray */}
          <IsoStage board={CLAW_BOARD} scene={clawScene(HERO)} label={clawLabel(HERO)} />
        </div>
      </header>

      <section class="band" aria-labelledby="idea">
        <p class="kicker">The whole idea in one example</p>
        <h2 id="idea">A rule for one bin, or demos for any</h2>
        <div class="versus">
          <article class="reply">
            <header><h3>A written rule</h3><span class="stamp">breaks</span></header>
            <p class="said">{rule.end === 'off-grid' ? 'Off the grid' : 'Stuck'}</p>
            <p class="cap">on a new bin: the moves that worked on one bin, played blind.</p>
          </article>
          <article class="reply read">
            <header><h3>{`${PERSON}’s 4 demos`}</h3><span class="stamp">copied</span></header>
            <p class="said">{`${FOUR.solved} of ${N}`}</p>
            <p class="cap">fresh bins cleared by a policy that repeats her move at the most similar frame.</p>
          </article>
        </div>
        <p class="note more">A simulated bay: a made-up grid with hand-set crates, slips and light, not a real robot.</p>
      </section>

      <section aria-labelledby="how">
        <p class="kicker">How it works</p>
        <h2 id="how">Four ideas carry the module</h2>
        <ol class="steps">
          {IDEAS.map(([name, short, f, o], i) => (
            <li>
              <div class="pic"><IsoStage board={CLAW_BOARD} scene={clawScene(o)} label={clawLabel(o)} /></div>
              <h3><span class="n">{i + 1}</span> {name}</h3>
              <p class="cap">{short}</p>
              {f && <p class="more">{f.claim}</p>}
              {f && <p class="src more"><a href={f.source}>Source</a>, checked {longDate(f.accessed)}</p>}
            </li>
          ))}
        </ol>
      </section>

      <section class="company" aria-labelledby="story">
        <div>
          <p class="kicker">The story</p>
          <h2 id="story">Larkspur trials a picking arm</h2>
          <p class="more">{MODULE.story} <strong>You help {PERSON} decide how it learns.</strong></p>
        </div>
        <dl class="facts">
          {FACTS.map(([num, what]) => <div><dt>{num}</dt><dd>{what}</dd></div>)}
        </dl>
      </section>

      <section id="path" aria-labelledby="path-h">
        <p class="kicker">Your path</p>
        <h2 id="path-h">The chapters</h2>
        {/* a warm-up shows here only when one is due; the home page's Continue links to #warmup */}
        <div id="warmup"><Recap module={MODULE.id} bank={MODULE.recall ?? []} warmup client:load /></div>
        <ChapterCards module={MODULE.id} chapters={CHAPTERS} />
        <p class="recap-link"><a href={`/${MODULE.id}/recap/`}>Recap: questions from the chapters you’ve finished →</a></p>
      </section>

      <section class="pair">
        <article>
          <h2>Who it’s for</h2>
          <ul class="who-chips"><li>Engineers</li><li>Product managers</li><li>Analysts</li><li>No code needed</li></ul>
          <p class="more">Anyone weighing a robot pilot who wants to know how robots learn from people and where they fail. The Multimodal module first helps; no maths is needed.</p>
        </article>
      </section>

      <footer class="credits">
        <p>Part of <a href="/">Tinker</a>, visual explanations of tech concepts by <a href="https://kondasamy.com" target="_blank" rel="noopener">Samy (Kondasamy Jayaraman)</a>.</p>
      </footer>
    </main>

    <script>
      // finished chapters get a tick; the button continues from the first unfinished chapter
      import { moduleOf, chapterHref } from '../../lib/modules';
      import { completed } from '../../lib/progress';
      const CHAPTERS = moduleOf('robots').chapters;
      const done = completed('robots');
      for (const li of document.querySelectorAll<HTMLElement>('.path [data-chapter]')) {
        if (!done.includes(li.dataset.chapter!)) continue;
        li.classList.add('done');
        li.querySelector<HTMLElement>('.done-mark')!.hidden = false;
      }
      const next = CHAPTERS.findIndex(c => !done.includes(c.id));
      if (done.length && next > 0) for (const a of document.querySelectorAll<HTMLAnchorElement>('[data-cta]')) {
        a.href = chapterHref('robots', CHAPTERS[next].id);
        a.textContent = `Continue: chapter ${next + 1} →`;
      }
    </script>
  </body>
</html>

<style>
  .intro { max-width: 1100px; margin: 0 auto; padding: 24px 24px 64px; display: flex; flex-direction: column; gap: 72px; font-size: 15px; line-height: 1.6; }
  .intro h1 { margin: 6px 0 14px; font-size: 36px; line-height: 1.15; letter-spacing: -.01em; }
  .intro h2 { margin: 4px 0 18px; font-size: 24px; line-height: 1.25; }
  .intro h3 { margin: 0; font-size: 16px; }
  .intro p { margin: 0 0 10px; }

  .hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 40px; align-items: center; }
  .lede { font-size: 17px; }
  .intro .module-meta { margin: 8px 0 10px; font-size: 13.5px; color: var(--muted); }
  .module-meta .level { margin-right: 4px; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }

  .band { background: var(--card); border: 1.5px solid var(--ink); border-radius: 20px; padding: 28px 32px; box-shadow: 5px 5px 0 var(--ink); }
  .versus { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 18px; align-items: start; }
  .reply { min-width: 0; border-radius: 14px; padding: 16px 18px; border: 1.5px solid var(--ink); background: var(--paper); }
  .reply header { display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-bottom: 8px; }
  .reply.read { border-left: 6px solid var(--acc); }
  .said { font-size: 28px; font-weight: 900; }

  .stamp { font-weight: 900; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; border: 2px solid currentColor; border-radius: 6px; padding: 1px 8px; transform: rotate(-3deg); white-space: nowrap; }
  .note { margin: 16px 0 0; font-size: 13px; color: var(--muted); }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .steps li { padding: 18px; border: 1.5px solid var(--rule); border-radius: 16px; display: flex; flex-direction: column; gap: 8px; }
  .steps h3 { display: flex; align-items: center; gap: 10px; font-size: 17px; }
  .steps p { font-size: 14px; margin: 0; }
  .steps .pic { height: 240px; display: flex; justify-content: center; margin-bottom: 4px; }
  .steps .pic :global(svg) { width: auto !important; height: 100% !important; max-width: 100%; }
  .steps .src { margin-top: auto; font-size: 12.5px; color: var(--muted); }

  .company { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 40px; align-items: start; }
  .facts { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin: 0; }
  .facts div { border: 1.5px solid var(--ink); border-radius: 12px; padding: 10px 14px; background: var(--card); }
  .facts dt { font-size: 26px; font-weight: 900; line-height: 1.1; }
  .facts dd { margin: 0; font-size: 13px; color: var(--muted); }

  .recap-link { margin: 16px 0 0; font-weight: 800; }
  #warmup { scroll-margin-top: 16px; }

  .pair { display: grid; gap: 24px; }
  .pair article { border: 1.5px solid var(--rule); border-radius: 16px; padding: 20px 22px; }
  .pair h2 { font-size: 18px; margin-bottom: 10px; }

  @media (max-width: 860px) {
    .intro { padding: 16px 16px 48px; gap: 48px; }
    .intro h1 { font-size: 27px; }
    .hero, .versus, .company, .pair { grid-template-columns: 1fr; }
    .band { padding: 20px 18px; }
    .steps { grid-template-columns: 1fr; }
    .steps .pic { height: 200px; }
  }
</style>

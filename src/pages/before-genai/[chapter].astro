---
import ChapterLayout from '../../layouts/ChapterLayout.astro';
import Scripted from '../../content/before-genai/01-scripted';
import Intents from '../../content/before-genai/02-intents';
import PredictiveAi from '../../content/before-genai/03-predictive-ai';
import { moduleOf } from '../../lib/modules';

export function getStaticPaths() {
  return moduleOf('before-genai').chapters.map(({ id, title }) => ({ params: { chapter: id }, props: { title } }));
}

const { chapter } = Astro.params;
const { title } = Astro.props;
---
<ChapterLayout module="before-genai" chapter={chapter} title={title}>
  {/* One line per chapter: hydration needs each island as a static component in the template (KTD2). */}
  {chapter === '01-scripted' ? <Scripted client:load />
    : chapter === '02-intents' ? <Intents client:load />
    : chapter === '03-predictive-ai' ? <PredictiveAi client:load />
    : null}
</ChapterLayout>

---
// before-genai module intro: sets the scene before chapter 1, with the same sections as the other module intros. Static,
// except the figure and a small script that marks finished chapters. Every example comes from the module's own data
// (data/before-genai/), never typed in by hand. Replace the placeholder copy; keep the sections and the credits footer.
import '../../styles/tokens.css';
import '../../styles/page.css';
import Meta from '../../components/Meta.astro';
import Recap from '../../components/quiz/Recap';
import { BeforeGenaiStage } from '../../content/before-genai/kit';
import { messageOf, run } from '../../lib/before-genai/bots';
import { moduleOf, chapterHref } from '../../lib/modules';
import { introMeta } from '../../lib/pages';
import { longDate } from '../../lib/format';
import DATA from '../../../data/before-genai/facts.json' with { type: 'json' };

const MODULE = moduleOf('before-genai');
const CHAPTERS = MODULE.chapters;

const checked = longDate(DATA.accessed);
---
<html lang="en">
  <head>
    <Meta {...introMeta(MODULE.id)} />
  </head>
  <body>
    <div class="topbar">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/"><img src="/favicon.svg" alt="" width="20" height="20" /> Tinker</a> <span aria-hidden="true">/</span> <span aria-current="page">{MODULE.title}</span></nav>
      <p class="by">by <a href={MODULE.author.url} target="_blank" rel="noopener">{MODULE.author.name}</a></p>
    </div>
    <main class="intro">
      <header class="hero">
        <div class="hero-text">
          <p class="kicker">{MODULE.title}</p>
          <p class="module-meta"><span class="level">{MODULE.level}</span></p>
          <h1>{MODULE.title}</h1>
          <p class="lede">{MODULE.description}</p>
          <div class="ctas">
            <a class="btn primary" href={chapterHref(MODULE.id, CHAPTERS[0].id)} data-cta>Start chapter 1 →</a>
            <a class="btn" href="#path">See the chapters</a>
          </div>
        </div>
        <div class="hero-pic">
          <BeforeGenaiStage client:visible run={run(messageOf('where-order'))} caption="Larkspur’s help counter." />
        </div>
      </header>

      <section class="band" aria-labelledby="idea">
        <p class="kicker">The whole idea in one example</p>
        <h2 id="idea">One example that shows the idea</h2>
        <p>{DATA.facts[0].claim}</p>
      </section>

      <section aria-labelledby="how">
        <p class="kicker">How it works</p>
        <h2 id="how">The ideas that carry the module</h2>
        <ol class="steps">
          {DATA.facts.map((f, i) => (
            <li>
              <h3><span class="n">{i + 1}</span> {f.id}</h3>
              <p>{f.claim}</p>
              <p class="src"><a href={f.source}>Source</a>, checked {checked}</p>
            </li>
          ))}
        </ol>
      </section>

      <section aria-labelledby="story">
        <p class="kicker">The story</p>
        <h2 id="story">Where the story happens</h2>
        <p>{MODULE.story}</p>
      </section>

      <section id="path" aria-labelledby="path-h">
        <p class="kicker">Your path</p>
        <h2 id="path-h">The chapters</h2>
        {/* a warm-up shows here only when one is due (R13); the home page's Continue links to #warmup */}
        <div id="warmup"><Recap module={MODULE.id} bank={MODULE.recall ?? []} warmup client:load /></div>
        <ol class="path">
          {CHAPTERS.map((c, i) => (
            <li data-chapter={c.id}>
              <span class="dot" aria-hidden="true">{i + 1}</span>
              <div class="body">
                <h3><a href={chapterHref(MODULE.id, c.id)}>{c.title}</a><span class="done-mark" hidden> · done</span></h3>
                <p>{c.intro.goal}</p>
              </div>
            </li>
          ))}
        </ol>
        <p class="recap-link"><a href={`/${MODULE.id}/recap/`}>Recap: questions from the chapters you’ve finished →</a></p>
      </section>

      <section class="pair">
        <article>
          <h2>Who it’s for</h2>
          <p>Who the module is written for, and what they need to know first.</p>
        </article>
      </section>

      <footer class="credits">
        <p>Part of <a href="/">Tinker</a>, visual explanations of tech concepts by <a href="https://kondasamy.com" target="_blank" rel="noopener">Samy (Kondasamy Jayaraman)</a>. This module by <a href={MODULE.author.url} target="_blank" rel="noopener">{MODULE.author.name}</a>.</p>
      </footer>
    </main>

    <script>
      // finished chapters get a tick; the button continues from the first unfinished chapter
      import { moduleOf, chapterHref } from '../../lib/modules';
      import { completed } from '../../lib/progress';
      const CHAPTERS = moduleOf('before-genai').chapters;
      const done = completed('before-genai');
      for (const li of document.querySelectorAll<HTMLElement>('.path [data-chapter]')) {
        if (!done.includes(li.dataset.chapter!)) continue;
        li.classList.add('done');
        li.querySelector<HTMLElement>('.done-mark')!.hidden = false;
      }
      const next = CHAPTERS.findIndex(c => !done.includes(c.id));
      if (done.length && next > 0) for (const a of document.querySelectorAll<HTMLAnchorElement>('[data-cta]')) {
        a.href = chapterHref('before-genai', CHAPTERS[next].id);
        a.textContent = `Continue: chapter ${next + 1} →`;
      }
    </script>
  </body>
</html>

<style>
  .intro { max-width: 1100px; margin: 0 auto; padding: 24px 24px 64px; display: flex; flex-direction: column; gap: 72px; font-size: 15px; line-height: 1.6; }
  .intro h1 { margin: 6px 0 14px; font-size: 36px; line-height: 1.15; letter-spacing: -.01em; }
  .intro h2 { margin: 4px 0 18px; font-size: 24px; line-height: 1.25; }
  .intro h3 { margin: 0; font-size: 16px; }
  .intro p { margin: 0 0 10px; }

  .hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 40px; align-items: center; }
  .lede { font-size: 17px; }
  .intro .module-meta { margin: 8px 0 10px; font-size: 13.5px; color: var(--muted); }
  .module-meta .level { margin-right: 4px; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }

  .band { background: var(--card); border: 1.5px solid var(--ink); border-radius: 20px; padding: 28px 32px; box-shadow: 5px 5px 0 var(--ink); }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; }
  .steps li { padding: 18px; border: 1.5px solid var(--rule); border-radius: 16px; display: flex; flex-direction: column; gap: 8px; }
  .steps h3 { display: flex; align-items: center; gap: 10px; font-size: 17px; }
  .steps p { font-size: 14px; margin: 0; }
  .steps .src { margin-top: auto; font-size: 12.5px; color: var(--muted); }

  .recap-link { margin: 0 0 0 52px; font-weight: 800; }
  #warmup { scroll-margin-top: 16px; }
  .path { list-style: none; margin: 0; padding: 0; position: relative; }
  .path::before { content: ''; position: absolute; left: 17px; top: 18px; bottom: 18px; border-left: 2px dashed var(--rule); }
  .path li { position: relative; display: grid; grid-template-columns: 36px minmax(0, 1fr); gap: 16px; padding: 0 0 22px; }
  .dot { position: relative; display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; border: 1.5px solid var(--ink); background: var(--card); font-weight: 900; }
  .path li.done .dot { background: var(--ok); color: var(--paper); }
  .path h3 { font-size: 17px; margin-top: 5px; }
  .path h3 a { text-decoration: none; }
  .path h3 a:hover { text-decoration: underline; }
  .done-mark { color: var(--ok); font-size: 13px; }
  .path .body p { margin: 4px 0 0; font-size: 14px; color: var(--muted); max-width: 70ch; }

  .pair { display: grid; gap: 24px; }
  .pair article { border: 1.5px solid var(--rule); border-radius: 16px; padding: 20px 22px; }
  .pair h2 { font-size: 18px; margin-bottom: 10px; }

  @media (max-width: 860px) {
    .intro { padding: 16px 16px 48px; gap: 48px; }
    .intro h1 { font-size: 27px; }
    .hero, .pair { grid-template-columns: 1fr; }
    .band { padding: 20px 18px; }
  }
</style>

---
// Tinker home: the platform. Each module is one tech concept told as a playable story; RAG is the first.
// The catalogue is built from the module registry, one section per level. Static, except a small script that shows
// progress on live cards and points Continue at the module played last.
import '../styles/tokens.css';
import '../styles/page.css';
import Meta from '../components/Meta.astro';
import IsoStage, { type SceneCtx } from '../lib/iso/IsoStage';
import { miniPipeline, MINI_BOARD, MINI_LABEL } from '../components/scenes/miniPipeline';
import { HERO_BOARD, HOME_HERO, HOME_HERO_LABEL } from '../components/scenes/heroScene';
import { renderers, blockShadow, type BlockType } from '../lib/iso/blocks';
import { MODULES, type Level } from '../lib/modules';
import { HOME } from '../lib/pages';
import { SEQ_MSGS } from '../components/scenes/toolSequence';
import { OFFICE_BOARD, officeScene, officeLabel } from '../components/scenes/officeScene';
import { RECORDINGS } from '../lib/tools/turns';
import { agentScene, agentLabel } from '../components/scenes/agentScene';
import { run } from '../lib/agents/loop';
import { RECORDINGS as AGENT_RECORDINGS } from '../lib/agents/turns';
import { diskLoader } from '../lib/rag/diskLoader';
import { EVAL_BOARD, evalScene, evalLabel } from '../components/scenes/evalScene';
import { openIndex } from '../lib/rag/load';
import { fileOf, runSuite, VERSIONS } from '../lib/evals/suite';
import { GUARD_BOARD, guardScene, guardLabel } from '../components/scenes/guardScene';
import { run as guardRun } from '../lib/guardrails/loop';
import { RECORDING as GUARD_RECORDING } from '../lib/guardrails/turns';

const one = (type: BlockType, opts: { lit?: boolean; state?: 'ok' } = {}) => ({ top }: SceneCtx) =>
  blockShadow(type, 30, 30, top) + renderers[type]({ x: 30, y: 30, ...opts });

const PRINCIPLES: [string, string, ReturnType<typeof one>][] = [
  ['Play, don’t just read', 'Every page has a live picture. Each step asks you to change one thing in it, and you watch what happens.', one('agent')],
  ['The real thing underneath', 'Nothing is faked for the animation. In RAG, real retrieval maths runs in your browser over real embeddings.', one('index')],
  ['A story with stakes', 'You join a team with a problem to solve. Each chapter starts with something going wrong, and you fix it.', one('llm', { state: 'ok' })],
];
const LOOP: [string, string][] = [
  ['Meet the problem', 'A short story sets up what is going wrong and why it matters.'],
  ['Change one thing', 'The step asks for one action in the picture: add a block, move a slider, pick an answer.'],
  ['Watch what changes', 'The picture, the meters and the answer update at once, so cause and effect are visible.'],
  ['Fix it yourself', 'Puzzles hand you a broken setup. Hints appear when you’re stuck, and “Show me” is always there.'],
];
// a live module's card picture and topic chips; every other fact on a card comes from the registry
type Iso = { board: typeof MINI_BOARD; scene: typeof miniPipeline; label: string };
const OFFICE = { msgs: SEQ_MSGS, upTo: 3, tools: RECORDINGS['order-status'].tools.length, scale: 1.7 };
// the damaged delivery with the printer out of stock: the agent checked, changed course and is telling the customer
const CASE = run(AGENT_RECORDINGS['01-workflow-or-agent'], { case: 'damaged', stock: 'out' });
const AGENT = { run: CASE, upTo: CASE.steps.length - 1, scale: 1.7 };
// the evals test bench with v2's whole run graded (the suite runs at build time, over the committed index)
const INDEX = await openIndex(diskLoader);
await INDEX.load(fileOf('v2')!);
const BENCH = { results: runSuite(INDEX, 'v2').map(r => r.verdict === 'correct'), version: VERSIONS.v2.label, scale: 1.7 };
// the mail room: a forwarded invoice's planted note has the customer's record riding out to the post box
const LEAK = guardRun(GUARD_RECORDING, { case: 'invoice' });
const MAIL = { run: LEAK, upTo: LEAK.steps.findIndex(st => st.kind === 'call' && st.call.name === 'send_email') + 1, scale: 1.7 };
const CARD: Record<string, { name: string; iso?: Iso; topics: string[] }> = {
  rag: { name: 'Retrieval-Augmented Generation (RAG)', iso: { board: MINI_BOARD, scene: miniPipeline, label: MINI_LABEL }, topics: ['Context windows', 'Embeddings', 'Chunking', 'Vector search', 'Reranking', 'Agentic RAG', 'GraphRAG'] },
  'tool-calling': { name: 'Tool calling & the Model Context Protocol (MCP)', iso: { board: OFFICE_BOARD, scene: officeScene(OFFICE), label: officeLabel(OFFICE) }, topics: ['Tool definitions', 'JSON Schema', 'Multi-step calls', 'MCP hosts & servers', 'Tools, resources, prompts', 'Approval', 'Prompt injection'] },
  agents: { name: 'AI agents', iso: { board: OFFICE_BOARD, scene: agentScene(AGENT), label: agentLabel(AGENT) }, topics: ['Workflow or agent', 'The agent loop', 'Plans & approval', 'Step & token budgets', 'Stuck loops', 'Memory & compaction', 'Sub-agents'] },
  evals: { name: 'Evals & LLM testing', iso: { board: EVAL_BOARD, scene: evalScene(BENCH), label: evalLabel(BENCH) }, topics: ['Test sets', 'Regressions', 'Code graders', 'Model judges', 'Judging the judge', 'Grading the path', 'pass@k & pass^k', 'Release gates'] },
  guardrails: { name: 'Prompt injection & guardrails', iso: { board: GUARD_BOARD, scene: guardScene(MAIL), label: guardLabel(MAIL) }, topics: ['Direct & indirect injection', 'Prompt rules', 'Input filters', 'Output checks', 'The lethal trifecta', 'Defence in depth', 'Red teaming'] },
};
const LEVELS: Level[] = ['Beginner', 'Intermediate', 'Advanced'];
const LIVE = MODULES.filter(m => m.status === 'live');
const FIRST = LIVE[0];
// live modules first within a level
const atLevel = (level: Level) => [...LIVE, ...MODULES.filter(m => m.status === 'planned')].filter(m => m.level === level);
---
<html lang="en">
  <head>
    <Meta {...HOME} />
  </head>
  <body>
    <div class="topbar">
      <p class="crumbs"><img src="/favicon.svg" alt="" width="22" height="22" /> Tinker</p>
      <p class="by">by <a href="https://kondasamy.com">Kondasamy Jayaraman</a></p>
    </div>
    <main class="home">
      <header class="hero">
        <div class="hero-text">
          <h1>See how tech works <em>by playing with it.</em></h1>
          <p class="lede">Hand-drawn, interactive explanations of the technology people use at work every day but rarely get to see inside. Each module is a short story you play through: build the thing, watch it break, fix it.</p>
          <ul class="chips" aria-label="At a glance"><li>Free</li><li>No sign-up</li><li>Nothing to install</li><li>Works on your phone</li></ul>
          <div class="ctas">
            <a class="btn primary" href={`/${FIRST.id}/`} data-continue>Start with {FIRST.title} →</a>
            <a class="btn" href="#loop">How it works</a>
          </div>
        </div>
        <figure class="hero-pic">
          <IsoStage board={HERO_BOARD} scene={HOME_HERO} label={HOME_HERO_LABEL} />
          <figcaption>One workshop, a plot per module. The empty plots are open: <a href="https://github.com/Kondasamy/tinker/blob/main/CONTRIBUTING.md">build one</a>.</figcaption>
        </figure>
      </header>

      <section aria-labelledby="why">
        <p class="kicker">Why Tinker</p>
        <h2 id="why">Understanding comes from poking at things</h2>
        <ul class="principles">
          {PRINCIPLES.map(([title, text, scene]) => (
            <li>
              <div class="pic"><IsoStage board={[0, 0, 60, 60]} scene={scene} label={title} /></div>
              <h3>{title}</h3>
              <p>{text}</p>
            </li>
          ))}
        </ul>
      </section>

      <section id="modules" aria-labelledby="modules-h">
        <p class="kicker">Modules</p>
        <h2 id="modules-h">Pick a concept</h2>
        {LEVELS.map(level => { const mods = atLevel(level); return (
          <section class="level-group" data-level={level} aria-labelledby={`level-${level}`}>
            <h3 id={`level-${level}`}>{level}</h3>
            {!mods.some(m => m.status === 'live') && <p class="coming">{mods.length ? 'Coming. Nothing to play at this level yet.' : 'Coming. The next module is being built.'}</p>}
            <div class="modules">
              {mods.map(m => m.status === 'live' ? (
                <article class="module" data-module={m.id}>
                  {CARD[m.id]?.iso && <div class="pic"><IsoStage {...CARD[m.id].iso!} /></div>}
                  <div class="info">
                    <p class="kicker">Module {LIVE.indexOf(m) + 1} · {m.chapters.length ? `${m.chapters.length} ${m.chapters.length === 1 ? 'chapter' : 'chapters'}` : 'Chapters arrive soon'}</p>
                    <h4><a href={`/${m.id}/`}>{CARD[m.id]?.name ?? m.title}</a></h4>
                    <p class="tags"><span class="level">{m.level}</span></p>
                    <p>{m.description}</p>
                    {CARD[m.id] && <ul class="topics" aria-label="Topics">{CARD[m.id].topics.map(t => <li>{t}</li>)}</ul>}
                    <div class="progress" data-progress hidden><span class="bar"><span></span></span><span class="txt"></span></div>
                    <a class="btn primary" href={`/${m.id}/`} data-cta>Start {m.title} →</a>
                  </div>
                </article>
              ) : (
                <article class="roadmap" id={`module-${m.id}`} data-module={m.id}>
                  <p class="tags"><span class="level">{m.level}</span> <span class="planned">Planned</span></p>
                  <h4>{m.title}</h4>
                  <p>{m.description}</p>
                </article>
              ))}
            </div>
          </section>
        ); })}
      </section>

      <section id="loop" aria-labelledby="loop-h">
        <p class="kicker">How it works</p>
        <h2 id="loop-h">Every module plays the same way</h2>
        <ol class="loop">
          {LOOP.map(([title, text], i) => <li><h3><span class="n">{i + 1}</span> {title}</h3><p>{text}</p></li>)}
        </ol>
      </section>

      <footer class="credits">
        <p>Made by <a href="https://kondasamy.com">Kondasamy Jayaraman</a>.</p>
        <p>The illustrations are drawn with <a href="https://april-zhu.com/colorfigures">Colorfigures</a> by <a href="https://april-zhu.com/">April Zhu</a>, whose hand-inked isometric style and engine Tinker is built on. Colorfigures grew from April’s <a href="https://isoglow.dev">ISO-GLOW</a>, which builds on <a href="https://github.com/MrBongoC/ai-iso-skill">iso-figure</a> by Tolga Cohce. All MIT licensed. Thank you.</p>
      </footer>
    </main>

    <script>
      // progress on each live card; card buttons and the hero's Continue go to the first unfinished chapter
      import { MODULES, chapterHref } from '../lib/modules';
      import { completed, completedAt, lastModule, recallResults } from '../lib/progress';
      import { warmupItems } from '../lib/recall';
      const live = MODULES.filter(m => m.status === 'live');
      const resume = (m: typeof live[number]) => {
        const finished = completed(m.id), next = m.chapters.findIndex(c => !finished.includes(c.id));
        const done = m.chapters.filter(c => finished.includes(c.id)).length;
        // a warm-up is due: Continue opens it on the module intro, which offers a skip to the chapter (R8, R13)
        if (warmupItems(m.recall ?? [], completedAt(m.id), recallResults(m.id), Date.now()).length)
          return { done, href: `/${m.id}/#warmup`, text: `Warm up, then continue ${m.title} →` };
        return {
          done,
          // a first visit, or a finished module, opens the intro: it sets the context before chapter 1 (AGENTS.md)
          href: !done || next < 0 ? `/${m.id}/` : chapterHref(m.id, m.chapters[next].id),
          text: next < 0 ? `Revisit ${m.title} →` : `Continue ${m.title}: chapter ${next + 1} →`,
        };
      };
      for (const m of live) {
        const r = resume(m), card = document.querySelector<HTMLElement>(`.module[data-module="${m.id}"]`);
        if (!r.done || !card) continue;
        const box = card.querySelector<HTMLElement>('[data-progress]')!;
        box.hidden = false;
        box.querySelector<HTMLElement>('.bar span')!.style.width = `${(100 * r.done) / m.chapters.length}%`;
        box.querySelector<HTMLElement>('.txt')!.textContent = `${r.done} of ${m.chapters.length} chapters done`;
        const a = card.querySelector<HTMLAnchorElement>('[data-cta]')!;
        a.href = r.href;
        a.textContent = r.text;
      }
      const last = lastModule(), pick = live.find(m => m.id === last) ?? live[0];
      const r = resume(pick), go = document.querySelector<HTMLAnchorElement>('[data-continue]')!;
      go.href = r.href;
      if (r.done) go.textContent = r.text;
      else if (pick !== live[0]) go.textContent = `Start ${pick.title} →`;
    </script>
  </body>
</html>

<style>
  .home { max-width: 1100px; margin: 0 auto; padding: 24px 24px 64px; display: flex; flex-direction: column; gap: 80px; font-size: 15px; line-height: 1.6; }
  .home h1 { margin: 0 0 16px; font-size: 44px; line-height: 1.08; letter-spacing: -.015em; }
  .home h1 em { font-style: normal; background: linear-gradient(transparent 62%, var(--acc) 62% 92%, transparent 92%); }
  .home h2 { margin: 4px 0 20px; font-size: 26px; line-height: 1.2; }
  .home h3 { margin: 0; font-size: 17px; }
  .home p { margin: 0 0 10px; }
  .topbar p { margin: 0; }
  .lede { font-size: 17px; max-width: 54ch; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; }

  .hero { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.25fr); gap: 32px; align-items: center; padding-top: 24px; }
  .hero-pic { margin: 0; }
  /* the envelope rides its belt again and again, a sign of life in the picture (none with reduced motion) */
  @media (prefers-reduced-motion: no-preference) {
    .hero-pic :global(.capsule) { animation: hero-ride 3.2s cubic-bezier(.45, 0, .3, 1) infinite; }
  }
  @keyframes hero-ride { 0% { transform: translate(var(--dx), var(--dy)); opacity: 0; } 12% { opacity: 1; } 55%, 100% { transform: none; } }
  .hero-pic figcaption { text-align: center; font-size: 12.5px; color: var(--muted); margin-top: 4px; }

  .principles { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .principles li { border: 1.5px solid var(--ink); border-radius: 16px; padding: 18px 20px; background: var(--card); box-shadow: 4px 4px 0 var(--ink); display: flex; flex-direction: column; gap: 8px; }
  .principles .pic { width: 120px; }
  .principles p { font-size: 14px; margin: 0; }

  .level-group { margin-top: 28px; }
  .level-group > h3 { font-size: 13px; letter-spacing: .12em; text-transform: uppercase; display: flex; align-items: center; gap: 12px; margin-bottom: 14px; }
  .level-group > h3::after { content: ''; flex: 1; border-top: 1.5px solid var(--rule); }
  .coming { font-size: 14px; color: var(--muted); }
  .modules { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; align-items: stretch; }
  .module { grid-column: span 2; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 24px; align-items: center; border: 1.5px solid var(--ink); border-radius: 20px; padding: 22px 24px; background: var(--card); box-shadow: 5px 5px 0 var(--ink); }
  .module h4 { font-size: 21px; line-height: 1.3; margin: 2px 0 6px; }
  .module h4 a { text-decoration: none; }
  .module h4 a:hover { text-decoration: underline; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .roadmap { border: 1.5px dashed var(--muted); border-radius: 16px; padding: 14px 18px; display: flex; flex-direction: column; gap: 4px; align-self: start; }
  .roadmap .level { background: transparent; border-color: var(--muted); }
  .roadmap h4 { font-size: 16px; margin: 2px 0 0; }
  .roadmap p { font-size: 13.5px; color: var(--muted); margin: 0; }
  .planned { font-size: 11px; letter-spacing: .1em; text-transform: uppercase; font-weight: 700; color: var(--muted); align-self: center; }
  .pic { display: block; }
  .topics { list-style: none; margin: 4px 0 16px; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .topics li { font-size: 12px; font-weight: 700; padding: 1px 9px; border-radius: 999px; background: var(--paper); border: 1px solid var(--rule); }
  .progress { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; font-size: 13px; font-weight: 700; }
  .progress[hidden] { display: none; }
  .progress .bar { flex: 1; max-width: 200px; height: 8px; border: 1.5px solid var(--ink); border-radius: 999px; overflow: hidden; background: var(--paper); }
  .progress .bar span { display: block; height: 100%; background: var(--ok); }

  .loop { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .loop li { border-top: 3px solid var(--ink); padding-top: 12px; }
  .loop h3 { display: flex; align-items: center; gap: 10px; margin-bottom: 6px; }
  .loop p { font-size: 14px; color: var(--muted); margin: 0; }

  @media (max-width: 900px) {
    .home { padding: 12px 16px 48px; gap: 56px; }
    .home h1 { font-size: 32px; }
    .hero, .modules, .module { grid-template-columns: 1fr; }
    .module { grid-column: auto; }
    .principles { grid-template-columns: 1fr; }
    .loop { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 520px) { .loop { grid-template-columns: 1fr; } }
</style>

const LEVELS: Level[] = ['Beginner', 'Intermediate', 'Advanced'];
const LIVE = MODULES.filter(m => m.status === 'live');
const FIRST = LIVE[0];
// live modules first within a level; AI modules lead the catalogue, classic tech follows as compact cards
const PLANNED = MODULES.filter(m => m.status === 'planned');
const classic = (m: Module) => m.track === 'Classic tech';
const atLevel = (level: Level, isClassic = false) =>
  [...LIVE, ...PLANNED].filter(m => m.level === level && classic(m) === isClassic);
// the catalogue's filters, each a dropdown of radios whose first is no filter; a status no card has is removed by the script
const FILTERS: [name: string, label: string, options: string[]][] = [
  ['level', 'Level', ['All levels', ...LEVELS]],
  ['track', 'Track', ['All tracks', 'AI', 'Classic tech']],
  ['status', 'Status', ['Any status', 'Not started', 'In progress', 'Finished', 'Planned']],
];
// what a search reads: title, description, story, level, track, topics and chapter titles, one line per field
const searchOf = (m: Module) =>
  [
    CARD[m.id]?.name ?? m.title,
    m.description,
    m.story,
    m.level,
    m.track ?? 'AI',
    ...(CARD[m.id]?.topics ?? []),
    ...m.chapters.map(c => c.title),
  ].join('\n');
const SENT = new URL('/?sent#request', Astro.site).href;
// each module's turn on the stand is one 2.4 s slot of a cycle through them all, and keyframe percentages must be literal,
// so each step is placed at a fixed share of one slot here: it drops in, bounces, holds, and lifts off before the next lands
const slot = (share: number) => `${+((share * 100) / HERO_TURNS).toFixed(3)}%`;
const TURN = `@keyframes hero-turn {
  0% { visibility: visible; opacity: 0; transform: translateY(-60px); }
  ${slot(0.12)} { opacity: 1; transform: none; }
  ${slot(0.18)} { transform: translateY(-6px); }
  ${slot(0.24)}, ${slot(0.88)} { opacity: 1; transform: none; }
  ${slot(0.999)} { visibility: visible; opacity: 0; transform: translateY(-40px); }
  ${slot(1)}, 100% { visibility: hidden; opacity: 0; }
}`;
---
<html lang="en">
  <head>
    <Meta {...HOME} />
    <style is:inline set:html={TURN}></style>
  </head>
  <body>
    <div class="topbar">

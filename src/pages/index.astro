---
// Tinker home: the platform. Each module is one tech concept told as a playable story; RAG is the first.
import '../styles/tokens.css';
import IsoStage from '../lib/iso/IsoStage';
import { miniPipeline, MINI_BOARD, MINI_LABEL } from '../components/scenes/miniPipeline';
import { CHAPTERS } from '../lib/chapters';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Tinker: see how tech works by playing with it</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="description" content="Hand-drawn, interactive explanations of tech concepts. Build the thing, break it, fix it. By Kondasamy Jayaraman." />
  </head>
  <body>
    <main class="home">
      <header class="hero">
        <p class="brand"><img src="/favicon.svg" alt="" width="34" height="34" /> Tinker</p>
        <h1>See how tech works by playing with it.</h1>
        <p class="lede">Hand-drawn, interactive explanations of the technology people use at work every day but rarely get to see inside. Each module is a short story you play through: you build the thing, watch it break, and fix it. No setup, nothing to install.</p>
        <p class="by">By <a href="https://kondasamy.com">Kondasamy Jayaraman</a></p>
      </header>

      <section aria-labelledby="modules">
        <h2 id="modules">Modules</h2>
        <article class="module">
          <a class="pic" href="/rag/" tabindex="-1" aria-hidden="true">
            <IsoStage board={MINI_BOARD} scene={miniPipeline} label={MINI_LABEL} />
          </a>
          <div>
            <p class="tagline">AI · {CHAPTERS.length} chapters</p>
            <h3><a href="/rag/">Retrieval-Augmented Generation (RAG)</a></h3>
            <p>How AI assistants answer from your company’s documents, why they invent answers, and the levers that make them accurate. Follow one assistant at a fictional company from its first wrong guess to its best answer.</p>
            <a class="big" href="/rag/">Start RAG →</a>
          </div>
        </article>
        <p class="more">More modules are on the way.</p>
      </section>

      <section class="how">
        <h2>How every module works</h2>
        <ul>
          <li>The picture is live: every step asks you to do one thing in it, and you watch what changes.</li>
          <li>The real thing runs underneath. In RAG, the retrieval maths runs in your browser on real embeddings.</li>
          <li>Hints appear when you’re stuck, and progress is saved in your browser. Nothing is sent anywhere.</li>
        </ul>
      </section>

      <footer class="credits">
        <p>Made by <a href="https://kondasamy.com">Kondasamy Jayaraman</a>.</p>
        <p>The illustrations are drawn with <a href="https://april-zhu.com/colorfigures">Colorfigures</a> by <a href="https://april-zhu.com/">April Zhu</a>, whose hand-inked isometric style and engine Tinker is built on. Colorfigures grew from April’s <a href="https://isoglow.dev">ISO-GLOW</a>, which builds on <a href="https://github.com/MrBongoC/ai-iso-skill">iso-figure</a> by Tolga Cohce. All MIT licensed. Thank you.</p>
      </footer>
    </main>
  </body>
</html>

<style>
  .home { max-width: 1000px; margin: 0 auto; padding: 48px 24px 64px; display: flex; flex-direction: column; gap: 40px; font-size: 15px; line-height: 1.6; }
  .home h1 { margin: 10px 0 14px; font-size: 34px; line-height: 1.15; max-width: 22ch; }
  .home h2 { margin: 0 0 12px; font-size: 18px; }
  .home p { margin: 0 0 10px; }
  .brand { display: flex; align-items: center; gap: 10px; font-size: 22px; font-weight: 800; margin: 0; }
  .lede { font-size: 17px; max-width: 62ch; }
  .by { color: var(--muted); font-size: 14px; }
  .by a { color: var(--ink); }
  .module { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 28px; align-items: center; background: var(--card); border: 1.5px solid var(--ink); border-radius: 18px; padding: 20px 24px; box-shadow: 4px 4px 0 var(--ink); }
  .module h3 { margin: 0 0 8px; font-size: 20px; line-height: 1.3; }
  .module h3 a { text-decoration: none; }
  .module h3 a:hover { text-decoration: underline; }
  .tagline { margin: 0 0 4px; font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  .pic { display: block; }
  .home .more { margin-top: 14px; color: var(--muted); font-size: 14px; }
  .big { display: inline-block; margin-top: 6px; font-weight: 800; font-size: 15px; background: var(--acc); border: 1.5px solid var(--ink); border-radius: 999px; padding: 10px 18px; box-shadow: 3px 3px 0 var(--ink); text-decoration: none; }
  .how ul { margin: 0; padding-left: 18px; display: flex; flex-direction: column; gap: 6px; max-width: 70ch; }
  .credits { border-top: 1.5px solid var(--rule); padding-top: 16px; font-size: 13px; color: var(--muted); }
  .credits p { margin: 0 0 6px; }
  .credits a { color: var(--ink); }
  @media (max-width: 800px) {
    .home { padding: 28px 16px 48px; gap: 28px; }
    .home h1 { font-size: 26px; }
    .module { grid-template-columns: 1fr; padding: 16px; }
  }
</style>

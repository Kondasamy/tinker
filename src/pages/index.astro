  /* the board's viewBox leaves headroom for tall props; pull it up under the text */
  .hero-pic { margin: max(-32px, -4%) 0 0; width: 100%; max-width: 780px; }
  /* the workshop is busy (none with reduced motion): the envelope rides its belt, RAG's wire carries a current, and the
     modules take turns on the stand, which jolts as each lands; a pointer over the picture holds the one on it */
  .hero-pic :global([data-href]) { cursor: pointer; }
  @media (prefers-reduced-motion: no-preference) {
    .hero-pic :global(.capsule) { animation: hero-ride 3.2s cubic-bezier(.45, 0, .3, 1) infinite; }
    .hero-pic :global(.hero-flow) { animation: hero-flow .9s linear infinite; }
    .hero-pic :global(.hero-turn) { animation: hero-turn calc(var(--n) * 2.4s) cubic-bezier(.5, 0, .4, 1) infinite; animation-delay: calc(var(--i) * 2.4s); }
    .hero-pic :global(.hero-thud) { animation: hero-thud 2.4s ease-out infinite; }
    .hero-pic:hover :global(:is(.hero-turn, .hero-thud)) { animation-play-state: paused; }
    /* the token press keeps cutting tiles, and the agent's clipboard keeps ticking its plan off */
    .hero-pic :global(.tile) { animation: hero-drop 2.4s cubic-bezier(.5, 0, .5, 1.4) infinite both; }
    .hero-pic :global(.tile:nth-child(2 of .tile)) { animation-delay: .3s; }
    .hero-pic :global(.tile:nth-child(3 of .tile)) { animation-delay: .6s; }
    .hero-pic :global(.tick) { animation: hero-tick 3s ease-in-out infinite both; }
    .hero-pic :global(.tick:nth-child(2 of .tick)) { animation-delay: .6s; }
  }
  @keyframes hero-ride { 0% { transform: translate(var(--dx), var(--dy)); opacity: 0; } 12% { opacity: 1; } 55%, 100% { transform: none; } }

            <a class="btn" href="#modules">See all {LIVE.length} modules</a>
          </div>
          <p class="glance">Free · No sign-up · Nothing to install · Works on your phone</p>
        </div>
        <figure class="hero-pic" style={`--n:${HERO_TURNS}`}>
          <IsoStage board={HERO_BOARD} scene={HOME_HERO} label={HOME_HERO_LABEL} />
          <figcaption>Every AI module takes a turn on the stand. Click one to step in, or <a href="#request">propose the next</a>.</figcaption>
        </figure>
      </header>

      <section id="modules" aria-labelledby="modules-h">
        <p class="kicker">AI modules</p>
        <h2 id="modules-h">Pick a concept</h2>
        <form class="finder" role="search" data-finder hidden>
          <input type="search" name="q" aria-label="Search modules" placeholder="Search modules" autocomplete="off" aria-keyshortcuts="/" />
          {/* name="filters" makes the dropdowns exclusive: opening one closes the others */}
          {FILTERS.map(([name, label, options]) => (
            <details class="pick" name="filters" data-pick={name}>
              <summary>{options[0]}</summary>
              <fieldset aria-label={label}>
                {options.map((o, i) => (
                  <label><input type="radio" name={name} value={i ? o : ''} checked={!i} /> {o}</label>
                ))}
              </fieldset>
            </details>
          ))}
          <p class="count" role="status" data-count></p>
        </form>
        <div class="none" data-none hidden>
          <p>Nothing matches yet.</p>
          <button class="btn" type="button" data-clear>Clear filters</button>
          <a class="btn primary" href="#request" data-propose>Ask for it →</a>
        </div>
        {LEVELS.map(level => { const mods = atLevel(level); return (
          <section class="level-group" data-level={level} aria-labelledby={`level-${level}`}>
            <h3 id={`level-${level}`}>{level}</h3>
            {!mods.some(m => m.status === 'live') && <p class="coming">{mods.length ? 'Coming. Nothing to play at this level yet.' : 'Coming. The next module is being built.'}</p>}
            <div class="modules">
              {mods.map(m => m.status === 'live' ? (
                <article class="module" data-module={m.id} data-track={m.track ?? 'AI'} data-status="Not started" data-search={searchOf(m)}>
                  {CARD[m.id]?.iso && <div class="pic"><IsoStage {...CARD[m.id].iso!} /></div>}
                  <div class="info">
                    <div class="head">
                      <p class="kicker">Module {moduleNumber(m)} · {m.chapters.length ? `${m.chapters.length} ${m.chapters.length === 1 ? 'chapter' : 'chapters'}` : 'Chapters arrive soon'}</p>
                      <p class="tags"><span class="level">{m.level}</span></p>
                    </div>
                    <h4 id={`card-${m.id}`}><a href={`/${m.id}/`}>{CARD[m.id]?.name ?? m.title}</a></h4>
                    <p>{m.description}</p>
                    <p class="hit" data-hit hidden></p>
                    <div class="progress" data-progress hidden><span class="bar"><span></span></span><span class="txt"></span></div>
                    {/* the title sits right above, so the button says only what it does; the title describes it for screen readers */}
                    <a class="btn primary" href={`/${m.id}/`} aria-describedby={`card-${m.id}`} data-cta>Start →</a>
                  </div>
                </article>
              ) : (
                <article class="roadmap" id={`module-${m.id}`} data-module={m.id} data-track={m.track ?? 'AI'} data-status="Planned" data-search={searchOf(m)}>
                  <p class="tags"><span class="level">{m.level}</span> <span class="planned">Planned</span></p>
                  <h4>{m.title}</h4>
                  <p>{m.description}</p>
                </article>
              ))}
            </div>
          </section>
        ); })}
        <section class="classic" data-classic aria-labelledby="classic-h">
          <h3 id="classic-h">Classic tech</h3>
          {LEVELS.map(level => (
            <div class="compacts" data-level={level}>
              {atLevel(level, true).map(m => m.status === 'live' ? (
                <article class="module compact" data-module={m.id} data-track={m.track} data-status="Not started" data-search={searchOf(m)}>
                  {CARD[m.id]?.iso && <div class="pic"><IsoStage {...CARD[m.id].iso!} /></div>}
                  <div class="head">
                    <p class="kicker">Module {moduleNumber(m)} · {m.chapters.length} {m.chapters.length === 1 ? 'chapter' : 'chapters'}</p>
                    <p class="tags"><span class="level">{m.level}</span></p>
                  </div>
                  <h4 id={`card-${m.id}`}><a href={`/${m.id}/`}>{CARD[m.id]?.name ?? m.title}</a></h4>
                  <p>{m.description}</p>
                  <p class="hit" data-hit hidden></p>
                  <div class="progress" data-progress hidden><span class="bar"><span></span></span><span class="txt"></span></div>
                  <a class="btn" href={`/${m.id}/`} aria-describedby={`card-${m.id}`} data-cta>Start →</a>
                </article>
              ) : (
                <article class="roadmap" id={`module-${m.id}`} data-module={m.id} data-track={m.track} data-status="Planned" data-search={searchOf(m)}>
                  <p class="tags"><span class="level">{m.level}</span> <span class="planned">Planned</span></p>
                  <h4>{m.title}</h4>
                  <p>{m.description}</p>
                </article>
              ))}
            </div>
          ))}
        </section>
        <div class="propose">
          <p>Want a concept explained here?</p>
          <a class="btn primary" href="#request">Propose a module →</a>
        </div>
      </section>

      <section aria-labelledby="why">
        <p class="kicker">Why Tinker</p>
        <h2 id="why">Understanding comes from poking at things</h2>
        <ul class="principles">
          {PRINCIPLES.map(([title, text, scene]) => (
            <li>
              <div class="pic"><IsoStage board={[0, 0, 60, 60]} scene={scene} label={title} /></div>
              <h3>{title}</h3>
              <p>{text}</p>
            </li>
          ))}
        </ul>
      </section>

      <section id="loop" aria-labelledby="loop-h">
        <p class="kicker">How it works</p>
        <h2 id="loop-h">Every module plays the same way</h2>
        <ol class="loop">
          {LOOP.map(([title, text], i) => <li><h3><span class="n">{i + 1}</span> {title}</h3><p>{text}</p></li>)}
        </ol>
      </section>

      <section id="request" aria-labelledby="request-h">
        <div class="ask-head">
          <p class="kicker">Requests &amp; feedback</p>
          <h2 id="request-h">What should Tinker explain <em>next?</em></h2>
          <p class="sent" role="status" hidden>Thanks, it’s on its way. I read every one.</p>
        </div>
        <form class="ask" action={FORM} method="POST">
          <fieldset>
            <legend>This is</legend>
            <label><input type="radio" name="kind" value="Module request" checked /> A module request</label>
            <label><input type="radio" name="kind" value="Feedback" /> Feedback</label>
          </fieldset>
          <label>Your idea or feedback
            <textarea name="message" rows="5" maxlength="4000" required placeholder="A concept you’d like to play with, or what worked and what didn’t"></textarea>
          </label>
          <label>Email, if you’d like a reply (optional)
            <input type="email" name="email" autocomplete="email" />
          </label>
          <input type="hidden" name="_subject" value="Tinker: a new request or feedback" />
          <input type="hidden" name="_template" value="table" />
          <input type="hidden" name="_next" value={SENT} />
          <input type="text" name="_honey" class="honey" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <button class="btn primary" type="submit">Send →</button>
        </form>
      </section>

      <footer class="credits">
        <p>Made by <a href="https://kondasamy.com" target="_blank" rel="noopener">Samy (Kondasamy Jayaraman)</a>.</p>
        <p>The illustrations are drawn with <a href="https://april-zhu.com/colorfigures">Colorfigures</a> by <a href="https://april-zhu.com/">April Zhu</a>, whose hand-inked isometric style and engine Tinker is built on. Colorfigures grew from April’s <a href="https://isoglow.dev">ISO-GLOW</a>, which builds on <a href="https://github.com/MrBongoC/ai-iso-skill">iso-figure</a> by Tolga Cohce. All MIT licensed. Thank you.</p>
      </footer>
    </main>

    <script>
      // FormSubmit sends the reader back here once the form is mailed
      if (new URLSearchParams(location.search).has('sent')) document.querySelector<HTMLElement>('#request .sent')!.hidden = false;
      // a click on a piece of the hero opens its page (the stand's hidden turns take no clicks)
      document.querySelector('.hero-pic')!.addEventListener('click', e => {
        const href = (e.target as Element).closest<SVGElement>('[data-href]')?.dataset.href;
        if (href) location.href = href;
      });
      // progress on each live card; card buttons and the hero's Continue go to the first unfinished chapter
      import { MODULES, chapterHref } from '../lib/modules';
      import { completed, completedAt, lastModule, recallResults } from '../lib/progress';
      import { warmupItems } from '../lib/recall';
      const live = MODULES.filter(m => m.status === 'live');
      const resume = (m: typeof live[number]) => {
        const finished = completed(m.id), next = m.chapters.findIndex(c => !finished.includes(c.id));
        const done = m.chapters.filter(c => finished.includes(c.id)).length;
        // a warm-up is due: Continue opens it on the module intro, which offers a skip to the chapter (R8, R13)
        if (warmupItems(m.recall ?? [], completedAt(m.id), recallResults(m.id), Date.now()).length)
          return { done, href: `/${m.id}/#warmup`, text: `Warm up, then continue ${m.title} →`, short: 'Warm up, then continue →' };
        return {
          done,
          // a first visit, or a finished module, opens the intro: it sets the context before chapter 1 (AGENTS.md)
          href: !done || next < 0 ? `/${m.id}/` : chapterHref(m.id, m.chapters[next].id),
          text: next < 0 ? `Revisit ${m.title} →` : `Continue ${m.title}: chapter ${next + 1} →`,
          // a card's button, under its title
          short: next < 0 ? 'Revisit →' : `Continue: chapter ${next + 1} →`,
        };
      };
      for (const m of live) {
        const r = resume(m), card = document.querySelector<HTMLElement>(`.module[data-module="${m.id}"]`);
        if (!r.done || !card) continue;
        card.dataset.status = r.done < m.chapters.length ? 'In progress' : 'Finished';
        const box = card.querySelector<HTMLElement>('[data-progress]')!;
        box.hidden = false;
        box.querySelector<HTMLElement>('.bar span')!.style.width = `${(100 * r.done) / m.chapters.length}%`;
        box.querySelector<HTMLElement>('.txt')!.textContent = `${r.done} of ${m.chapters.length} chapters done`;
        const a = card.querySelector<HTMLAnchorElement>('[data-cta]')!;
        a.href = r.href;
        a.textContent = r.short;
      }
      // the last module played, or once it is finished, the next module not yet finished: the hero walks the reader through them all
      const unfinished = (m: typeof live[number]) => m.chapters.some(c => !completed(m.id).includes(c.id));
      // AI modules are picked first: classic tech comes after every AI module
      const order = [...live.filter(m => !m.track), ...live.filter(m => m.track)];
      // the prequel (live[0]) is a first visit's start: a reader already playing elsewhere is never sent back to it
      const path = live.slice(1).some(m => completed(m.id).length) ? order.filter(m => m !== live[0]) : order;
      const last = live.find(m => m.id === lastModule()) ?? path[0];
      const pick = unfinished(last) ? last : path.find(unfinished) ?? last;
      const r = resume(pick), go = document.querySelector<HTMLAnchorElement>('[data-continue]')!;
      go.href = r.href;
      if (r.done) go.textContent = r.text;
      else if (pick !== live[0]) go.textContent = `Start ${pick.title} →`;

      // the catalogue's finder: every word of the search must appear, and every chip must match; the URL keeps the view
      const finder = document.querySelector<HTMLFormElement>('[data-finder]')!;
      const cards = [...document.querySelectorAll<HTMLElement>('#modules [data-search]')];
      const none = document.querySelector<HTMLElement>('[data-none]')!;
      const q = finder.querySelector<HTMLInputElement>('[name="q"]')!;
      const FIELDS = ['level', 'track', 'status'] as const;
      // a status no card has yet (nothing in progress on a first visit) is no use as a chip
      for (const chip of finder.querySelectorAll<HTMLInputElement>('[name="status"]'))
        if (chip.value && !cards.some(c => c.dataset.status === chip.value)) chip.parentElement!.remove();
      const params = new URLSearchParams(location.search);
      q.value = params.get('q') ?? '';
      for (const name of FIELDS) {
        const chip = finder.querySelector<HTMLInputElement>(`[name="${name}"][value="${CSS.escape(params.get(name) ?? '')}"]`);
        if (chip) chip.checked = true;
      }
      const apply = () => {
        const form = new FormData(finder);
        const words = q.value.toLowerCase().split(/\s+/).filter(Boolean);
        let shown = 0;
        for (const card of cards) {
          const lines = card.dataset.search!.split('\n'), text = lines.join('\n').toLowerCase();
          const at = { level: card.closest<HTMLElement>('[data-level]')!.dataset.level, track: card.dataset.track, status: card.dataset.status };
          const ok = words.every(w => text.includes(w)) && FIELDS.every(f => !form.get(f) || form.get(f) === at[f]);
          card.hidden = !ok;
          shown += +ok;
          // a match the card doesn't show (a topic or chapter) is named under its description
          const hit = card.querySelector<HTMLElement>('[data-hit]');
          if (!hit) continue;
          const seen = lines.slice(0, 2).join(' ').toLowerCase();
          const extra = lines.slice(5).find(l => words.some(w => !seen.includes(w) && l.toLowerCase().includes(w)));
          hit.hidden = !ok || !extra;
          hit.textContent = extra ? `Includes: ${extra}` : '';
        }
        for (const g of document.querySelectorAll<HTMLElement>('#modules [data-level]'))
          g.hidden = !g.querySelector('[data-search]:not([hidden])');
        const classic = document.querySelector<HTMLElement>('[data-classic]')!;
        classic.hidden = !classic.querySelector('[data-search]:not([hidden])');
        // playable modules, as the hero counts them, then the planned ones apart
        const planned = cards.filter(c => !c.hidden && c.dataset.status === 'Planned').length;
        const live = shown - planned;
        finder.querySelector('[data-count]')!.textContent = `${live} live${planned ? ` · ${planned} planned` : ''}`;
        // each dropdown names its choice, and one that filters is lit
        for (const f of FIELDS) {
          const pick = finder.querySelector<HTMLElement>(`[data-pick="${f}"]`)!;
          pick.toggleAttribute('data-on', !!form.get(f));
          pick.querySelector('summary')!.textContent = pick.querySelector(':checked')!.parentElement!.textContent!.trim();
        }
        none.hidden = shown > 0;
        document.querySelector<HTMLElement>('#modules .propose')!.hidden = !shown;
        const url = new URLSearchParams();
        if (q.value.trim()) url.set('q', q.value.trim());
        for (const f of FIELDS) if (form.get(f)) url.set(f, String(form.get(f)));
        history.replaceState(null, '', `${location.pathname}${url.size ? `?${url}` : ''}${location.hash}`);
      };
      finder.hidden = false;
      finder.addEventListener('input', apply);
      // a pick, Escape or a click elsewhere closes the open dropdown
      const close = (focus = false) => {
        const open = finder.querySelector<HTMLDetailsElement>('.pick[open]');
        if (!open) return;
        open.open = false;
        if (focus) open.querySelector('summary')!.focus();
      };
      finder.addEventListener('change', e => (e.target as HTMLElement).closest('.pick') && close(true));
      finder.addEventListener('keydown', e => e.key === 'Escape' && close(true));
      document.addEventListener('click', e => !(e.target as Element).closest?.('.pick') && close());
      finder.addEventListener('submit', e => e.preventDefault());
      none.querySelector('[data-clear]')!.addEventListener('click', () => {
        finder.reset();
        q.value = '';
        apply();
        q.focus();
      });
      // a search that finds nothing becomes a module request
      none.querySelector('[data-propose]')!.addEventListener('click', () => {
        const ask = document.querySelector<HTMLTextAreaElement>('#request textarea')!;
        if (!ask.value && q.value.trim()) ask.value = `A module on: ${q.value.trim()}`;
      });
      document.addEventListener('keydown', e => {
        if (e.key !== '/' || e.metaKey || e.ctrlKey || (e.target as HTMLElement).closest('input, textarea, select, [contenteditable]')) return;
        e.preventDefault();
        q.focus();
      });
      apply();
    </script>
  </body>
</html>

<style>
  .home { max-width: 1100px; margin: 0 auto; padding: 24px 24px 64px; display: flex; flex-direction: column; gap: 80px; font-size: 15px; line-height: 1.6; }

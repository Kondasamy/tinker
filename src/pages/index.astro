---
// Tinker home: the platform. Each module is one tech concept told as a playable story; RAG is the first.
// The catalogue is built from the module registry, one section per level. Static, except a small script that shows
// progress on live cards and points Continue at the module played last.
import '../styles/tokens.css';
import '../styles/page.css';
import Meta from '../components/Meta.astro';
import IsoStage, { type SceneCtx } from '../lib/iso/IsoStage';
import { miniPipeline, MINI_BOARD, MINI_LABEL } from '../components/scenes/miniPipeline';
import { HERO_BOARD, HOME_HERO, HOME_HERO_LABEL, heroCaption } from '../components/scenes/heroScene';
import { renderers, blockShadow, type BlockType } from '../lib/iso/blocks';
import { MODULES, type Level } from '../lib/modules';
import { HOME } from '../lib/pages';
import { SEQ_MSGS } from '../components/scenes/toolSequence';
import { OFFICE_BOARD, officeScene, officeLabel } from '../components/scenes/officeScene';
import { RECORDINGS } from '../lib/tools/turns';
import { agentScene, agentLabel } from '../components/scenes/agentScene';
import { run } from '../lib/agents/loop';
import { RECORDINGS as AGENT_RECORDINGS } from '../lib/agents/turns';
import { diskLoader } from '../lib/rag/diskLoader';
import { EVAL_BOARD, evalScene, evalLabel } from '../components/scenes/evalScene';
import { openIndex } from '../lib/rag/load';
import { fileOf, runSuite, VERSIONS } from '../lib/evals/suite';
import { GUARD_BOARD, guardScene, guardLabel } from '../components/scenes/guardScene';
import { run as guardRun } from '../lib/guardrails/loop';
import { RECORDING as GUARD_RECORDING } from '../lib/guardrails/turns';
import { TOKEN_BOARD, tokenScene, tokenLabel } from '../components/scenes/tokenScene';
import { SENTENCES } from '../lib/tokens/encodings';
import { ENGINE_BOARD, engineScene, engineLabel } from '../components/scenes/engineScene';
import { PROMPTS, trace } from '../lib/transformers/trace';
import { diskModel } from '../lib/transformers/diskModel';
import { WINDOW_BOARD, windowScene, windowLabel } from '../components/scenes/windowScene';
import { run as contextRun } from '../lib/context/loop';
import { RECORDING as CONTEXT_RECORDING } from '../lib/context/turns';
import { TRAIN_BOARD, trainScene, trainLabel } from '../components/scenes/trainScene';
import { STENCIL_BOARD, stencilScene, stencilLabel } from '../components/scenes/stencilScene';
import { stencilAt } from '../content/structured-outputs/kit';
import { play as stencilPlay, run as stencilRun } from '../lib/structured-outputs/prompts';
import { THINK_BOARD, thinkScene, thinkLabel } from '../components/scenes/thinkScene';
import { deskOf as thinkDeskOf } from '../content/reasoning/kit';
import { run as reasoningRun, SPLIT } from '../lib/reasoning/engine';
import { ROUTER_BOARD, routerScene, routerLabel } from '../components/scenes/routerScene';
import { SERVE_BOARD, floorAt, serveScene, serveLabel } from '../components/scenes/serveScene';
import { OPEN, serve } from '../lib/inference/server';
import { TRACE_BOARD, traceScene, traceLabel } from '../components/scenes/traceScene';
import { binsOf, wallOf } from '../content/observability/kit';
import { FAILED } from '../lib/observability/traces';
import { DAY1_COUNTS, TOP } from '../lib/observability/coding';
import { SANDBOX_BOARD, sandboxScene, sandboxLabel } from '../components/scenes/sandboxScene';
import { run as sandboxRun } from '../lib/sandboxing/loop';
import { RECORDING as SANDBOX_RECORDING } from '../lib/sandboxing/turns';
import { SCAN_BOARD, scanScene, scanLabel } from '../components/scenes/scanScene';
import { PHONE_BOARD, phoneScene, phoneLabel } from '../components/scenes/phoneScene';
import { DEFAULT_LINE, runCall } from '../lib/voice/engine';
import { FORGE_BOARD, forgeScene, forgeLabel } from '../components/scenes/forgeScene';
import { STEPS as FORGE_STEPS } from '../lib/pre-training/engine';
import { EXAM_BOARD, examScene, examLabel } from '../components/scenes/examScene';
import { FULL, REFUND, refOf, rewardsOf } from '../lib/post-training/graders';
import { grpoRun, seedOf } from '../lib/post-training/policy';
import { cardsOf, groupOf } from '../content/post-training/kit';

const one =
  (type: BlockType, opts: { lit?: boolean; state?: 'ok' } = {}) =>
  ({ top }: SceneCtx) =>
    blockShadow(type, 30, 30, top) + renderers[type]({ x: 30, y: 30, ...opts });

const PRINCIPLES: [string, string, ReturnType<typeof one>][] = [
  [
    'Play, don’t just read',
    'Every page has a live picture. Each step asks you to change one thing in it, and you watch what happens.',
    one('agent'),
  ],
  [
    'The real thing underneath',
    'Nothing is faked for the animation. In RAG, real retrieval maths runs in your browser over real embeddings.',
    one('index'),
  ],
  [
    'A story with stakes',
    'You join a team with a problem to solve. Each chapter starts with something going wrong, and you fix it.',
    one('llm', { state: 'ok' }),
  ],
];
const LOOP: [string, string][] = [
  ['Meet the problem', 'A short story sets up what is going wrong and why it matters.'],
  ['Change one thing', 'The step asks for one action in the picture: add a block, move a slider, pick an answer.'],
  ['Watch what changes', 'The picture, the meters and the answer update at once, so cause and effect are visible.'],
  [
    'Fix it yourself',
    'Puzzles hand you a broken setup. Hints appear when you’re stuck, and “Show me” is always there.',
  ],
];
// a live module's card picture and topic chips; every other fact on a card comes from the registry
type Iso = { board: typeof MINI_BOARD; scene: typeof miniPipeline; label: string };
const OFFICE = { msgs: SEQ_MSGS, upTo: 3, tools: RECORDINGS['order-status'].tools.length, scale: 1.7 };
// the damaged delivery with the printer out of stock: the agent checked, changed course and is telling the customer
const CASE = run(AGENT_RECORDINGS['01-workflow-or-agent'], { case: 'damaged', stock: 'out' });
const AGENT = { run: CASE, upTo: CASE.steps.length - 1, scale: 1.7 };
// the evals test bench with v2's whole run graded (the suite runs at build time, over the committed index)
const INDEX = await openIndex(diskLoader);
await INDEX.load(fileOf('v2')!);
const BENCH = {
  results: runSuite(INDEX, 'v2').map(r => r.verdict === 'correct'),
  version: VERSIONS.v2.label,
  scale: 1.7,
};
// the mail room: a forwarded invoice's planted note has the customer's record riding out to the post box
const LEAK = guardRun(GUARD_RECORDING, { case: 'invoice' });
const MAIL = {
  run: LEAK,
  upTo: LEAK.steps.findIndex(st => st.kind === 'call' && st.call.name === 'send_email') + 1,
  scale: 1.7,
};
// the token press cutting Larkspur's order sentence (tokens chapter 1's) into tiles
const PRESS = { text: SENTENCES.find(s => s.id === 'order-en')!.text, scale: 1.7 };
// the engine room reading transformers chapter 1's prompt, the word-start head's threads from its last token
const READ = trace(diskModel(), PROMPTS.find(p => p.id === 'reply')!.text);
const ROOM = { tokens: READ.tokens.map(t => t.text), attention: READ.attention, scale: 1.7 };
// the window desk on Mara's third question (context chapter 4's session), every document stuffed: the cache shelf lit
const DESK = {
  run: contextRun(CONTEXT_RECORDING, {
    sessions: [['refund-window', 'free-shipping', 'sensor-warranty']],
    tools: true,
    retrieval: 'stuff',
  }),
  shelf: true,
  scale: 1.7,
};
// the training bench with the weights lever pulled and the LoRA adapter clipped on
const BENCH9 = { lit: 'weights', weights: 'lora', scale: 1.7 } as const;
// the stencil press on "Where is order 1042?", at the first step where the schema blocks the model's own choice
const MASKED_RUN = stencilRun('mask'),
  MASKED = stencilPlay(diskModel(), MASKED_RUN).decoded;
const STENCIL = {
  ...stencilAt(
    MASKED_RUN.prompt,
    MASKED,
    MASKED.steps.findIndex(s => !s.allowed.includes(s.free.id)),
    true,
  ),
  scale: 1.7,
};
// the scratchpad desk at medium effort on the split-order quote, its pad of thinking papers beside the model
const THINK = { ...thinkDeskOf(reasoningRun(SPLIT, 'medium')), scale: 1.7 };
// the apprentice's bench routing: the small model unsure below 0.9, its answer sent up the fallback chute
const ROUTER = { mode: 'route', route: 'up', threshold: 0.9, scale: 1.7 } as const;
// the serving floor at its busiest pass, continuous batching at cap 8, as the module's intro opens
const FLOOR = { ...floorAt(serve(OPEN, { mode: 'continuous', cap: 8, kvRoomGB: 14 })), scale: 1.7 };
// the control room as the module's intro opens: the day's failed traces sorted into bins, the one to fix first lit
const CONTROL = { cards: wallOf(FAILED, FAILED[0].id), bins: binsOf(DAY1_COUNTS, TOP[0]), scale: 1.7 };
// the glass room as the module's intro opens on the sandbox: the exfiltration attack's fetch refused at the network door
const EXFIL = sandboxRun(SANDBOX_RECORDING, {
  case: 'exfil',
  sandbox: true,
  files: 'scoped',
  egress: 'allowlist',
  secret: 'proxy',
});
const GLASS = {
  run: EXFIL,
  upTo: EXFIL.steps.findIndex(s => s.kind === 'blocked') + 1,
  wall: true,
  files: 'scoped',
  egress: 'allowlist',
  proxy: true,
  scale: 1.7,
} as const;
// the scanning table as the module's intro opens: the supplier's invoice read by vision at 1,600 px
const SCAN = { image: 'invoice', size: 1600, method: 'vision', scale: 1.7 } as const;
// the phone desk as the module's intro opens: Ravi's reply on its way back, the stopwatch showing his wait
const PHONE = {
  stage: 'reply',
  wait: runCall('hesitant', { ...DEFAULT_LINE, streaming: true, bargeIn: true, readBack: true, silence: 800 }).wait,
  scale: 1.7,
} as const;
// the foundry as the module's intro opens: the furnace lit, the model a third of the way through its run
const FORGE = { steps: FORGE_STEPS, step: 1000, scale: 1.7 };
// the exam hall after the key-fact grader's run on the refund question: the right answer's stack the tallest
const EXAM_RUN = grpoRun(refOf(REFUND), rewardsOf(REFUND, FULL), seedOf(REFUND));
const EXAM = {
  cards: cardsOf(REFUND, EXAM_RUN.at(-1)!.after, rewardsOf(REFUND, FULL)),
  grader: 'KEY FACT',
  group: groupOf(EXAM_RUN.at(-1)),
  scale: 1.7,
};
const CARD: Record<string, { name: string; iso?: Iso; topics: string[] }> = {
  rag: {
    name: 'Retrieval-Augmented Generation (RAG)',
    iso: { board: MINI_BOARD, scene: miniPipeline, label: MINI_LABEL },
    topics: ['Context windows', 'Embeddings', 'Chunking', 'Vector search', 'Reranking', 'Agentic RAG', 'GraphRAG'],
  },
  'tool-calling': {
    name: 'Tool calling & the Model Context Protocol (MCP)',
    iso: { board: OFFICE_BOARD, scene: officeScene(OFFICE), label: officeLabel(OFFICE) },
    topics: [
      'Tool definitions',
      'JSON Schema',
      'Multi-step calls',
      'MCP hosts & servers',
      'Tools, resources, prompts',
      'Approval',
      'Prompt injection',
    ],
  },
  agents: {
    name: 'AI agents',
    iso: { board: OFFICE_BOARD, scene: agentScene(AGENT), label: agentLabel(AGENT) },
    topics: [
      'Workflow or agent',
      'The agent loop',
      'Plans & approval',
      'Step & token budgets',
      'Stuck loops',
      'Memory & compaction',
      'Sub-agents',
    ],
  },
  evals: {
    name: 'Evals & LLM testing',
    iso: { board: EVAL_BOARD, scene: evalScene(BENCH), label: evalLabel(BENCH) },
    topics: [
      'Test sets',
      'Regressions',
      'Code graders',
      'Model judges',
      'Judging the judge',
      'Grading the path',
      'pass@k & pass^k',
      'Release gates',
    ],
  },
  guardrails: {
    name: 'Prompt injection & guardrails',
    iso: { board: GUARD_BOARD, scene: guardScene(MAIL), label: guardLabel(MAIL) },
    topics: [
      'Direct & indirect injection',
      'Prompt rules',
      'Input filters',
      'Output checks',
      'The lethal trifecta',
      'Defence in depth',
      'Red teaming',
    ],
  },
  tokens: {
    name: 'Tokens & embeddings',
    iso: { board: TOKEN_BOARD, scene: tokenScene(PRESS), label: tokenLabel(PRESS) },
    topics: [
      'Tokens & ids',
      'Byte pair encoding',
      'Counting & cost',
      'Tokenizers compared',
      'Embeddings',
      'Meaning by neighbours',
      'Token budgets',
    ],
  },
  transformers: {
    name: 'Transformer architecture',
    iso: { board: ENGINE_BOARD, scene: engineScene(ROOM), label: engineLabel(ROOM) },
    topics: [
      'Next-token prediction',
      'Embeddings & position',
      'Attention',
      'The causal mask',
      'Heads & layers',
      'Temperature & top-p',
      'The KV cache',
    ],
  },
  context: {
    name: 'Context engineering & memory',
    iso: { board: WINDOW_BOARD, scene: windowScene(DESK), label: windowLabel(DESK) },
    topics: [
      'The context window',
      'Lost in the middle',
      'Just-in-time retrieval',
      'Prompt caching',
      'Clearing tool results',
      'Memory files',
      'Context policy',
    ],
  },
  'fine-tuning': {
    name: 'Fine-tuning vs prompting',
    iso: { board: TRAIN_BOARD, scene: trainScene(BENCH9), label: trainLabel(BENCH9) },
    topics: [
      'Prompt, documents or weights',
      'Training & loss',
      'LoRA adapters',
      'Facts vs style',
      'Forgetting & cost',
      'Evals before training',
      'Choosing an approach',
    ],
  },
  'structured-outputs': {
    name: 'Structured outputs',
    iso: { board: STENCIL_BOARD, scene: stencilScene(STENCIL), label: stencilLabel(STENCIL) },
    topics: [
      'JSON mode vs schemas',
      'Constrained decoding',
      'The token mask',
      'Tokens vs characters',
      'Enums',
      'Valid isn’t right',
      'Schema design',
    ],
  },
  reasoning: {
    name: 'Reasoning models & thinking budgets',
    iso: { board: THINK_BOARD, scene: thinkScene(THINK), label: thinkLabel(THINK) },
    topics: [
      'Thinking before answering',
      'Thinking tokens',
      'Effort levels',
      'Overthinking',
      'Adaptive thinking',
      'Accuracy vs cost',
      'Choosing an effort',
    ],
  },
  'small-models': {
    name: 'Small models: distillation & routing',
    iso: { board: ROUTER_BOARD, scene: routerScene(ROUTER), label: routerLabel(ROUTER) },
    topics: [
      'Big vs small models',
      'Distillation',
      'Teacher & student',
      'Routing',
      'Confidence & fallback',
      'Release gates',
      'Routing policy',
    ],
  },
  inference: {
    name: 'Inference engineering',
    iso: { board: SERVE_BOARD, scene: serveScene(FLOOR), label: serveLabel(FLOOR) },
    topics: [
      'Prefill & decode',
      'The KV cache at scale',
      'Batching',
      'Quantization',
      'Speculative decoding',
      'Pace vs throughput',
      'Serving settings',
    ],
  },
  observability: {
    name: 'Observability & error analysis',
    iso: { board: TRACE_BOARD, scene: traceScene(CONTROL), label: traceLabel(CONTROL) },
    topics: [
      'Traces & spans',
      'The first failure',
      'Open coding',
      'Axial coding',
      'Frequency vs harm',
      'Traces to eval cases',
      'A new day of traffic',
    ],
  },
  sandboxing: {
    name: 'Agent sandboxing',
    iso: { board: SANDBOX_BOARD, scene: sandboxScene(GLASS), label: sandboxLabel(GLASS) },
    topics: [
      'Where code runs',
      'Filesystem mounts',
      'Network egress',
      'Secrets & the proxy',
      'Exfiltration',
      'Fewer approval prompts',
      'Red-teaming a policy',
    ],
  },
  multimodal: {
    name: 'Multimodal models',
    iso: { board: SCAN_BOARD, scene: scanScene(SCAN), label: scanLabel(SCAN) },
    topics: [
      'Images as tokens',
      'Patches',
      'Resolution & cost',
      'OCR vs vision',
      'Field extraction',
      'Photos & ambiguity',
      'Text in images',
    ],
  },
  voice: {
    name: 'Voice agents',
    iso: { board: PHONE_BOARD, scene: phoneScene(PHONE), label: phoneLabel(PHONE) },
    topics: [
      'Speech-to-text & text-to-speech',
      'The latency budget',
      'Streaming',
      'Turn detection',
      'Barge-in',
      'Mishearing & read-back',
      'Speech-to-speech models',
    ],
  },
  'pre-training': {
    name: 'Pre-training',
    iso: { board: FORGE_BOARD, scene: forgeScene(FORGE), label: forgeLabel(FORGE) },
    topics: [
      'Random weights',
      'Checkpoints',
      'Training loss',
      'Held-out text',
      'Duplicated data',
      'Leaked tests',
      'Scaling laws',
    ],
  },
  'post-training': {
    name: 'Post-training',
    iso: { board: EXAM_BOARD, scene: examScene(EXAM), label: examLabel(EXAM) },
    topics: [
      'Base models',
      'Preference pairs',
      'DPO',
      'Graders and GRPO',
      'What a grader can’t check',
      'Reward hacking',
      'Building a grader',
    ],
  },
};
const LEVELS: Level[] = ['Beginner', 'Intermediate', 'Advanced'];
const LIVE = MODULES.filter(m => m.status === 'live');
const FIRST = LIVE[0];
// live modules first within a level
const PLANNED = MODULES.filter(m => m.status === 'planned');
const atLevel = (level: Level) => [...LIVE, ...PLANNED].filter(m => m.level === level);
// FormSubmit mails the form with no backend; the alias keeps the author's address out of the page
const FORM = 'https://formsubmit.co/772ba7c404246e8574ae55366cdadcae';
const SENT = new URL('/?sent#request', Astro.site).href;
const CAPTION = heroCaption(PLANNED.length > 0);
// the wave's cycle is one 0.8 s slot per live plot, and keyframe percentages must be literal, so each step is placed at a
// fixed share of one slot here: a pill is gone by the end of its slot, and only one ever shows, at any count
const slot = (share: number) => `${+((share * 100) / LIVE.length).toFixed(3)}%`;
const WAVE = `@keyframes hero-show { 0%, ${slot(1)}, 100% { opacity: 0; } ${slot(0.18)}, ${slot(0.88)} { opacity: 1; } }
@keyframes hero-hop { 0%, ${slot(1)}, 100% { transform: none; } ${slot(0.36)} { transform: translateY(-7px); } ${slot(0.72)} { transform: translateY(1px); } }`;
---
<html lang="en">
  <head>
    <Meta {...HOME} />
    <style is:inline set:html={WAVE}></style>
  </head>
  <body>
    <div class="topbar">
      <p class="crumbs"><img src="/favicon.svg" alt="" width="22" height="22" /> Tinker</p>
      <p class="by">by <a href="https://kondasamy.com" target="_blank" rel="noopener">Kondasamy Jayaraman</a></p>
    </div>
    <main class="home">
      <header class="hero">
        <div class="hero-text">
          <h1>See how tech works <em>by playing with it.</em></h1>
          <p class="lede">Hand-drawn stories you play: build the thing, watch it break, fix it.</p>
          <div class="ctas">
            <a class="btn primary" href={`/${FIRST.id}/`} data-continue>Start with the basics →</a>
            <a class="btn" href="#modules">See all {LIVE.length} modules</a>
          </div>
          <p class="glance">Free · No sign-up · Nothing to install · Works on your phone</p>
        </div>
        <figure class="hero-pic" style={`--n:${LIVE.length}`}>
          <IsoStage board={HERO_BOARD} scene={HOME_HERO} label={HOME_HERO_LABEL} />
          <figcaption>One workshop, a plot per module. {CAPTION.text} <a href="#request">{CAPTION.link}</a>.</figcaption>
        </figure>
      </header>

      <section aria-labelledby="why">
        <p class="kicker">Why Tinker</p>
        <h2 id="why">Understanding comes from poking at things</h2>
        <ul class="principles">
          {PRINCIPLES.map(([title, text, scene]) => (
            <li>
              <div class="pic"><IsoStage board={[0, 0, 60, 60]} scene={scene} label={title} /></div>
              <h3>{title}</h3>
              <p>{text}</p>
            </li>
          ))}
        </ul>
      </section>

      <section id="modules" aria-labelledby="modules-h">
        <p class="kicker">Modules</p>
        <h2 id="modules-h">Pick a concept</h2>
        {LEVELS.map(level => { const mods = atLevel(level); return (
          <section class="level-group" data-level={level} aria-labelledby={`level-${level}`}>
            <h3 id={`level-${level}`}>{level}</h3>
            {!mods.some(m => m.status === 'live') && <p class="coming">{mods.length ? 'Coming. Nothing to play at this level yet.' : 'Coming. The next module is being built.'}</p>}
            <div class="modules">
              {mods.map(m => m.status === 'live' ? (
                <article class="module" data-module={m.id}>
                  {CARD[m.id]?.iso && <div class="pic"><IsoStage {...CARD[m.id].iso!} /></div>}
                  <div class="info">
                    <div class="head">
                      <p class="kicker">Module {LIVE.indexOf(m) + 1} · {m.chapters.length ? `${m.chapters.length} ${m.chapters.length === 1 ? 'chapter' : 'chapters'}` : 'Chapters arrive soon'}</p>
                      <p class="tags"><span class="level">{m.level}</span></p>
                    </div>
                    <h4><a href={`/${m.id}/`}>{CARD[m.id]?.name ?? m.title}</a></h4>
                    <p>{m.description}</p>
                    {CARD[m.id] && <ul class="topics" aria-label="Topics">{CARD[m.id].topics.map(t => <li>{t}</li>)}</ul>}
                    <div class="progress" data-progress hidden><span class="bar"><span></span></span><span class="txt"></span></div>
                    <a class="btn primary" href={`/${m.id}/`} data-cta>Start {m.title} →</a>
                  </div>
                </article>
              ) : (
                <article class="roadmap" id={`module-${m.id}`} data-module={m.id}>
                  <p class="tags"><span class="level">{m.level}</span> <span class="planned">Planned</span></p>
                  <h4>{m.title}</h4>
                  <p>{m.description}</p>
                </article>
              ))}
            </div>
          </section>
        ); })}
        <p class="propose">Want a concept explained here? <a href="#request">Propose a module</a>.</p>
      </section>

      <section id="loop" aria-labelledby="loop-h">
        <p class="kicker">How it works</p>
        <h2 id="loop-h">Every module plays the same way</h2>
        <ol class="loop">
          {LOOP.map(([title, text], i) => <li><h3><span class="n">{i + 1}</span> {title}</h3><p>{text}</p></li>)}
        </ol>
      </section>

      <section id="request" aria-labelledby="request-h">
        <p class="kicker">Requests &amp; feedback</p>
        <h2 id="request-h">What should Tinker explain next?</h2>
        <p class="sent" role="status" hidden>Thanks, it’s on its way. I read every one.</p>
        <form class="ask" action={FORM} method="POST">
          <fieldset>
            <legend>This is</legend>
            <label><input type="radio" name="kind" value="Module request" checked /> A module request</label>
            <label><input type="radio" name="kind" value="Feedback" /> Feedback</label>
          </fieldset>
          <label>Your idea or feedback
            <textarea name="message" rows="5" maxlength="4000" required placeholder="A concept you’d like to play with, or what worked and what didn’t"></textarea>
          </label>
          <label>Email, if you’d like a reply (optional)
            <input type="email" name="email" autocomplete="email" />
          </label>
          <input type="hidden" name="_subject" value="Tinker: a new request or feedback" />
          <input type="hidden" name="_template" value="table" />
          <input type="hidden" name="_next" value={SENT} />
          <input type="text" name="_honey" class="honey" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <button class="btn primary" type="submit">Send →</button>
        </form>
      </section>

      <footer class="credits">
        <p>Made by <a href="https://kondasamy.com" target="_blank" rel="noopener">Kondasamy Jayaraman</a>.</p>
        <p>The illustrations are drawn with <a href="https://april-zhu.com/colorfigures">Colorfigures</a> by <a href="https://april-zhu.com/">April Zhu</a>, whose hand-inked isometric style and engine Tinker is built on. Colorfigures grew from April’s <a href="https://isoglow.dev">ISO-GLOW</a>, which builds on <a href="https://github.com/MrBongoC/ai-iso-skill">iso-figure</a> by Tolga Cohce. All MIT licensed. Thank you.</p>
      </footer>
    </main>

    <script>
      // FormSubmit sends the reader back here once the form is mailed
      if (new URLSearchParams(location.search).has('sent')) document.querySelector<HTMLElement>('#request .sent')!.hidden = false;
      // progress on each live card; card buttons and the hero's Continue go to the first unfinished chapter
      import { MODULES, chapterHref } from '../lib/modules';
      import { completed, completedAt, lastModule, recallResults } from '../lib/progress';
      import { warmupItems } from '../lib/recall';
      const live = MODULES.filter(m => m.status === 'live');
      const resume = (m: typeof live[number]) => {
        const finished = completed(m.id), next = m.chapters.findIndex(c => !finished.includes(c.id));
        const done = m.chapters.filter(c => finished.includes(c.id)).length;
        // a warm-up is due: Continue opens it on the module intro, which offers a skip to the chapter (R8, R13)
        if (warmupItems(m.recall ?? [], completedAt(m.id), recallResults(m.id), Date.now()).length)
          return { done, href: `/${m.id}/#warmup`, text: `Warm up, then continue ${m.title} →` };
        return {
          done,
          // a first visit, or a finished module, opens the intro: it sets the context before chapter 1 (AGENTS.md)
          href: !done || next < 0 ? `/${m.id}/` : chapterHref(m.id, m.chapters[next].id),
          text: next < 0 ? `Revisit ${m.title} →` : `Continue ${m.title}: chapter ${next + 1} →`,
        };
      };
      for (const m of live) {
        const r = resume(m), card = document.querySelector<HTMLElement>(`.module[data-module="${m.id}"]`);
        if (!r.done || !card) continue;
        const box = card.querySelector<HTMLElement>('[data-progress]')!;
        box.hidden = false;
        box.querySelector<HTMLElement>('.bar span')!.style.width = `${(100 * r.done) / m.chapters.length}%`;
        box.querySelector<HTMLElement>('.txt')!.textContent = `${r.done} of ${m.chapters.length} chapters done`;
        const a = card.querySelector<HTMLAnchorElement>('[data-cta]')!;
        a.href = r.href;
        a.textContent = r.text;
      }
      // the last module played, or once it is finished, the next module not yet finished: the hero walks the reader through them all
      const unfinished = (m: typeof live[number]) => m.chapters.some(c => !completed(m.id).includes(c.id));
      const last = live.find(m => m.id === lastModule()) ?? live[0];
      const pick = unfinished(last) ? last : live.find(unfinished) ?? last;
      const r = resume(pick), go = document.querySelector<HTMLAnchorElement>('[data-continue]')!;
      go.href = r.href;
      if (r.done) go.textContent = r.text;
      else if (pick !== live[0]) go.textContent = `Start ${pick.title} →`;
    </script>
  </body>
</html>


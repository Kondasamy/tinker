---
// RAG module intro: sets the scene before chapter 1. Static, except a small script that marks finished chapters.
// Every example on this page is the course's own data: the recorded answers, the real questions, the corpus size.
import '../../styles/tokens.css';
import '../../styles/page.css';
import IsoStage, { type SceneCtx } from '../../lib/iso/IsoStage';
import { miniPipeline, MINI_BOARD, MINI_LABEL } from '../../components/scenes/miniPipeline';
import { BLOCKS, renderers, blockShadow, type BlockType } from '../../lib/iso/blocks';
import { CHAPTERS, chapterHref } from '../../lib/chapters';
import refund from '../../../data/answers/refund-enterprise.json';
import ch3 from '../../../data/questions/ch3.json';
import ch5 from '../../../data/questions/ch5.json';
import ch6 from '../../../data/questions/ch6.json';
import manifest from '../../../public/data/index/manifest.json';
import Meta from '../../components/Meta.astro';
import { RAG } from '../../lib/pages';
import { moduleOf } from '../../lib/modules';
import Recap from '../../components/quiz/Recap';
import ReadingMode from '../../components/intro/ReadingMode.astro';
import ChapterCards from '../../components/intro/ChapterCards.astro';
import { INK, pd } from '../../lib/iso/core.js';
import { BH, ACC } from '../../lib/iso/blocks';

const MODULE = moduleOf('rag');

const QUESTION = ch3.find(q => q.id === 'refund-enterprise')!.query;
const WITHOUT = refund.nocontext,
  WITH = refund['enterprise-excluded:intact'];

// one block per letter of R-A-G, drawn alone
const one =
  (type: BlockType, opts: { lit?: boolean; state?: 'ok' | 'warn' } = {}) =>
  ({ top }: SceneCtx) =>
    blockShadow(type, 30, 30, top) + renderers[type]({ x: 30, y: 30, ...opts });
// the comparison's pictures: the model alone (guessing), and documents wired to it (answering from them)
const ALONE = one('llm', { state: 'warn' });
const WIRED = ({ top }: SceneCtx) => {
  const d = pd(
    [
      [30, 30, BH + 0.3],
      [100, 30, BH + 0.3],
    ],
    false,
  );
  return (
    blockShadow('docs', 30, 30, top) +
    blockShadow('llm', 100, 30, top) +
    `<path d="${d}" fill="none" stroke="${INK}" stroke-width="4.2" stroke-linecap="round"/><path d="${d}" fill="none" stroke="${ACC}" stroke-width="2.2" stroke-linecap="round"/>` +
    renderers.docs({ x: 30, y: 30 }) +
    renderers.llm({ x: 100, y: 30, state: 'ok' })
  );
};
const STEPS: [string, string, string, BlockType, ReturnType<typeof one>][] = [
  [
    'Retrieve',
    'Find the few passages that match',
    'Search every document for the passages closest in meaning to the question. Keep the best few.',
    'retriever',
    one('retriever', { lit: true }),
  ],
  [
    'Augment',
    'Hand them to the model',
    'Put those passages into the prompt, next to the question, so the model reads them first.',
    'assembler',
    one('assembler'),
  ],
  [
    'Generate',
    'Answer from them, with a source',
    'The model writes the answer from what it was handed, and can point to where it came from.',
    'llm',
    one('llm', { state: 'ok' }),
  ],
];

// real questions from later chapters, and what makes each one hard
const all = [...ch5, ...ch6];
const q = (id: string) => all.find(x => x.id === id)!.query;
const HARD: [string, string, number][] = [
  [q('stale-hotel-limit'), 'A retired policy still sits in the drive', 5],
  [q('vague-outage'), 'Nothing in the documents is worded like this', 5],
  [q('card-data-retention'), 'A look-alike note uses the same words', 5],
  [q('kestrel-purchase-approver'), 'The answer needs two documents joined', 6],
  [q('k2-volume-price'), 'The answer is inside a table', 6],
];
const FACTS: [string, string][] = [
  ['~4,000', 'business customers'],
  ['~260', 'staff'],
  [String(manifest.corpus.docs), 'documents on the drive'],
  ['2', 'warehouses'],
];
---
<html lang="en">
  <head>
    <Meta {...RAG} />
  </head>
  <body>
    <div class="topbar">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/"><img src="/favicon.svg" alt="" width="20" height="20" /> Tinker</a> <span aria-hidden="true">/</span> <span aria-current="page">RAG</span></nav>
      <p class="by">by <a href={MODULE.author.url} target="_blank" rel="noopener">{MODULE.author.name}</a></p>
    </div>
    <main class="rag">
      <header class="hero">
        <div class="hero-text">
          <p class="kicker">Module 1 · AI</p>
          <p class="module-meta"><span class="level">{MODULE.level}</span></p>
          <h1>How AI assistants answer from your company’s documents</h1>
          <p class="lede">Retrieval-Augmented Generation (RAG) is how most workplace AI assistants find the right policy, contract or price before they answer. You’ll build one block by block, watch it fail, and fix it.</p>
          <div class="ctas">
            <a class="btn primary" href={chapterHref(CHAPTERS[0].id)} data-cta>Start chapter 1 →</a>
          </div>
          <ReadingMode />
        </div>
        <div class="hero-pic">
          <IsoStage board={MINI_BOARD} scene={miniPipeline} label={MINI_LABEL} />
        </div>
      </header>

      <section class="band" aria-labelledby="same">
        <p class="kicker">The whole idea in one question</p>
        <h2 id="same">Same model. Same question. Different answers.</h2>
        <p class="ask"><span class="who">An employee asks</span> “{QUESTION}”</p>
        <div class="versus">
          <article class="reply bad">
            <header><h3>Without RAG</h3><span class="stamp">Made up</span></header>
            <div class="vpic"><IsoStage board={[10, 10, 50, 50]} scene={ALONE} label="The model alone, with nothing to read: its screen shows question marks" /></div>
            <p class="said">“{WITHOUT.text}”</p>
            <p class="why more">{WITHOUT.why}</p>
          </article>
          <article class="reply good">
            <header><h3>With RAG</h3><span class="stamp">Correct</span></header>
            <div class="vpic"><IsoStage board={[8, 10, 122, 50]} scene={WIRED} label="The documents wired to the model: its screen shows OK" /></div>
            <p class="said">“{WITH.text}”</p>
            <blockquote><span>From refund-policy-2025</span>{WITH.citation}</blockquote>
          </article>
        </div>
        <p class="note more">These are the course’s own recorded answers. The only thing that changed is what reached the model.</p>
      </section>

      <section aria-labelledby="how">
        <p class="kicker">How it works</p>
        <h2 id="how">Three steps hidden in the name</h2>
        <ol class="steps">
          {STEPS.map(([name, short, text, type, scene], i) => (
            <li>
              <div class="pic"><IsoStage board={[0, 0, 60, 60]} scene={scene} label={`${BLOCKS[type].name} block`} /></div>
              <h3><span class="n">{i + 1}</span> {name}</h3>
              <p class="cap">{short}</p>
              <p class="more">{text}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="company" aria-labelledby="story">
        <div>
          <p class="kicker">The story</p>
          <h2 id="story">You’ve just joined Larkspur Supply Co.</h2>
          <p class="more">Larkspur is a made-up company that sells office and warehouse hardware, from scanners to steel shelving. Its staff lose hours hunting through policies, contracts, price lists and meeting notes, so the company wants an AI assistant that answers from those documents. <strong>You’re on the team building it.</strong></p>
          <dl class="facts">
            {FACTS.map(([n, what]) => <div><dt>{n}</dt><dd>{what}</dd></div>)}
          </dl>
        </div>
        <div class="inbox">
          <h3>Questions waiting for the assistant</h3>
          <ul>
            {HARD.map(([text, hard, ch]) => (
              <li><p class="qtext">“{text}”</p><p class="hard">{hard} <span>· chapter {ch}</span></p></li>
            ))}
          </ul>
        </div>
      </section>

      <section id="path" aria-labelledby="path-h">
        <p class="kicker">Your path</p>
        <h2 id="path-h">Seven chapters, one assistant</h2>
        {/* a warm-up shows here only when one is due (R13); the home page's Continue links to #warmup */}
        <div id="warmup"><Recap module="rag" bank={MODULE.recall ?? []} warmup client:load /></div>
        <ChapterCards module="rag" chapters={MODULE.chapters}>
          {CHAPTERS.filter(c => c.unlocks.length).map(c => (
            <p class="adds" slot={c.id}>{c.unlocks.map(t => <span class="block-chip"><i style={`background:${BLOCKS[t].pal.l}`}></i>{BLOCKS[t].name}</span>)}</p>
          ))}
        </ChapterCards>
        <p class="recap-link"><a href="/rag/recap/">Recap: questions from the chapters you’ve finished →</a></p>
      </section>

      <section class="pair">
        <article>
          <h2>Who it’s for</h2>
          <ul class="who-chips"><li>Product managers</li><li>Engineers</li><li>Analysts</li><li>No background needed</li></ul>
          <p class="more">Product managers, engineers, analysts, and anyone whose company is rolling out AI assistants who wants to know how they really work, where they fail, and what the fixes cost. No background needed.</p>
        </article>
      </section>

      <section class="end">
        <h2>Ready when you are.</h2>
        <a class="btn primary" href={chapterHref(CHAPTERS[0].id)} data-cta>Start chapter 1 →</a>
      </section>

      <footer class="credits">
        <p>Part of <a href="/">Tinker</a>, visual explanations of tech concepts by <a href="https://kondasamy.com" target="_blank" rel="noopener">Samy (Kondasamy Jayaraman)</a>.</p>
      </footer>
    </main>

    <script>
      // finished chapters get a tick; the buttons continue from the first unfinished chapter
      import { moduleOf, chapterHref } from '../../lib/modules';
      import { completed } from '../../lib/progress';
      const CHAPTERS = moduleOf('rag').chapters;
      const done = completed('rag');
      for (const li of document.querySelectorAll<HTMLElement>('.path [data-chapter]')) {
        if (!done.includes(li.dataset.chapter!)) continue;
        li.classList.add('done');
        li.querySelector<HTMLElement>('.done-mark')!.hidden = false;
      }
      const next = CHAPTERS.findIndex(c => !done.includes(c.id));
      if (done.length && next > 0) for (const a of document.querySelectorAll<HTMLAnchorElement>('[data-cta]')) {
        a.href = chapterHref('rag', CHAPTERS[next].id);
        a.textContent = `Continue: chapter ${next + 1} →`;
      }
    </script>
  </body>
</html>

<style>
  .rag { max-width: 1100px; margin: 0 auto; padding: 24px 24px 64px; display: flex; flex-direction: column; gap: 72px; font-size: 15px; line-height: 1.6; }
  .rag h1 { margin: 6px 0 14px; font-size: 36px; line-height: 1.15; letter-spacing: -.01em; }
  .rag h2 { margin: 4px 0 18px; font-size: 24px; line-height: 1.25; }
  .rag h3 { margin: 0; font-size: 16px; }
  .rag p { margin: 0 0 10px; }

  .hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 40px; align-items: center; }
  .lede { font-size: 17px; }
  .rag .module-meta { margin: 8px 0 10px;font-size: 13.5px; color: var(--muted); }
  .module-meta .level { margin-right: 4px; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }

  .band { background: var(--card); border: 1.5px solid var(--ink); border-radius: 20px; padding: 28px 32px; box-shadow: 5px 5px 0 var(--ink); }
  .ask { font-size: 18px; font-weight: 800; margin-bottom: 18px; }
  .ask .who { display: block; font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); font-weight: 700; }
  .versus { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .reply { border-radius: 14px; padding: 16px 18px; border: 1.5px solid var(--ink); background: var(--paper); }
  .reply header { display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-bottom: 8px; }
  .reply.bad { border-left: 6px solid var(--bad); }
  .reply.good { border-left: 6px solid var(--ok); }
  .said { font-size: 15.5px; font-style: italic; }
  .why { font-size: 13.5px; color: var(--muted); }
  .stamp { font-weight: 900; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; border: 2px solid currentColor; border-radius: 6px; padding: 1px 8px; transform: rotate(-3deg); }
  .bad .stamp { color: var(--bad); } .good .stamp { color: var(--ok); }
  blockquote { margin: 6px 0 0; padding: 8px 12px; background: var(--card); border-radius: 8px; font-size: 13.5px; border: 1px dashed var(--rule); }
  blockquote span { display: block; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); font-weight: 700; }
  .note { margin: 16px 0 0; font-size: 13px; color: var(--muted); }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .steps li { position: relative; padding: 18px; border: 1.5px solid var(--rule); border-radius: 16px; display: flex; flex-direction: column; gap: 8px; }
  .steps li:not(:last-child)::after { content: '→'; position: absolute; right: -17px; top: 70px; font-size: 20px; font-weight: 800; z-index: 1; }
  .steps .pic { width: 150px; margin: 0 auto 4px; }
  .steps h3 { display: flex; align-items: center; gap: 10px; font-size: 18px; }
  .steps p { font-size: 14px; margin: 0; }
  .vpic { height: 130px; display: flex; justify-content: center; margin: 2px 0 10px; }
  .vpic :global(svg) { width: auto !important; height: 100% !important; }

  .company { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 40px; align-items: start; }
  .facts { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin: 18px 0 0; }
  .facts div { border: 1.5px solid var(--ink); border-radius: 12px; padding: 10px 14px; background: var(--card); }
  .facts dt { font-size: 26px; font-weight: 900; line-height: 1.1; }
  .facts dd { margin: 0; font-size: 13px; color: var(--muted); }
  .inbox { background: var(--card); border: 1.5px solid var(--ink); border-radius: 16px; padding: 18px 20px; box-shadow: 4px 4px 0 var(--ink); }
  .inbox h3 { font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); margin-bottom: 8px; }
  .inbox ul { list-style: none; margin: 0; padding: 0; }
  .inbox li { padding: 10px 0; border-top: 1px dashed var(--rule); }
  .inbox li:first-child { border-top: 0; }
  .qtext { margin: 0; font-weight: 700; }
  .hard { margin: 2px 0 0 !important; font-size: 13px; color: var(--bad); }
  .hard span { color: var(--muted); }

  .done-mark { color: var(--ok); font-size: 13px; }
  .recap-link { margin: 16px 0 0; font-weight: 800; }
  #warmup { scroll-margin-top: 16px; }
  .adds { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .adds .lbl { font-size: 11px; letter-spacing: .1em; text-transform: uppercase; font-weight: 700; margin-right: 2px; }
  .block-chip { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 700; color: var(--ink); border: 1.5px solid var(--ink); border-radius: 999px; padding: 1px 9px 1px 4px; background: var(--card); }
  .block-chip i { width: 12px; height: 12px; border-radius: 3px; border: 1.5px solid var(--ink); }

  .pair { display: grid; gap: 24px; }
  .pair article { border: 1.5px solid var(--rule); border-radius: 16px; padding: 20px 22px; }
  .pair h2 { font-size: 18px; margin-bottom: 10px; }

  .end { text-align: center; padding: 8px 0; }
  .end h2 { margin-bottom: 14px; }

  @media (max-width: 860px) {
    .rag { padding: 16px 16px 48px; gap: 48px; }
    .rag h1 { font-size: 27px; }
    .hero, .versus, .company, .pair { grid-template-columns: 1fr; }
    .band { padding: 20px 18px; }
    .steps { grid-template-columns: 1fr; }
    .steps li:not(:last-child)::after { content: '↓'; right: auto; left: 50%; top: auto; bottom: -24px; }
  }
</style>

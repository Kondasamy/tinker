---
import ChapterLayout from '../../layouts/ChapterLayout.astro';
import PlaceholderChapter from '../../components/story/PlaceholderChapter';
import { CHAPTERS } from '../../lib/chapters';

export function getStaticPaths() {
  return CHAPTERS.map(({ id, title }) => ({ params: { chapter: id }, props: { title } }));
}

const { chapter } = Astro.params;
const { title } = Astro.props;
---
<ChapterLayout chapter={chapter} title={title}>
  <PlaceholderChapter client:load chapter={chapter} />
</ChapterLayout>

---
// Voice agents module intro: sets the scene before chapter 1. Static, except the warm-up and a small script that marks
// finished chapters. Every example is the module's own data: Ravi's call run through the live turn detector at build
// time, its recorded transcripts and replies, Larkspur's illustrative stage times, and claims from data/voice/facts.json.
import '../../styles/tokens.css';
import '../../styles/page.css';
import Meta from '../../components/Meta.astro';
import IsoStage from '../../lib/iso/IsoStage';
import Recap from '../../components/quiz/Recap';
import ReadingMode from '../../components/intro/ReadingMode.astro';
import ChapterCards from '../../components/intro/ChapterCards.astro';
import { PHONE_BOARD, phoneLabel, phoneScene, type PhoneOpts } from '../../components/scenes/phoneScene';
import { CALLS, DEFAULT_LINE, runCall } from '../../lib/voice/engine';
import { SILENCES } from '../../lib/voice/turns';
import { ms } from '../../lib/voice/latency';
import { textOf } from '../../lib/voice/script';
import { WINNERS, totals } from '../../lib/voice/workbench';
import { ACCESSED, fact } from '../../lib/voice/facts';
import { moduleOf, chapterHref } from '../../lib/modules';
import { introMeta } from '../../lib/pages';
import { longDate } from '../../lib/format';

const MODULE = moduleOf('voice');
const CHAPTERS = MODULE.chapters;
const PREREQS = MODULE.prereqs.map(id => moduleOf(id));
const LINE = { ...DEFAULT_LINE, streaming: true, bargeIn: true, readBack: true };
const pic = (o: PhoneOpts): PhoneOpts => ({ ...o, scale: 1.25 });
// Ravi's call at the shortest silence setting and at the one that hears him whole (the live detector, recorded replies)
const SHORT = runCall('hesitant', { ...LINE, silence: SILENCES[0] }),
  WHOLE = runCall('hesitant', { ...LINE, silence: 800 });
const HERO = pic({ stage: 'reply', wait: WHOLE.wait });
const SIDES = [
  { title: `Silence ${ms(SILENCES[0])}`, r: SHORT },
  { title: `Silence ${ms(800)}`, r: WHOLE },
];
const MISHEAR = runCall('mishear', { ...LINE, readBack: false });
const IDEAS: [string, string, ReturnType<typeof fact>, PhoneOpts][] = [
  [
    'Three stages',
    'Speech-to-text, the model, text-to-speech, each handing on its work',
    fact('openai-chained'),
    pic({ stage: 'stt' }),
  ],
  [
    'The latency budget',
    'The stages’ times add up; streaming brings the first word forward',
    fact('stivers'),
    pic({ stage: 'reply', wait: WHOLE.wait }),
  ],
  [
    'Whose turn is it',
    'A silence setting ends the turn: too short cuts callers off, too long leaves dead air',
    fact('openai-vad-settings'),
    pic({ stage: 'reply', interrupt: true }),
  ],
  [
    'Being interrupted',
    'Stop speaking, listen, and keep only what was said',
    fact('gemini-interrupt'),
    pic({ stage: 'reply', interrupt: true, stopped: true }),
  ],
  [
    'Mishearing',
    'Read an unsure number back before acting on it',
    fact('gemini-transcripts'),
    pic({ stage: 'stt', unsure: true }),
  ],
  [
    'One model or three',
    'Speech to speech, or a chained line with a transcript to check',
    fact('openai-s2s'),
    pic({ stage: 'reply', mode: 's2s' }),
  ],
];
const BEST = totals(WINNERS[0]);
const FACTS: [string, string][] = [
  [ms(WHOLE.wait!), 'from Ravi’s last word to the first sound, on the tuned line'],
  [ms(SILENCES[0]), 'of quiet that ended Ravi’s turn at his first pause'],
  [String(CALLS.length), 'calls on the workbench, each run over its own audio'],
  [`${fact('stivers').value} ms`, 'the mean gap before a reply in conversation, over 10 languages'],
];
const checked = longDate(ACCESSED);
---
<html lang="en">
  <head>
    <Meta {...introMeta(MODULE.id)} />
  </head>
  <body>
    <div class="topbar">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/"><img src="/favicon.svg" alt="" width="20" height="20" /> Tinker</a> <span aria-hidden="true">/</span> <span aria-current="page">{MODULE.title}</span></nav>
      <p class="by">by <a href={MODULE.author.url} target="_blank" rel="noopener">{MODULE.author.name}</a></p>
    </div>
    <main class="intro">
      <header class="hero">
        <div class="hero-text">
          <p class="kicker">Module 17 · Voice</p>
          <p class="module-meta"><span class="level">{MODULE.level}</span> {PREREQS.map((m, i) => <>{i > 0 && ', '}{m.status === 'live' ? <a href={`/${m.id}/`}>{m.title}</a> : <span>{m.title}</span>}</>)} recommended · by <a href={MODULE.author.url} target="_blank" rel="noopener">{MODULE.author.name}</a></p>
          <h1>How does an assistant hold a phone call?</h1>
          <p class="lede">Put Larkspur’s assistant on the phone. Here you follow a call through its three stages, time the wait, decide when a caller has finished, let them interrupt, catch a misheard order number, and tune the line over five calls. Every clip has a play button and its words: the sound is optional.</p>
          <div class="ctas">
            <a class="btn primary" href={chapterHref(MODULE.id, CHAPTERS[0].id)} data-cta>Start chapter 1 →</a>
            <a class="btn" href="#path">See the chapters</a>
          </div>
          <ReadingMode />
        </div>
        <div class="hero-pic">
          {/* the phone desk every chapter plays on: Ravi's reply on its way back, the stopwatch showing his wait */}
          <IsoStage board={PHONE_BOARD} scene={phoneScene(HERO)} label={phoneLabel(HERO)} />
        </div>
      </header>

      <section class="band" aria-labelledby="idea">
        <p class="kicker">The whole idea in one example</p>
        <h2 id="idea">The same caller, two silence settings</h2>
        <div class="versus">
          {SIDES.map(({ title, r }) => (
            <article class:list={['reply', { read: !r.detected.cut }]}>
              <header><h3>{title} <span class="tag">recorded transcript</span></h3><span class="stamp">{r.detected.cut ? 'cut off' : 'heard whole'}</span></header>
              <p class="asked">The line heard: “{r.recording.turns[0].text}”</p>
              <p class="said">{textOf(r.recording.turns[1].clip)}</p>
              <p class="cap">{r.recording.note}</p>
            </article>
          ))}
        </div>
        <p class="note more">Ravi said: “{textOf('hesitant-caller')}” The turn detector ran over his clip’s audio when this page was built; the transcripts and replies were written for this site and the voices generated once, ahead of time. The waits use Larkspur’s illustrative stage times, not any provider’s.</p>
      </section>

      <section aria-labelledby="how">
        <p class="kicker">How it works</p>
        <h2 id="how">Six ideas carry the module</h2>
        <ol class="steps">
          {IDEAS.map(([name, short, f, o], i) => (
            <li>
              <div class="pic"><IsoStage board={PHONE_BOARD} scene={phoneScene(o)} label={phoneLabel(o)} /></div>
              <h3><span class="n">{i + 1}</span> {name}</h3>
              <p class="cap">{short}</p>
              <p class="more">{f.claim}</p>
              <p class="src more"><a href={f.source}>Source</a>, checked {checked}</p>
            </li>
          ))}
        </ol>
        <p class="note more">On the workbench’s best line the five calls wait {ms(BEST.wait)} in all, with no caller cut off. A misheard number on a line without read-back: “{MISHEAR.recording.turns[0].text}”.</p>
      </section>

      <section class="company" aria-labelledby="story">
        <div>
          <p class="kicker">The story</p>
          <h2 id="story">Larkspur’s assistant answers the phone</h2>
          <p class="more">{MODULE.story} <strong>You’re on the team that makes the line feel like a conversation.</strong></p>
          <p class="prev"><a href="/tool-calling/">Tool calling</a> built the order lookup the assistant uses on every call.</p>
        </div>
        <dl class="facts">
          {FACTS.map(([n, what]) => <div><dt>{n}</dt><dd>{what}</dd></div>)}
        </dl>
      </section>

      <section id="path" aria-labelledby="path-h">
        <p class="kicker">Your path</p>
        <h2 id="path-h">The chapters</h2>
        {/* a warm-up shows here only when one is due (R13); the home page's Continue links to #warmup */}
        <div id="warmup"><Recap module={MODULE.id} bank={MODULE.recall ?? []} warmup client:load /></div>
        <ChapterCards module={MODULE.id} chapters={CHAPTERS} />
        <p class="recap-link"><a href={`/${MODULE.id}/recap/`}>Recap: questions from the chapters you’ve finished →</a></p>
      </section>

      <section class="pair">
        <article>
          <h2>Who it’s for</h2>
          <ul class="who-chips"><li>Engineers</li><li>Product managers</li><li>Analysts</li><li>No code needed</li></ul>
          <p class="more">Product managers, engineers and analysts putting an assistant on a phone line or behind a microphone. <a href="/tool-calling/">Tool calling</a> comes first; no code or maths needed, and no microphone: nothing you do here records you.</p>
        </article>
      </section>

      <footer class="credits">
        <p>Part of <a href="/">Tinker</a>, visual explanations of tech concepts by <a href="https://kondasamy.com" target="_blank" rel="noopener">Kondasamy Jayaraman</a>.</p>
        <p>The illustrations are drawn with <a href="https://april-zhu.com/colorfigures">Colorfigures</a> by <a href="https://april-zhu.com/">April Zhu</a>, whose hand-inked isometric style and engine this course is built on. Colorfigures grew from April’s <a href="https://isoglow.dev">ISO-GLOW</a>, which builds on <a href="https://github.com/MrBongoC/ai-iso-skill">iso-figure</a> by Tolga Cohce. All MIT licensed. Thank you.</p>
      </footer>
    </main>

    <script>
      // finished chapters get a tick; the button continues from the first unfinished chapter
      import { moduleOf, chapterHref } from '../../lib/modules';
      import { completed } from '../../lib/progress';
      const CHAPTERS = moduleOf('voice').chapters;
      const done = completed('voice');
      for (const li of document.querySelectorAll<HTMLElement>('.path [data-chapter]')) {
        if (!done.includes(li.dataset.chapter!)) continue;
        li.classList.add('done');
        li.querySelector<HTMLElement>('.done-mark')!.hidden = false;
      }
      const next = CHAPTERS.findIndex(c => !done.includes(c.id));
      if (done.length && next > 0) for (const a of document.querySelectorAll<HTMLAnchorElement>('[data-cta]')) {
        a.href = chapterHref('voice', CHAPTERS[next].id);
        a.textContent = `Continue: chapter ${next + 1} →`;
      }
    </script>
  </body>
</html>

<style>
  .intro { max-width: 1100px; margin: 0 auto; padding: 24px 24px 64px; display: flex; flex-direction: column; gap: 72px; font-size: 15px; line-height: 1.6; }
  .intro h1 { margin: 6px 0 14px; font-size: 36px; line-height: 1.15; letter-spacing: -.01em; }
  .intro h2 { margin: 4px 0 18px; font-size: 24px; line-height: 1.25; }
  .intro h3 { margin: 0; font-size: 16px; }
  .intro p { margin: 0 0 10px; }

  .hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 40px; align-items: center; }
  .lede { font-size: 17px; }
  .intro .module-meta { margin: 8px 0 10px; font-size: 13.5px; color: var(--muted); }
  .module-meta .level { margin-right: 4px; }
  .module-meta a { color: var(--ink); }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }

  .band { background: var(--card); border: 1.5px solid var(--ink); border-radius: 20px; padding: 28px 32px; box-shadow: 5px 5px 0 var(--ink); }
  .versus { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 18px; align-items: start; }
  .reply { min-width: 0; border-radius: 14px; padding: 16px 18px; border: 1.5px solid var(--ink); background: var(--paper); }
  .reply header { display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-bottom: 8px; }
  .reply.read { border-left: 6px solid var(--acc); }
  .said { font-size: 17px; font-weight: 700; overflow-wrap: anywhere; }
  .bar { list-style: none; margin: 0 0 8px; padding: 0; display: flex; flex-direction: column; gap: 6px; }
  .bar li { display: grid; grid-template-columns: 10em minmax(0, 1fr) 3em; align-items: center; gap: 8px; font-size: 14px; }
  .bar .tok { font-family: ui-monospace, Menlo, monospace; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .bar .fill { display: block; height: 12px; box-sizing: border-box; border: 1.5px solid var(--ink); border-radius: 4px; background: var(--card); }
  .bar .p { text-align: right; font-variant-numeric: tabular-nums; color: var(--muted); }

  .stamp { font-weight: 900; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; border: 2px solid currentColor; border-radius: 6px; padding: 1px 8px; transform: rotate(-3deg); white-space: nowrap; }
  .tag { margin-left: 6px; padding: 0 6px; border: 1px solid var(--rule); border-radius: 999px; font: 700 11px ui-monospace, Menlo, monospace; color: var(--muted); white-space: nowrap; }
  .asked { font-size: 14px; color: var(--muted); }
  .note { margin: 16px 0 0; font-size: 13px; color: var(--muted); }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .steps li { padding: 18px; border: 1.5px solid var(--rule); border-radius: 16px; display: flex; flex-direction: column; gap: 8px; }
  .steps h3 { display: flex; align-items: center; gap: 10px; font-size: 17px; }
  .steps p { font-size: 14px; margin: 0; }
  .steps .pic { height: 220px; display: flex; justify-content: center; margin-bottom: 4px; }
  .steps .pic :global(svg) { width: auto !important; height: 100% !important; }
  .steps .src { margin-top: auto; font-size: 12.5px; color: var(--muted); }

  .company { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 40px; align-items: start; }
  .prev { font-size: 14px; color: var(--muted); }
  .prev a { color: var(--ink); }
  .facts { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin: 0; }
  .facts div { border: 1.5px solid var(--ink); border-radius: 12px; padding: 10px 14px; background: var(--card); }
  .facts dt { font-size: 26px; font-weight: 900; line-height: 1.1; }
  .facts dd { margin: 0; font-size: 13px; color: var(--muted); }

  .recap-link { margin: 16px 0 0; font-weight: 800; }
  #warmup { scroll-margin-top: 16px; }

  .pair { display: grid; gap: 24px; }
  .pair article { border: 1.5px solid var(--rule); border-radius: 16px; padding: 20px 22px; }
  .pair h2 { font-size: 18px; margin-bottom: 10px; }

  @media (max-width: 860px) {
    .intro { padding: 16px 16px 48px; gap: 48px; }
    .intro h1 { font-size: 27px; }
    .hero, .versus, .company, .pair { grid-template-columns: 1fr; }
    .band { padding: 20px 18px; }
    .steps { grid-template-columns: 1fr; }
  }
</style>

---
import ChapterLayout from '../../layouts/ChapterLayout.astro';
import DataOrInstructions from '../../content/guardrails/01-data-or-instructions';
import { moduleOf } from '../../lib/modules';

export function getStaticPaths() {
  return moduleOf('guardrails').chapters.map(({ id, title }) => ({ params: { chapter: id }, props: { title } }));
}

const { chapter } = Astro.params;
const { title } = Astro.props;
---
<ChapterLayout module="guardrails" chapter={chapter} title={title}>
  {/* One line per chapter, as `chapter === '02-…' ? <Next client:load />`, last one without a test. Not a lookup table:
      hydration needs each island as a static component in the template, so Astro can bundle it (KTD2). */}
  <DataOrInstructions client:load />
</ChapterLayout>

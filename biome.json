{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!!**/dist",
      "!data",
      "!public",
      "!tests/fixtures",
      "!videos",
      "!video",
      "!src/lib/iso/core.js",
      "!**/*.md",
      "!**/*.yml",
      "!**/*.yaml"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "single", "arrowParentheses": "asNeeded" } },
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": { "noNonNullAssertion": "off", "useTemplate": "off", "noDescendingSpecificity": "off" },
      "complexity": { "noImportantStyles": "off", "noUselessFragments": "off", "useLiteralKeys": "off" },
      "suspicious": {
        "noAssignInExpressions": "off",
        "useIterableCallbackReturn": "off",
        "noArrayIndexKey": "off",
        "noExplicitAny": "off",
        "noFocusedTests": "off",
        "noDuplicateTestHooks": "off"
      },
      "correctness": {
        "useExhaustiveDependencies": "off",
        "noComponentHookFactories": "off",
        "usePlaywrightValidDescribeCallback": "off"
      },
      "performance": { "useDomNodeTextContent": "off" },
      "a11y": {
        "useSemanticElements": "off",
        "noAriaHiddenOnFocusable": "off",
        "noNoninteractiveTabindex": "off",
        "noInteractiveElementToNoninteractiveRole": "off",
        "useKeyWithClickEvents": "off",
        "noStaticElementInteractions": "off",
        "noLabelWithoutControl": { "level": "error", "options": { "inputComponents": ["Select"] } }
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": { "noUnusedImports": "off", "noUnusedVariables": "off" },
          "style": { "useImportType": "off" }
        }
      }
    }
  ]
}
